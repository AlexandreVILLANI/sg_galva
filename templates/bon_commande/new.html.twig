{% extends 'base.html.twig' %}

{% block title %}Bon de commande - {{ fiche.client.nom }}{% endblock %}

{% block body %}
{# --- DEPENDANCES RECHERCHE CLIENT --- #}
<link href="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/css/tom-select.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/js/tom-select.complete.min.js"></script>

<div class="bc-wrapper">
    {{ form_start(form, {'attr': {'class': 'bc-paper', 'enctype': 'multipart/form-data'}}) }}
    
        {# --- ENTÊTE --- #}
        <div class="bc-header">
            <div class="bc-logo-container">
                <img src="{{ asset('images/sg-galva-logo.png') }}" alt="Logo" class="bc-logo">
            </div>
            <div class="bc-title-container">
                <h1>BON DE COMMANDE</h1>
            </div>
            <div class="bc-refi-container">
                <label>REFI -</label>
                {{ form_widget(form.refi, {'attr': {'class': 'refi-input-ghost', 'readonly': 'readonly'}}) }}
            </div>
        </div>

        {# --- GRILLE HAUTE : TRAITEMENT & FORFAIT --- #}
        <div class="bc-top-grid">
            <div class="bc-box treatment-box">
                <p class="box-label">TRAITEMENT :</p>
                <div class="checkbox-group">
                    <label>{{ form_widget(form.isGalvanisation) }} (Galvanisation)</label>
                    <label>{{ form_widget(form.isCataphorese) }} (Cataphorèse)</label>
                </div>
            </div>
            <div class="bc-box summary-box">
                <div class="summary-line">
                    <span>Forfait :</span> 
                    <strong>{{ form_widget(form.forfait) }}</strong> 
                </div>
                <div class="summary-line">
                    <span>Nb PAQ :</span> 
                    <strong>{{ fiche.totalPaquets }}</strong> 
                </div>
                <div class="summary-line">
                    <span>Stockage :</span> 
                    <strong>{{ form_widget(form.stockage) }}</strong>
                </div>
                <div class="summary-line">
                    <span>GALVA :</span> 
                    <strong>{{ form_widget(form.typeGalva) }}</strong>
                </div>            
            </div>
        </div>

        {# --- GRILLE MILIEU : CLIENT & CHAUFFEUR --- #}
        <div class="bc-middle-grid">
            <div class="bc-box client-box">
                <div class="field">
                    <span class="label">SOCIETE :</span> 
                    <span class="val" id="client-display-area">
                        <strong id="client-name-text">{{ fiche.client.nom }}</strong>
                        
                        {# Bouton d'édition si client à définir #}
                        {% if fiche.client.nom|lower in ['à définir', 'a definir'] %}
                            <button type="button" class="btn-edit-client-bc no-print" onclick="toggleClientEdit()">
                                <i class="fas fa-user-edit"></i> Attribuer un client
                            </button>
                        {% endif %}
                    </span>

                    {# Zone de sélection (cachée par défaut) #}
                    <div id="client-edit-area" style="display: none; margin-top: 10px;" class="no-print">
                        <select id="new-client-select" placeholder="Rechercher un client..." autocomplete="off">
                            <option value="">-- Choisir le bon client --</option>
                            {% for c in clients %}
                                <option value="{{ c.id }}">{{ c.nom }}</option>
                            {% endfor %}
                        </select>
                        <div style="display: flex; gap: 10px; margin-top: 10px;">
                            <button type="button" class="btn-save-client-bc" onclick="saveNewClient({{ fiche.id }})">
                                <i class="fas fa-check"></i> Valider
                            </button>
                            <button type="button" class="btn-cancel-client-bc" onclick="toggleClientEdit()">
                                Annuler
                            </button>
                        </div>
                    </div>
                </div>
                
                <div class="field">
                    <span class="label">Adresse :</span> 
                    <span class="val">{{ fiche.client.adresseFacturation|default(fiche.client.adresseLivraison)|default('---') }}</span>
                </div>
                <div class="field">
                    <span class="label">Date :</span> 
                    <span class="val">{{ "now"|date('d/m/Y') }}</span> 
                </div>
            </div>

            <div class="bc-box driver-box">
                <div class="field">
                    <span class="label">Nom du chauffeur :</span> 
                    {{ form_widget(form.nomChauffeur, {'attr': {'class': 'ghost-input', 'placeholder': '(Saisir nom)'}}) }}
                </div>
                <div class="field">
                    <span class="label">Tél :</span> 
                    <span class="val">{{ fiche.client.telephone|default('(Non renseigné)') }}</span>
                </div>
                <div class="field">
                    <span class="label">Fax :</span> 
                    <span class="val">{{ fiche.client.fax|default('(Non renseigné)') }}</span>
                </div>
            </div>
        </div>

        {# --- ZONE DESCRIPTION --- #}
        <div class="bc-box description-box">
            <div class="desc-main">
                <p><strong>DÉTAILS DU DÉCHARGEMENT</strong></p>
                <ul class="bc-tech-list">
                    {% for ligne in fiche.lignes %}
                        <li>
                            <strong>{{ ligne.nbPaquets }}</strong> Paquet{{ ligne.nbPaquets > 1 ? 's' : '' }} 
                            de <strong>{{ ligne.description|default('(Produit non précisé)') }}</strong>
                            — Situé en : <strong>{{ ligne.emplacement.nom }}</strong>
                        </li>
                    {% endfor %}
                </ul>
                <div class="mt-4">
                    <p>TOTAL : {{ fiche.totalPaquets }}</p>
                </div>
            </div>
        </div>

        {# --- EMPLACEMENT --- #}
        <div class="bc-box emplacement-box">
            <span class="label">Emplacement :</span>
            <strong>
                {% for ligne in fiche.lignes %}
                    {{ ligne.emplacement.nom }}{% if not loop.last %} // {% endif %}
                {% endfor %}
            </strong>
        </div>

        {# --- COMMENTAIRES --- #}
        <div class="bc-box comment-box">
            <span class="label">Commentaires / Observations :</span>
            <div class="mt-2">
                {{ form_widget(form.commentaire) }}
            </div>
        </div>

        {# --- SECTION PHOTOS --- #}
        <div class="photo-section mt-4">
            <div class="bc-box mb-4">
                <label class="label">Archive Déchargement (Photos Fiche #{{ fiche.id }})</label>
                <div class="photo-grid">
                    {% for photo in fiche.photos %}
                        <div class="photo-item">
                            <img src="{{ asset('uploads/fiches/' ~ photo.nomFichier) }}" alt="Photo déchargement" onclick="window.open(this.src)">
                        </div>
                    {% else %}
                        <p class="no-data">Aucune photo jointe au déchargement.</p>
                    {% endfor %}
                </div>
            </div>

            <hr class="no-print">

            <div class="bc-box photos-container">
                <label class="label">Photos complémentaires (Ce Bon)</label>
                <div class="form-group mt-2">
                    
                    {# 1. ON CACHE LE CHAMP ICI ET ON FORCE L'ATTRIBUT MULTIPLE #}
                    <div style="display: none;">
                        {{ form_widget(form.imageFiles, {'attr': {'multiple': 'multiple', 'accept': 'image/*'}}) }}
                    </div>

                    {# 2. LA ZONE DE CLIC EST SÉPARÉE #}
                    <div class="upload-zone" id="drop-zone" onclick="document.getElementById('{{ form.imageFiles.vars.id }}').click()">
                        <i class="fas fa-paperclip"></i>
                        <p>Glisser-déposer plusieurs photos ou <span class="browse">Parcourir</span></p>
                    </div>
                    
                    <div id="file-preview" class="photo-grid mt-3"></div>
                </div>
            </div>
        </div>

        {# --- ACTIONS --- #}
        <div class="bc-actions no-print">
            <a href="{{ path('app_reception_terrain_home') }}" class="btn-cancel">
                <i class="fas fa-arrow-left"></i> Annuler
            </a>
            <button type="submit" class="btn-confirm">
                <i class="fas fa-save"></i> SAUVEGARDER LE BON
            </button>
        </div>
        {{ form_rest(form) }}
    {{ form_end(form) }}
</div>

<script>
    // --- LOGIQUE ATTRIBUTION CLIENT ---
    let clientSelectSearch = null;

    function toggleClientEdit() {
        const displayArea = document.getElementById('client-display-area');
        const editArea = document.getElementById('client-edit-area');
        
        if (editArea.style.display === 'none') {
            displayArea.style.display = 'none';
            editArea.style.display = 'block';
            
            if (!clientSelectSearch) {
                clientSelectSearch = new TomSelect("#new-client-select", {
                    create: false,
                    sortField: { field: "text", direction: "asc" }
                });
            }
        } else {
            editArea.style.display = 'none';
            displayArea.style.display = 'block';
        }
    }

    async function saveNewClient(ficheId) {
        const clientId = document.getElementById('new-client-select').value;
        if (!clientId) return alert("Veuillez sélectionner un client dans la liste.");

        const btn = document.querySelector('.btn-save-client-bc');
        const originalText = btn.innerHTML;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>...';
        btn.disabled = true;

        try {
            const response = await fetch(`/reception/dechargement/${ficheId}/update-client`, {
                method: 'POST',
                headers: { 
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest' 
                },
                body: JSON.stringify({ client_id: clientId })
            });

            const data = await response.json();

            if (data.success) {
                // LE RECHARGEMENT REMPLIRA AUTOMATIQUEMENT ADRESSE / TEL / FAX
                window.location.reload(); 
            } else {
                alert("Erreur : " + data.message);
                btn.innerHTML = originalText;
                btn.disabled = false;
            }
        } catch (e) {
            alert("Une erreur technique est survenue.");
            btn.innerHTML = originalText;
            btn.disabled = false;
        }
    }

    // --- LOGIQUE PHOTOS ---
    const dropZone = document.getElementById('drop-zone');
    const fileInput = document.getElementById('{{ form.imageFiles.vars.id }}');
    const preview = document.getElementById('file-preview');
    let dataTransfer = new DataTransfer();

    fileInput.addEventListener('change', (e) => handleFiles(e.target.files));
    dropZone.addEventListener('dragover', (e) => { e.preventDefault(); dropZone.classList.add('dragover'); });
    dropZone.addEventListener('dragleave', () => dropZone.classList.remove('dragover'));
    dropZone.addEventListener('drop', (e) => {
        e.preventDefault();
        dropZone.classList.remove('dragover');
        handleFiles(e.dataTransfer.files);
    });

    function handleFiles(files) {
        Array.from(files).forEach(file => {
            dataTransfer.items.add(file);
            const reader = new FileReader();
            reader.onload = function(event) {
                const container = document.createElement('div');
                container.className = 'photo-item';
                container.innerHTML = `
                    <img src="${event.target.result}">
                    <button type="button" class="btn-remove-photo" data-name="${file.name}">
                        <i class="fas fa-times"></i>
                    </button>
                `;
                preview.appendChild(container);
            };
            reader.readAsDataURL(file);
        });
        fileInput.files = dataTransfer.files;
    }

    preview.addEventListener('click', (e) => {
        const btn = e.target.closest('.btn-remove-photo');
        if (!btn) return;
        const fileName = btn.getAttribute('data-name');
        const newDataTransfer = new DataTransfer();
        Array.from(dataTransfer.files).forEach(file => {
            if (file.name !== fileName) newDataTransfer.items.add(file);
        });
        dataTransfer = newDataTransfer; 
        fileInput.files = dataTransfer.files;
        btn.parentElement.remove();
    });
</script>

<style>
    /* Styles spécifiques Client BC */
    .btn-edit-client-bc {
        background: #f0f4ff; color: #2e46a6; border: 1px dashed #2e46a6;
        padding: 4px 8px; border-radius: 4px; font-size: 11px; cursor: pointer; margin-left: 10px;
    }
    .btn-save-client-bc { background: #2e46a6; color: white; border: none; padding: 8px 15px; border-radius: 4px; font-weight: bold; cursor: pointer; }
    .btn-cancel-client-bc { background: #eee; color: #666; border: none; padding: 8px 15px; border-radius: 4px; cursor: pointer; }

    /* Mise en page BC */
    .bc-wrapper { background: #f0f0f0; min-height: 100vh; padding: 40px 20px; }
    .bc-paper { max-width: 900px; margin: 0 auto; background: white; padding: 40px; box-shadow: 0 0 20px rgba(0,0,0,0.1); font-family: Arial, sans-serif; color: #1a1a1a; }
    .bc-header { display: grid; grid-template-columns: 1fr 2fr 1.5fr; align-items: center; border-bottom: 2px solid #000; padding-bottom: 10px; margin-bottom: 20px; }
    .bc-logo { max-width: 120px; }
    .bc-title-container h1 { font-size: 22px; font-weight: 800; text-align: center; margin: 0; }
    .bc-refi-container { text-align: right; font-size: 20px; font-weight: bold; }
    .bc-refi-container input { border: none; font-weight: bold; font-size: 20px; width: 140px; text-align: right; background: transparent; }

    .bc-top-grid, .bc-middle-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0; margin-bottom: 20px; }
    .bc-box { border: 1px solid #ddd; padding: 15px; margin-bottom: 20px; }
    
    .checkbox-group { display: flex; flex-direction: column; gap: 10px; margin-top: 10px; }
    .summary-line { display: flex; justify-content: space-between; border-bottom: 1px solid #f0f0f0; padding: 3px 0; font-size: 13px; }
    
    .description-box { min-height: 250px; }
    .bc-tech-list { list-style: none; padding: 0; margin: 10px 0; font-family: monospace; font-size: 13px; }
    .bc-tech-list li { padding: 5px 0; border-bottom: 1px dashed #eee; }

    .label { font-weight: bold; font-size: 12px; text-transform: uppercase; margin-right: 5px; }
    .field { margin-bottom: 15px; }
    .ghost-input { border: none; border-bottom: 1px dashed #ccc; outline: none; width: 180px; font-size: 14px; }

    .upload-zone { border: 2px dashed #2e46a6; background: #f0f4ff; padding: 20px; text-align: center; border-radius: 8px; cursor: pointer; }
    .photo-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px; margin-top: 10px; }
    .photo-item { position: relative; }
    .photo-item img { width: 100%; height: 120px; object-fit: cover; border-radius: 4px; border: 1px solid #ddd; }
    .btn-remove-photo { position: absolute; top: -5px; right: -5px; background: #e06e54; color: white; border: none; border-radius: 50%; width: 20px; height: 20px; cursor: pointer; }

    .comment-box textarea { width: 100%; border: none; border-bottom: 1px dashed #2e46a6; font-size: 14px; outline: none; padding: 10px 0; }

    .bc-actions { display: flex; gap: 20px; margin-top: 30px; }
    .btn-cancel { flex: 1; background: #e06e54; color: white; padding: 15px; text-align: center; border-radius: 5px; text-decoration: none; font-weight: bold; }
    .btn-confirm { flex: 2; background: #2e46a6; color: white; border: none; padding: 15px; border-radius: 5px; font-weight: bold; cursor: pointer; font-size: 16px; }

    @media print { 
        .no-print, .ts-wrapper { display: none !important; } 
        .bc-wrapper { padding: 0; background: white; } 
        .bc-paper { box-shadow: none; border: none; max-width: 100%; } 
    }
</style>
{% endblock %}