    .summary-line { display: flex; justify-content: space-between; border-bottom: 1px solid #f0f0f0; padding: 3px 0; font-size: 13px; }
    
    .description-box { min-height: 250px; }
    .bc-tech-list { list-style: none; padding: 0; margin: 10px 0; font-family: monospace; font-size: 13px; }
    .bc-tech-list li { padding: 5px 0; border-bottom: 1px dashed #eee; }

    .label { font-weight: bold; font-size: 12px; text-transform: uppercase; margin-right: 5px; }
    .field { margin-bottom: 15px; }
    .ghost-input { border: none; border-bottom: 1px dashed #ccc; outline: none; width: 180px; font-size: 14px; }

    .upload-zone { border: 2px dashed #2e46a6; background: #f0f4ff; padding: 20px; text-align: center; border-radius: 8px; cursor: pointer; }
    .photo-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px; margin-top: 10px; }
    .photo-item { position: relative; }
    .photo-item img { width: 100%; height: 120px; object-fit: cover; border-radius: 4px; border: 1px solid #ddd; }
    .btn-remove-photo { position: absolute; top: -5px; right: -5px; background: #e06e54; color: white; border: none; border-radius: 50%; width: 20px; height: 20px; cursor: pointer; }

    .comment-box textarea { width: 100%; border: none; border-bottom: 1px dashed #2e46a6; font-size: 14px; outline: none; padding: 10px 0; }

    .bc-actions { display: flex; gap: 20px; margin-top: 30px; }
    .btn-cancel { flex: 1; background: #e06e54; color: white; padding: 15px; text-align: center; border-radius: 5px; text-decoration: none; font-weight: bold; }
    .btn-confirm { flex: 2; background: #2e46a6; color: white; border: none; padding: 15px; border-radius: 5px; font-weight: bold; cursor: pointer; font-size: 16px; }

    @media print { 
        .no-print, .ts-wrapper { display: none !important; } 
        .bc-wrapper { padding: 0; background: white; } 
        .bc-paper { box-shadow: none; border: none; max-width: 100%; } 
    }

    .table-wrapper { padding: 0; border: 1px solid #e5e7eb; overflow: hidden; margin-top: 10px; border-radius: 6px; }
    .bc-table { width: 100%; border-collapse: collapse; font-size: 13px; background: white; }
    
    .bc-table th { 
        background: #f8fafc; 
        border-bottom: 2px solid #e2e8f0; 
        padding: 10px 8px; 
        text-align: left; 
        font-size: 11px; 
        text-transform: uppercase; 
        color: #64748b;
        letter-spacing: 0.5px;
    }
    
    .bc-table td { 
        border-bottom: 1px solid #f1f5f9; 
        height: 40px; 
        vertical-align: middle; 
        transition: background-color 0.2s;
    }
    
    .bc-table tbody tr:hover td {
        background-color: #f8fafc;
    }

    .bc-table tr:last-child td { border-bottom: none; }
    
    /* Inputs invisibles qui deviennent actifs au focus */
    .p-0 { padding: 0 !important; }
    .cell-input { 
        width: 100%; 
        height: 40px; /* Aligné sur la hauteur du td */
        border: 2px solid transparent; /* Bordure transparente par défaut */
        background: transparent; 
        padding: 0 10px; 
        box-sizing: border-box; 
        font-family: inherit; 
        font-size: 13px; 
        color: #334155;
        transition: all 0.2s ease;
        border-radius: 4px;
    }
    
    .cell-input:hover {
        background: #f1f5f9;
    }

    .cell-input:focus { 
        background: #ffffff; 
        border: 2px solid #2e46a6; 
        outline: none;
        box-shadow: 0 0 0 3px rgba(46, 70, 166, 0.1);
    }

    /* Utilitaires de texte pour le tableau */
    .center { text-align: center; }
    .fw-bold { font-weight: 600; }
    .text-blue { color: #2e46a6; }

    /* Petit message d'information stylisé */
    .alert-info-soft {
        background-color: #f0fdf4;
        color: #166534;
        padding: 10px 15px;
        border-radius: 6px;
        font-size: 12px;
        display: flex;
        align-items: center;
        gap: 8px;
        border: 1px solid #bbf7d0;
    }
</style>
