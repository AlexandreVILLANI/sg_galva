    }

    function initPhotoUpload() {
        const dropZone = document.getElementById('drop-zone');
        const fileInput = document.querySelector('input[type="file"]');
        const previewContainer = document.getElementById('file-preview');
        let currentFiles = [];

        if (dropZone && fileInput) {
            ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
                dropZone.addEventListener(eventName, e => { e.preventDefault(); e.stopPropagation(); }, false);
                document.body.addEventListener(eventName, e => { e.preventDefault(); e.stopPropagation(); }, false);
            });

            ['dragenter', 'dragover'].forEach(eventName => {
                dropZone.addEventListener(eventName, () => dropZone.classList.add('highlight'), false);
            });

            ['dragleave', 'drop'].forEach(eventName => {
                dropZone.addEventListener(eventName, () => dropZone.classList.remove('highlight'), false);
            });

            dropZone.addEventListener('drop', e => handleFiles(e.dataTransfer.files), false);
            fileInput.addEventListener('change', function() { handleFiles(this.files); });
        }

        function handleFiles(files) {
            if (!files || files.length === 0) return;
            const newFiles = Array.from(files).filter(file => file.type.startsWith('image/') || file.type === 'application/pdf');
            if (newFiles.length === 0) { alert("Format non supporté."); return; }
            currentFiles = [...currentFiles, ...newFiles];
            if (currentFiles.length > 5) {
                alert("Maximum 5 documents autorisés.");
                currentFiles = currentFiles.slice(0, 5);
            }
            renderPreview();
            updateInput();
        }

        function renderPreview() {
            if (!previewContainer) return;
            previewContainer.innerHTML = ''; 
            currentFiles.forEach((file, index) => {
                const reader = new FileReader();
                const div = document.createElement('div');
                div.className = 'photo-item preview-item';
                reader.onload = e => {
                    div.innerHTML = `
                        <button type="button" class="btn-remove-photo" onclick="removeFile(${index})" title="Supprimer">
                            <i class="fas fa-times"></i>
                        </button>
                        <img src="${e.target.result}" alt="Aperçu">
                        <span class="file-name" style="font-size: 11px; margin-top:5px; display:block; overflow:hidden;">
                            ${file.name.substring(0, 15)}...
                        </span>
                    `;
                };
                reader.readAsDataURL(file);
                previewContainer.appendChild(div);
            });
        }

        window.removeFile = function(index) {
            currentFiles.splice(index, 1);
            renderPreview();
            updateInput();
        };

        function updateInput() {
            if (!fileInput) return;
            const dataTransfer = new DataTransfer();
            currentFiles.forEach(file => dataTransfer.items.add(file));
            fileInput.files = dataTransfer.files;
        }
    }
    
    document.addEventListener('turbo:load', function() {
        applyBcGalvaLogic();
        initPhotoUpload();
    });
    applyBcGalvaLogic();
    initPhotoUpload();
</script>
{% endblock %}