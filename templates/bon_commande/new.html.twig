    .bc-title-container h1 { font-size: 22px; font-weight: 800; text-align: center; margin: 0; }
    .bc-refi-container { text-align: right; font-size: 20px; font-weight: bold; }
    .bc-refi-container input { border: none; font-weight: bold; font-size: 20px; width: 140px; text-align: right; background: transparent; }

    .bc-top-grid, .bc-middle-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0; margin-bottom: 20px; }
    .bc-box { border: 1px solid #ddd; padding: 15px; margin-bottom: 20px; }
    
