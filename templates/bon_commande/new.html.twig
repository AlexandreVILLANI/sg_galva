{% extends 'base.html.twig' %}

{% block title %}Bon de commande - {{ fiche.client.nom }}{% endblock %}

{% block body %}
{# --- DEPENDANCES RECHERCHE CLIENT --- #}
<link href="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/css/tom-select.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/js/tom-select.complete.min.js"></script>

<div class="bc-wrapper">
    {{ form_start(form, {'attr': {'class': 'bc-paper', 'enctype': 'multipart/form-data'}}) }}
    
        <div class="bc-header">
            <div class="bc-logo-container">
                <img src="{{ asset('images/sg-galva-logo.png') }}" alt="Logo" class="bc-logo">
            </div>
            <div class="bc-title-container">
                <h1>BON DE COMMANDE</h1>
            </div>
            <div class="bc-refi-container">
                <label>REFI -</label>
                {{ form_widget(form.refi, {'attr': {'class': 'refi-input-ghost', 'readonly': 'readonly'}}) }}
            </div>
        </div>

        {# --- GRILLE HAUTE : TRAITEMENT & FORFAIT --- #}
        <div class="bc-top-grid">
            <div class="bc-box treatment-box">
                <p class="box-label">TRAITEMENT :</p>
                <div class="checkbox-group">
                    <label>{{ form_widget(form.isGalvanisation) }} (Galvanisation)</label>
                    <label>{{ form_widget(form.isCataphorese) }} (Cataphorèse)</label>
                </div>
            </div>
            <div class="bc-box summary-box">
                <div class="summary-line">
                    <span>Forfait :</span> 
                    <strong>{{ form_widget(form.forfait) }}</strong> 
                </div>
                <div class="summary-line">
                    <span>Nb PAQ :</span> 
                    <strong>{{ fiche.totalPaquets }}</strong> 
                </div>
                <div class="summary-line">
                    <span>Stockage :</span> 
                    <strong>{{ form_widget(form.stockage) }}</strong>
                </div>
                <div class="summary-line">
                    <span>GALVA :</span> 
                    <strong>{{ form_widget(form.typeGalva) }}</strong>
                </div>            
            </div>
        </div>

        {# --- GRILLE MILIEU : CLIENT & CHAUFFEUR --- #}
        <div class="bc-middle-grid">
            <div class="bc-box client-box">
                <div class="field">
                    <span class="label">SOCIETE :</span> 
                    <span class="val" id="client-display-area">
                        <strong id="client-name-text">{{ fiche.client.nom }}</strong>
                        
                        {# Bouton d'édition si client à définir #}
                        {% if fiche.client.nom|lower in ['à définir', 'a definir'] %}
                            <button type="button" class="btn-edit-client-bc no-print" onclick="toggleClientEdit()">
                                <i class="fas fa-user-edit"></i> Attribuer un client
                            </button>
                        {% endif %}
                    </span>

                    {# Zone de sélection (cachée par défaut) #}
                    <div id="client-edit-area" style="display: none; margin-top: 10px;" class="no-print">
                        <select id="new-client-select" placeholder="Rechercher un client..." autocomplete="off">
                            <option value="">-- Choisir le bon client --</option>
                            {% for c in clients %}
                                <option value="{{ c.id }}">{{ c.nom }}</option>
                            {% endfor %}
                        </select>
                        <div style="display: flex; gap: 10px; margin-top: 10px;">
                            <button type="button" class="btn-save-client-bc" onclick="saveNewClient({{ fiche.id }})">
                                <i class="fas fa-check"></i> Valider
                            </button>
                            <button type="button" class="btn-cancel-client-bc" onclick="toggleClientEdit()">
                                Annuler
                            </button>
                        </div>
                    </div>
                </div>
                
                <div class="field">
                    <span class="label">Adresse :</span> 
                    <span class="val">{{ fiche.client.adresseFacturation|default(fiche.client.adresseLivraison)|default('---') }}</span>
                </div>
                <div class="field">
                    <span class="label">Date :</span> 
                    <span class="val">{{ "now"|date('d/m/Y') }}</span> 
                </div>
            </div>

            <div class="bc-box driver-box">
                <div class="field">
                    <span class="label">Nom du chauffeur :</span> 
                    {{ form_widget(form.nomChauffeur, {'attr': {'class': 'ghost-input', 'placeholder': '(Saisir nom)'}}) }}
                </div>
                <div class="field">
                    <span class="label">Tél :</span> 
                    <span class="val">{{ fiche.client.telephone|default('(Non renseigné)') }}</span>
                </div>
                <div class="field">
                    <span class="label">Fax :</span> 
                    <span class="val">{{ fiche.client.fax|default('(Non renseigné)') }}</span>
                </div>
            </div>
        </div>

        <div class="bc-box description-box table-wrapper">
            <p class="box-label">DÉTAILS DU DÉCHARGEMENT</p>
            <table class="bc-table mt-2">
                <thead>
                    <tr>
                        <th width="15%" class="center">Nb Paquets</th>
                        <th width="50%">Désignation</th>
                        <th width="35%">Emplacement</th>
                    </tr>
                </thead>
                <tbody>
                    {% for ligneForm in form.lignes %}
                        <tr>
                            <td class="p-0 center">{{ form_widget(ligneForm.nbPaquets, {'attr': {'class': 'cell-input center fw-bold text-blue'}}) }}</td>
                            <td class="p-0">{{ form_widget(ligneForm.description, {'attr': {'class': 'cell-input fw-bold'}}) }}</td>
                            <td class="p-0">{{ form_widget(ligneForm.emplacement, {'attr': {'class': 'cell-input'}}) }}</td>
                        </tr>
                    {% else %}
                        <tr><td colspan="3" class="center muted py-3">Aucune ligne trouvée.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
            
            <div class="mt-3 no-print alert-info-soft">
                <i class="fas fa-info-circle"></i> Modifiez les quantités, descriptions ou emplacements directement dans le tableau. Les changements mettront à jour la fiche d'origine lors de la sauvegarde.
            </div>
        </div>

        <div class="bc-box emplacement-box">
            <span class="label">Emplacement :</span>
            <strong>
                {% for ligne in fiche.lignes %}
                    {{ ligne.emplacement.nom }}{% if not loop.last %} // {% endif %}
                {% endfor %}
            </strong>
        </div>

        <div class="bc-box comment-box">
            <span class="label">Commentaires / Observations :</span>
            <div class="mt-2">
                {{ form_widget(form.commentaire) }}
            </div>
        </div>

        <div class="photo-section mt-4">
            <div class="bc-box mb-4">
                <label class="label">Archive Déchargement (Photos Fiche #{{ fiche.id }})</label>
                <div class="photo-grid">
                    {% for photo in fiche.photos %}
                        {% set ext = photo.nomFichier|split('.')|last|lower %}
                        <div class="photo-item archive-item" style="text-align:center;">
                            {% if ext == 'pdf' %}
                                <a href="{{ asset('uploads/fiches/' ~ photo.nomFichier) }}" target="_blank" style="text-decoration:none; display:block; padding-top:20px;">
                                    <i class="fas fa-file-pdf" style="font-size: 40px; color: #e06e54;"></i>
                                    <div style="margin-top: 10px; font-size: 12px; color: #2e46a6; word-break: break-all;">{{ photo.nomFichier }}</div>
                                </a>
                            {% else %}
                                <img src="{{ asset('uploads/fiches/' ~ photo.nomFichier) }}" alt="Photo déchargement" onclick="window.open(this.src)">
                            {% endif %}
                        </div>
                    {% else %}
                        <p class="no-data">Aucune photo jointe au déchargement.</p>
                    {% endfor %}
                </div>
            </div>

            <hr class="no-print">

            <div class="bc-box photos-container">
                <label class="label">Photos complémentaires (Ce Bon)</label>
                <div class="form-group mt-2">
                    
                    <div style="display: none;">
                        {{ form_widget(form.imageFiles, {
                            'attr': {
                                'multiple': 'multiple', 
                                'accept': 'image/*,application/pdf', 
                                'capture': 'environment'
                            }
                        }) }}
                    </div>

                    <div class="upload-zone" id="drop-zone" onclick="document.getElementById('{{ form.imageFiles.vars.id }}').click()">
                        <i class="fas fa-paperclip"></i>
                        <p>Glisser-déposer plusieurs photos ou <span class="browse">Parcourir</span></p>
                    </div>
                    
                    <div id="file-preview" class="photo-grid mt-3"></div>
                </div>
            </div>
        </div>

        <div class="bc-actions no-print">
            <a href="{{ path('app_reception_terrain_home', {'section': 'list-scans'}) }}" class="btn-cancel">
                <i class="fas fa-arrow-left"></i> Annuler
            </a>
            
            <button type="submit" class="btn-confirm"><i class="fas fa-save"></i> VALIDER LA RÉCEPTION</button>
        </div>        
        
        <div style="display: none;">
            {% for ligneForm in form.lignes %}
                {{ form_rest(ligneForm) }}
            {% endfor %}
        </div>

        {{ form_rest(form) }}
    {{ form_end(form) }}
</div>

<script>
    function applyBcGalvaLogic() {
        const checkGalva = document.getElementById("bon_de_commande_isGalvanisation") || document.querySelector('input[name="bon_de_commande[isGalvanisation]"]');
        const checkCata = document.getElementById("bon_de_commande_isCataphorese") || document.querySelector('input[name="bon_de_commande[isCataphorese]"]');
        const selectType = document.getElementById("bon_de_commande_typeGalva") || document.querySelector('select[name="bon_de_commande[typeGalva]"]');

        if (checkGalva && checkCata && selectType) {
            if (checkGalva.dataset.initialized) return;
            checkGalva.dataset.initialized = 'true';

            const allOptions = Array.from(selectType.options).map(opt => ({
                value: opt.value,
                text: opt.text,
                selected: opt.selected
            }));

            function updateSelect() {
                const currentValue = selectType.value;
                selectType.innerHTML = '';

                let allowedValues = [];
                if (checkGalva.checked) {
                    allowedValues.push('GB (Grand Bain)', 'PB (Petit Bain)', 'Mixte (GB + PB)', 'GB', 'PB', 'Mixte');
                }
                if (checkCata.checked) {
                    allowedValues.push('Cataphorèse', 'CATA');
                }
                if (!checkGalva.checked && !checkCata.checked) {
                    allowedValues = allOptions.map(o => o.value);
                }

                allOptions.forEach(opt => {
                    if (allowedValues.includes(opt.value) || allowedValues.includes(opt.text)) {
                        const newOpt = document.createElement('option');
                        newOpt.value = opt.value;
                        newOpt.text = opt.text;
                        if (opt.value === currentValue) {
                            newOpt.selected = true;
                        }
                        selectType.appendChild(newOpt);
                    }
                });
            }

            checkGalva.addEventListener('change', function(e) {
                if (this.checked) {
                    checkCata.checked = false;
                } else if (!checkCata.checked) {
                    this.checked = true;
                }
                updateSelect();
            });

            checkCata.addEventListener('change', function(e) {
                if (this.checked) {
                    checkGalva.checked = false;
                } else if (!checkGalva.checked) {
                    this.checked = true;
                }
                updateSelect();
            });

            if (checkGalva.checked && checkCata.checked) {
                checkCata.checked = false;
            } else if (!checkGalva.checked && !checkCata.checked) {
                checkGalva.checked = true;
            }
            
            updateSelect();
        }
    }
    
    document.addEventListener('turbo:load', applyBcGalvaLogic);
    applyBcGalvaLogic();
</script>
<style>
