{% extends 'base.html.twig' %}

{% block title %}Modification  Bon de commande - {{ fiche.client.nom }}{% endblock %}

{% block body %}
<div class="bc-wrapper">
    {{ form_start(form, {'attr': {'class': 'bc-paper'}}) }}
        
        {# --- ENTÊTE --- #}
        <div class="bc-header">
            <div class="bc-logo-container">
                <img src="{{ asset('images/sg-galva-logo.png') }}" alt="Logo" class="bc-logo">
            </div>
            <div class="bc-title-container">
                <h1>MODIFICATION BON DE COMMANDE</h1>
            </div>
            <div class="bc-refi-container">
                <label>REFI -</label>
                {# Le REFI est strictement en lecture seule #}
                {{ form_widget(form.refi, {'attr': {'class': 'refi-input-ghost', 'readonly': 'readonly'}}) }}
            </div>
        </div>

        <div class="bc-top-grid">
            <div class="bc-box treatment-box">
                <p class="box-label">TRAITEMENT :</p>
                <div class="checkbox-group">
                    <label>{{ form_widget(form.isGalvanisation) }} (Galvanisation)</label>
                    <label>{{ form_widget(form.isCataphorese) }} (Cataphorèse)</label>
                </div>
            </div>
            <div class="bc-box summary-box">
                <div class="summary-line">
                    <span>Forfait :</span> 
                    <strong>{{ form_widget(form.forfait, {'attr': {'class': 'ghost-select editable-field'}}) }}</strong> 
                </div>
                <div class="summary-line">
                    <span>Nb PAQ :</span> 
                    {# Calculé automatiquement par le JavaScript #}
                    <strong class="val-readonly" id="total-paquets-display" style="padding: 2px 10px;">{{ fiche.totalPaquets }}</strong> 
                </div>
                <div class="summary-line">
                    <span>Stockage :</span> 
                    <strong>{{ form_widget(form.stockage, {'attr': {'class': 'ghost-select editable-field'}}) }}</strong>
                </div>
                <div class="summary-line">
                    <span>GALVA :</span> 
                    <strong>{{ form_widget(form.typeGalva, {'attr': {'class': 'ghost-select editable-field'}}) }}</strong>
                </div>
            </div>
        </div>

        <div class="bc-middle-grid">
            <div class="bc-box client-box">
                <div class="field">
                    <span class="label">SOCIETE :</span> 
                    {# Menu déroulant avec la liste des clients #}
                    <select name="nouveau_client" id="client-select" class="ghost-select editable-field" style="width: 100%; max-width: 300px; padding: 4px;">
                        {% for c in clients %}
                            {# On stocke le téléphone dans data-tel pour le JavaScript #}
                            <option value="{{ c.id }}" data-tel="{{ c.telephone|default('(Non renseigné)') }}" {% if c.id == fiche.client.id %}selected{% endif %}>
                                {{ c.nom }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
                <div class="field" style="margin-top: 15px;">
                    <span class="label">Date :</span> 
                    <span class="val val-readonly" style="font-weight: bold;">{{ bon.date|date('d/m/Y') }}</span>
                </div>
            </div>
            <div class="bc-box driver-box">
                <div class="field">
                    <span class="label">Nom du chauffeur :</span> 
                    {{ form_widget(form.nomChauffeur, {'attr': {'class': 'ghost-input editable-field'}}) }}
                </div>
                <div class="field" style="margin-top: 15px;">
                    <span class="label">Tél :</span> 
                    {# Ce span a maintenant un ID pour être mis à jour par le script #}
                    <span class="val val-readonly" id="client-telephone-display" style="font-weight: bold;">
                        {{ fiche.client.telephone|default('(Non renseigné)') }}
                    </span>
                </div>
            </div>
        </div>

        {# --- TABLEAU DES LIGNES (Modifiables et liées au contrôleur via l'attribut "name") --- #}
        <div class="bc-box description-box">
            <div class="desc-main">
                <p><strong>DÉTAILS DU DÉCHARGEMENT (LIGNES)</strong></p>
                <table style="width: 100%; text-align: left; border-collapse: collapse;">
                    <thead>
                        <tr>
                            <th style="border-bottom: 1px solid #ccc; padding-bottom: 5px;">Qté</th>
                            <th style="border-bottom: 1px solid #ccc; padding-bottom: 5px;">Description du produit</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for ligne in fiche.lignes %}
                            <tr>
                                <td style="padding: 5px 0;">
                                    {# L'attribut name="lignes[id][qte]" va permettre à Symfony de récupérer la valeur #}
                                    <input type="number" name="lignes[{{ ligne.id }}][qte]" class="ghost-input editable-field input-qte" value="{{ ligne.nbPaquets }}" style="width: 60px;" oninput="calculerTotalPaquets()" min="0">
                                </td>
                                <td style="padding: 5px 0;">
                                    <input type="text" name="lignes[{{ ligne.id }}][desc]" class="ghost-input editable-field" value="{{ ligne.description|default('') }}" style="width: 95%;">
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        {# --- ZONE COMMENTAIRES (OBSERVATIONS) --- #}
        <div class="bc-box comment-box">
            <span class="label">Commentaires / Observations :</span>
            <div class="mt-2">
                {{ form_widget(form.commentaire, {'attr': {'class': 'editable-field', 'placeholder': 'Saisir ici vos observations...', 'rows': '3'}}) }}
            </div>
        </div>

        {# --- SECTION PHOTOS (Strictement LECTURE SEULE) --- #}
        <div class="photo-section mt-4">
            <div class="bc-box mb-4">
                <label class="label">Archive Déchargement (Fiche #{{ fiche.id }})</label>
                <div class="photo-grid">
                    {% for photo in fiche.photos %}
                        <div class="photo-item archive-item">
                            <img src="{{ asset('uploads/fiches/' ~ photo.nomFichier) }}" onclick="window.open(this.src)">
                        </div>
                    {% else %}
                        <p style="color: #6b7280; font-style: italic; font-size: 13px;">Aucune photo d'archive.</p>
                    {% endfor %}
                </div>
            </div>

            <div class="bc-box">
                <label class="label">Photos complémentaires du Bon</label>
                <div class="photo-grid mb-4">
                    {% for photo in bon.photos %}
                        <div class="photo-item">
                            <img src="{{ asset('uploads/bons/' ~ photo.nomFichier) }}" onclick="window.open(this.src)">
                        </div>
                    {% else %}
                        <p style="color: #6b7280; font-style: italic; font-size: 13px;">Aucune photo additionnelle sur ce bon.</p>
                    {% endfor %}
                </div>
            </div>
        </div>

        {# --- ACTIONS --- #}
        <div class="bc-actions no-print">
            <a href="{{ path('app_admin_home', {'section': 'admin-bc'}) }}" class="btn-cancel" style="background-color: #6b7280; color: white;">
                <i class="fas fa-arrow-left"></i> Annuler
            </a>
            
            <button type="submit" class="btn-confirm"><i class="fas fa-save"></i> METTRE À JOUR LE BON</button>
        </div>
        <div style="display:none;">{{ form_rest(form) }}</div>
    {{ form_end(form) }}
</div>

<script>
    // Calcule automatiquement la somme des paquets lors d'une modification
    function calculerTotalPaquets() {
        const inputsQte = document.querySelectorAll('.input-qte');
        let total = 0;
        
        inputsQte.forEach(input => {
            const val = parseInt(input.value) || 0;
            total += val;
        });
        
        document.getElementById('total-paquets-display').textContent = total;
        document.getElementById('client-select').addEventListener('change', function() {
        // On récupère l'option actuellement sélectionnée
        const selectedOption = this.options[this.selectedIndex];
        // On lit l'attribut data-tel qu'on a mis dans Twig
        const newPhone = selectedOption.getAttribute('data-tel');
        // On met à jour l'affichage
        document.getElementById('client-telephone-display').textContent = newPhone;
    });
    }
</script>

<script>
    function applyBcGalvaLogic() {
        const checkGalva = document.getElementById("bon_de_commande_isGalvanisation") || document.querySelector('input[name="bon_de_commande[isGalvanisation]"]');
        const checkCata = document.getElementById("bon_de_commande_isCataphorese") || document.querySelector('input[name="bon_de_commande[isCataphorese]"]');
        const selectType = document.getElementById("bon_de_commande_typeGalva") || document.querySelector('select[name="bon_de_commande[typeGalva]"]');

        if (checkGalva && checkCata && selectType) {
            if (checkGalva.dataset.initialized) return;
            checkGalva.dataset.initialized = 'true';

            const allOptions = Array.from(selectType.options).map(opt => ({
                value: opt.value,
                text: opt.text,
                selected: opt.selected
            }));

            function updateSelect() {
                const currentValue = selectType.value;
                selectType.innerHTML = '';

                let allowedValues = [];
                if (checkGalva.checked) {
                    allowedValues.push('GB (Grand Bain)', 'PB (Petit Bain)', 'Mixte (GB + PB)', 'GB', 'PB', 'Mixte');
                }
                if (checkCata.checked) {
                    allowedValues.push('Cataphorèse', 'CATA');
                }
                if (!checkGalva.checked && !checkCata.checked) {
                    allowedValues = allOptions.map(o => o.value);
                }

                allOptions.forEach(opt => {
                    if (allowedValues.includes(opt.value) || allowedValues.includes(opt.text)) {
                        const newOpt = document.createElement('option');
                        newOpt.value = opt.value;
                        newOpt.text = opt.text;
                        if (opt.value === currentValue) {
                            newOpt.selected = true;
                        }
                        selectType.appendChild(newOpt);
                    }
                });
            }

            checkGalva.addEventListener('change', function(e) {
                if (this.checked) {
                    checkCata.checked = false;
                } else if (!checkCata.checked) {
                    this.checked = true;
                }
                updateSelect();
            });

            checkCata.addEventListener('change', function(e) {
                if (this.checked) {
                    checkGalva.checked = false;
                } else if (!checkGalva.checked) {
                    this.checked = true;
                }
                updateSelect();
            });

            if (checkGalva.checked && checkCata.checked) {
                checkCata.checked = false;
            } else if (!checkGalva.checked && !checkCata.checked) {
                checkGalva.checked = true;
            }
            
            updateSelect();
        }
    }
    
    document.addEventListener('turbo:load', applyBcGalvaLogic);
    applyBcGalvaLogic();
</script>

<style>
    :root { --primary-blue: #2e46a6; --edit-bg: #fdfae5; }
    .bc-wrapper { background: #f0f0f0; min-height: 100vh; padding: 40px 20px; font-family: sans-serif; }
    .bc-paper { max-width: 900px; margin: 0 auto; background: white; padding: 40px; box-shadow: 0 0 20px rgba(0,0,0,0.1); }
    .bc-box { border: 1px solid #ddd; padding: 15px; margin-bottom: 20px; }
    
    .bc-header { display: grid; grid-template-columns: 1fr 2fr 1.5fr; align-items: center; border-bottom: 2px solid #000; padding-bottom: 10px; margin-bottom: 20px; }
    .bc-logo { max-width: 120px; }
    .bc-title-container h1 { font-size: 22px; font-weight: 800; text-align: center; margin: 0; color: #b45309; }
    .bc-refi-container { text-align: right; font-size: 20px; font-weight: bold; }
    
    .bc-top-grid, .bc-middle-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0; }
    .summary-line { display: flex; justify-content: space-between; border-bottom: 1px solid #f0f0f0; padding: 3px 0; font-size: 13px; align-items: center; }
    .label { font-weight: bold; font-size: 12px; text-transform: uppercase; margin-right: 5px; }
    .field { margin-bottom: 15px; }

    /* Champs modifiables VS Lecture seule */
    .editable-field { background-color: var(--edit-bg) !important; border-bottom: 2px solid #dcb35c !important; transition: 0.2s; border-radius: 4px 4px 0 0; }
    .editable-field:focus, .editable-field:hover { background-color: #fef08a !important; outline: none; }
    
    .val-readonly { background: #f3f4f6; color: #4b5563; padding: 4px 8px; border-radius: 4px; border: 1px solid #e5e7eb; display: inline-block; }
    .refi-input-ghost { border: none; font-weight: bold; font-size: 20px; width: 140px; text-align: right; outline: none; background: transparent; color: #6b7280; }

    .ghost-input { border: none; background: transparent; font-family: inherit; font-size: 14px; font-weight: bold; padding: 4px 8px; width: 100%; color: #333; }
    .ghost-select { border: none; background: transparent; font-family: inherit; font-size: 14px; font-weight: bold; padding: 4px; color: var(--primary-blue); cursor: pointer; }
    
    .checkbox-group label { display: flex; align-items: center; gap: 8px; cursor: pointer; font-size: 13px; margin-bottom: 5px; }
    .comment-box textarea { width: 100%; border: none; background: transparent; line-height: 1.8; font-family: inherit; font-size: 15px; color: #333; padding: 10px; }

    .bc-actions { display: flex; gap: 20px; margin-top: 30px; }
    .btn-cancel { flex: 1; padding: 15px; text-align: center; border-radius: 5px; text-decoration: none; font-weight: bold; display: flex; justify-content: center; align-items: center; gap: 10px;}
    .btn-confirm { flex: 2; background: #eab308; color: #713f12; border: none; padding: 15px; border-radius: 5px; font-weight: 900; cursor: pointer; font-size: 16px; display: flex; justify-content: center; align-items: center; gap: 10px; transition: 0.2s; }
    .btn-confirm:hover { background: #ca8a04; color: white; }

    .photo-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 15px; }
    .photo-item { position: relative; height: 140px; border-radius: 6px; overflow: hidden; border: 2px solid #eee; }
    .photo-item img { width: 100%; height: 100%; object-fit: cover; cursor: pointer; transition: 0.2s; }
    .photo-item img:hover { transform: scale(1.05); }
    .archive-item img { filter: contrast(0.8) grayscale(20%); }
</style>
{% endblock %}
