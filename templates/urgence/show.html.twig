{% extends 'base.html.twig' %}

{% block title %}Détails Déchargement Urgence #{{ urgence.id }}{% endblock %}

{% block body %}
<div class="bc-container">
    <div class="bc-header-premium">
        <div class="header-content">
            <div class="header-badges">
                <span class="badge-status-provisoire"><i class="fas fa-exclamation-circle"></i> PROVISOIRE</span>
                <span class="badge-id">#{{ urgence.id }}</span>
            </div>
            <h1 class="bc-title">Déchargement d'Urgence</h1>
            <p class="bc-subtitle">Enregistré le {{ urgence.dateCreation|date('d/m/Y') }} à {{ urgence.dateCreation|date('H:i') }}</p>
        </div>
        <div class="header-actions">
            <form method="post" action="{{ path('app_urgence_delete', {'id': urgence.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer définitivement cette urgence ?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete_urgence' ~ urgence.id) }}">
                <button type="submit" class="btn-delete-premium"><i class="fas fa-trash-alt"></i> Supprimer</button>
            </form>
        </div>
    </div>

    <div class="bc-grid-premium">
        <div class="bc-card client-card">
            <div class="card-icon"><i class="fas fa-building"></i></div>
            <div class="card-details">
                <span class="label">Client concerné</span>
                <div class="val">{{ urgence.client ? urgence.client.nom : 'Client non renseigné' }}</div>
            </div>
        </div>
        <div class="bc-card stats-card">
            <div class="card-icon blue"><i class="fas fa-boxes"></i></div>
            <div class="card-details">
                <span class="label">Total Lignes</span>
                <div class="val">{{ urgence.lignes|length }} ligne(s) enregistrée(s)</div>
            </div>
        </div>
    </div>

    <div class="bc-card main-content-card">
        <div class="card-header">
            <h3><i class="fas fa-list"></i> Lignes de produits</h3>
        </div>
        <div class="table-responsive">
            <table class="premium-table">
                <thead>
                    <tr>
                        <th width="15%" class="center">Nb Palettes</th>
                        <th width="55%">Désignation Produit</th>
                        <th width="30%">Poids</th>
                    </tr>
                </thead>
                <tbody>
                    {% for ligne in urgence.lignes %}
                        <tr>
                            <td class="center"><span class="badge-qty">{{ ligne.nbPalettes }}</span></td>
                            <td class="product-name">{{ ligne.nomProduit|default('---') }}</td>
                            <td class="weight-cell">{{ ligne.poids|default('---') }}</td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="3" class="empty-row">
                                <i class="fas fa-folder-open"></i>
                                <p>Aucun produit enregistré pour ce déchargement.</p>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {% if urgence.photos|length > 0 %}
    <div class="bc-card main-content-card mt-4">
        <div class="card-header">
            <h3><i class="fas fa-camera"></i> Photos attachées</h3>
        </div>
        <div class="photo-gallery">
            {% for photo in urgence.photos %}
                <a href="{{ asset('uploads/urgences/' ~ photo.nomFichier) }}" target="_blank" class="photo-item">
                    <img src="{{ asset('uploads/urgences/' ~ photo.nomFichier) }}" alt="Photo urgence">
                    <div class="photo-overlay">
                        <i class="fas fa-expand-arrows-alt"></i>
                    </div>
                </a>
            {% endfor %}
        </div>
    </div>
    {% endif %}

    <div class="bc-actions mt-4">
        <a href="{{ path('app_home', {'section': 'cariste-urgence'}) }}" class="btn-back-premium"><i class="fas fa-arrow-left"></i> Retour au tableau de bord</a>
    </div>
</div>

<style>
    /* PREMIUM DESIGN SYSTEM */
    :root {
        --c-bg: #f8fafc;
        --c-white: #ffffff;
        --c-text-main: #0f172a;
        --c-text-muted: #64748b;
        --c-border: #e2e8f0;
        --c-red-light: #fef2f2;
        --c-red: #ef4444;
        --c-red-hover: #dc2626;
        --c-blue-light: #eff6ff;
        --c-blue: #3b82f6;
        --c-indigo: #4f46e5;
    }

    body { background-color: var(--c-bg); }

    .bc-container { max-width: 1000px; margin: 0 auto; padding: 30px 20px; font-family: 'Inter', sans-serif; }
    
    /* HEADER */
    .bc-header-premium { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 30px; }
    .header-badges { display: flex; gap: 10px; margin-bottom: 12px; }
    .badge-status-provisoire { background: var(--c-red-light); color: var(--c-red); padding: 4px 10px; border-radius: 20px; font-size: 12px; font-weight: 700; letter-spacing: 0.5px; }
    .badge-id { background: #f1f5f9; color: var(--c-text-muted); padding: 4px 10px; border-radius: 20px; font-size: 12px; font-weight: 600; }
    .bc-title { font-size: 28px; font-weight: 800; color: var(--c-text-main); margin: 0 0 5px 0; letter-spacing: -0.5px; }
    .bc-subtitle { font-size: 14px; color: var(--c-text-muted); margin: 0; }
    
    /* CARDS */
    .bc-grid-premium { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 25px; }
    .bc-card { background: var(--c-white); border-radius: 12px; padding: 20px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05), 0 2px 4px -2px rgba(0,0,0,0.025); border: 1px solid var(--c-border); }
    
    .client-card, .stats-card { display: flex; align-items: center; gap: 15px; }
    .card-icon { width: 48px; height: 48px; border-radius: 12px; background: var(--c-red-light); color: var(--c-red); display: flex; align-items: center; justify-content: center; font-size: 20px; }
    .card-icon.blue { background: var(--c-blue-light); color: var(--c-blue); }
    
    .label { font-size: 11px; font-weight: 700; color: var(--c-text-muted); text-transform: uppercase; letter-spacing: 0.5px; display: block; margin-bottom: 4px;}
    .val { font-size: 16px; font-weight: 600; color: var(--c-text-main); }
    
    /* MAIN CONTENT & TABLE */
    .main-content-card { padding: 0; overflow: hidden; }
    .card-header { padding: 20px; border-bottom: 1px solid var(--c-border); background: #fafafa; }
    .card-header h3 { margin: 0; font-size: 15px; font-weight: 700; color: var(--c-text-main); display: flex; align-items: center; gap: 10px; }
    .card-header h3 i { color: var(--c-text-muted); }
    
    .premium-table { width: 100%; border-collapse: collapse; }
    .premium-table th { background: var(--c-white); padding: 12px 20px; text-align: left; font-size: 12px; font-weight: 600; color: var(--c-text-muted); border-bottom: 2px solid var(--c-border); }
    .premium-table td { padding: 15px 20px; border-bottom: 1px solid var(--c-border); color: var(--c-text-main); font-size: 14px; vertical-align: middle; }
    .premium-table tbody tr:last-child td { border-bottom: none; }
    .premium-table tbody tr:hover { background-color: #f8fafc; }
    
    .badge-qty { background: #f1f5f9; color: var(--c-text-main); padding: 4px 12px; border-radius: 6px; font-weight: 700; font-size: 13px; }
    .product-name { font-weight: 600; }
    .weight-cell { color: var(--c-text-muted); }
    
    .empty-row { text-align: center; padding: 40px 20px !important; color: var(--c-text-muted); }
    .empty-row i { font-size: 24px; opacity: 0.5; margin-bottom: 10px; }
    .empty-row p { margin: 0; font-size: 14px; }
    
    /* PHOTOS */
    .photo-gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 15px; padding: 20px; }
    .photo-item { position: relative; border-radius: 8px; overflow: hidden; aspect-ratio: 1; display: block; border: 1px solid var(--c-border); }
    .photo-item img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s ease; }
    .photo-overlay { position: absolute; inset: 0; background: rgba(0,0,0,0.4); display: flex; align-items: center; justify-content: center; opacity: 0; transition: opacity 0.2s ease; color: white; font-size: 24px; }
    .photo-item:hover img { transform: scale(1.05); }
    .photo-item:hover .photo-overlay { opacity: 1; }
    
    /* BUTTONS */
    .btn-delete-premium { background: var(--c-white); color: var(--c-red); border: 1px solid var(--c-red); padding: 8px 16px; border-radius: 6px; font-weight: 600; font-size: 13px; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; gap: 8px; }
    .btn-delete-premium:hover { background: var(--c-red); color: white; }
    
    .btn-back-premium { background: var(--c-white); color: var(--c-text-main); border: 1px solid var(--c-border); padding: 10px 20px; border-radius: 8px; font-weight: 600; font-size: 14px; cursor: pointer; transition: all 0.2s; display: inline-flex; align-items: center; gap: 10px; text-decoration: none; box-shadow: 0 1px 2px rgba(0,0,0,0.05); }
    .btn-back-premium:hover { background: var(--c-bg); border-color: #cbd5e1; }
    
    .center { text-align: center !important; }
    .mt-4 { margin-top: 25px; }
</style>
{% endblock %}
