{% extends 'base.html.twig' %}

{% block title %}Détail Déchargement #{{ fiche.id }}{% endblock %}

{% block body %}
<link href="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/css/tom-select.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/js/tom-select.complete.min.js"></script>
<div class="form-container">
    {# --- HEADER --- #}
    <div class="form-header">
        <img src="{{ asset('images/sg-galva-logo.png') }}" alt="Logo" class="logo">
        <h1>Fiche de déchargement</h1>
        <div class="header-right">
            <div class="date-input">
                <label>Date</label>
                <input type="text" value="{{ fiche.date|date('d/m/Y') }}" readonly class="form-control-static">
            </div>
        </div>
    </div>

    {# --- INFOS CARISTE / CLIENT --- #}
    <div class="info-grid">
        <div class="info-box">
            <label>Cariste</label>
            <p>{{ fiche.cariste.prenom }} {{ fiche.cariste.nom|default('') }}</p>
        </div>
        
        {# --- ZONE DU CLIENT (MODIFIABLE SI À DÉFINIR) --- #}
        <div class="info-box">
            <label>Client</label>
            
            <div id="client-display-area">
                <p>
                    <strong id="client-name-text">{{ fiche.client.nom }}</strong>
                    
                    {# On vérifie si le client est "A définir" (insensible à la casse/accents) #}
                    {% if fiche.client.nom|lower in ['à définir', 'a definir'] %}
                        <button type="button" class="btn-edit-client" onclick="toggleClientEdit()">
                            <i class="fas fa-edit"></i> Attribuer
                        </button>
                    {% endif %}
                </p>
            </div>

            {# --- Zone cachée par défaut (Select + Boutons) --- #}
            <div id="client-edit-area" style="display: none; margin-top: 10px;">
                <select id="new-client-select" placeholder="Tapez le nom d'un client..." autocomplete="off">
                    <option value="">-- Choisir le bon client --</option>
                    {% for c in clients %}
                        <option value="{{ c.id }}">{{ c.nom }}</option>
                    {% endfor %}
                </select>
                <div style="display: flex; gap: 10px; margin-top: 10px;">
                    <button class="btn-save-client" onclick="saveNewClient({{ fiche.id }})">
                        <i class="fas fa-check"></i> Valider
                    </button>
                    <button class="btn-cancel-client" onclick="toggleClientEdit()">
                        Annuler
                    </button>
                </div>
            </div>

        </div>
    </div>

    {# --- TABLEAU DES PAQUETS --- #}
    <div class="table-section">
        <table class="table-custom">
            <thead>
                <tr>
                    <th style="width: 20%;">NOMBRE DE PAQUETS</th>
                    <th style="width: 50%;">PRODUIT / DESCRIPTION</th>
                    <th style="width: 30%;">EMPLACEMENT</th>
                </tr>
            </thead>
            <tbody>
                {% for ligne in fiche.lignes %}
                    <tr>
                        <td style="text-align: center; padding: 15px;">{{ ligne.nbPaquets }}</td>
                        <td style="padding: 15px; color: #555; font-style: italic;">
                            {{ ligne.description|default('Non précisé') }}
                        </td>
                        <td style="padding: 15px;">{{ ligne.emplacement.nom }}</td>
                    </tr>
                {% endfor %}
            </tbody>
            <tfoot>
                <tr>
                    <td class="sum-value">Total : {{ fiche.totalPaquets }} paquets</td>
                    <td class="sum-empty"></td>
                    <td class="sum-empty"></td>
                </tr>
            </tfoot>
        </table>
    </div>

    {# --- OBSERVATIONS --- #}
    {% if fiche.observations %}
        <div class="info-box mt-4">
            <label>Observations</label>
            <p>{{ fiche.observations|nl2br }}</p>
        </div>
    {% endif %}

    {# --- PHOTOS --- #}
    <div class="photo-section mt-4">
        <label>Photos du déchargement</label>
        <div class="photo-grid">
            {% for photo in fiche.photos %}
                <div class="photo-item">
                    <img src="{{ asset('uploads/fiches/' ~ photo.nomFichier) }}" 
                         alt="Photo déchargement" 
                         onclick="window.open(this.src)">
                </div>
            {% else %}
                <p class="no-data">Aucune photo jointe.</p>
            {% endfor %}
        </div>
    </div>

    <div class="form-footer-actions">
        <a href="{{ path('app_admin_home', {'section': 'list-dechargement'}) }}" class="btn-secondary">
            <i class="fas fa-arrow-left"></i> Retour à la liste
        </a>
    </div>
</div>

<script>
    let clientSelectSearch = null;

    // Affiche ou cache la zone de modification
    function toggleClientEdit() {
        const displayArea = document.getElementById('client-display-area');
        const editArea = document.getElementById('client-edit-area');
        
        if (editArea.style.display === 'none') {
            displayArea.style.display = 'none';
            editArea.style.display = 'block';
            
            // MAGIE : On transforme le select classique en barre de recherche !
            if (!clientSelectSearch) {
                clientSelectSearch = new TomSelect("#new-client-select", {
                    create: false,         // Empêche de créer un client qui n'existe pas ici
                    sortField: {
                        field: "text",
                        direction: "asc"   // Trie par ordre alphabétique
                    }
                });
            }
            
        } else {
            editArea.style.display = 'none';
            displayArea.style.display = 'block';
        }
    }

    // Sauvegarde le nouveau client via AJAX
    async function saveNewClient(ficheId) {
        const select = document.getElementById('new-client-select');
        const clientId = select.value;

        if (!clientId) {
            alert("Veuillez sélectionner un client.");
            return;
        }

        const btnSave = document.querySelector('.btn-save-client');
        btnSave.innerHTML = '<i class="fas fa-spinner fa-spin"></i>...';
        btnSave.disabled = true;

        try {
            const response = await fetch(`/reception/dechargement/${ficheId}/update-client`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify({ client_id: clientId })
            });

            const data = await response.json();

            if (response.ok && data.success) {
                // Mise à jour visuelle réussie
                document.getElementById('client-name-text').textContent = data.clientName;
                document.querySelector('.btn-edit-client').style.display = 'none'; // On cache le bouton Attribuer
                
                // On réaffiche le bouton "Créer Bon de Commande" qui était caché car le client n'était pas défini
                const btnCreate = document.getElementById('btn-create-bc');
                if(btnCreate) btnCreate.style.display = 'flex';

                toggleClientEdit(); // Referme le menu
            } else {
                alert("Erreur lors de la mise à jour : " + (data.message || "Inconnue"));
                btnSave.innerHTML = '<i class="fas fa-check"></i> Valider';
                btnSave.disabled = false;
            }
        } catch (error) {
            alert("Erreur réseau.");
            btnSave.innerHTML = '<i class="fas fa-check"></i> Valider';
            btnSave.disabled = false;
        }
    }
</script>

<style>
    /* ... Tes styles existants ... */
    .info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 30px; }
    .info-box { background: #f8f9fa; padding: 15px; border-radius: 6px; border: 1px solid #eee; }
    .info-box label { display: block; font-size: 0.8rem; color: #888; text-transform: uppercase; margin-bottom: 5px; }
    .info-box p { margin: 0; font-size: 1.1rem; color: #333; display: flex; justify-content: space-between; align-items: center; }
    
    .photo-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 15px; margin-top: 10px; }
    .photo-item img { width: 100%; height: 150px; object-fit: cover; border-radius: 6px; cursor: pointer; border: 2px solid #eee; transition: 0.2s; }
    .photo-item img:hover { border-color: var(--primary-blue); transform: scale(1.02); }

    /* --- NOUVEAUX STYLES FOOTER ET BOUTONS CLIENT --- */
    .btn-edit-client { background: #e0e7ff; color: #4338ca; border: none; padding: 5px 10px; border-radius: 4px; font-size: 0.8rem; font-weight: bold; cursor: pointer; transition: 0.2s; }
    .btn-edit-client:hover { background: #c7d2fe; }

    .btn-save-client { background: var(--success-green, #27ae60); color: white; border: none; padding: 8px 15px; border-radius: 4px; font-weight: bold; cursor: pointer; }
    .btn-save-client:hover { background: #059669; }

    .btn-cancel-client { background: #e5e7eb; color: #4b5563; border: none; padding: 8px 15px; border-radius: 4px; font-weight: bold; cursor: pointer; }
    .btn-cancel-client:hover { background: #d1d5db; }

    .form-footer-actions { margin-top: 50px; padding-top: 30px; border-top: 2px solid #f0f0f0; display: flex; justify-content: space-between; align-items: center; }
    .btn-secondary { color: #666; text-decoration: none; font-weight: 600; display: flex; align-items: center; gap: 8px; }

    .btn-create-bc-large { background-color: var(--primary-blue); color: white; text-decoration: none; padding: 15px 30px; border-radius: 8px; font-weight: 700; font-size: 1rem; display: flex; align-items: center; gap: 12px; transition: all 0.3s ease; box-shadow: 0 4px 15px rgba(46, 70, 166, 0.3); }
    .btn-create-bc-large:hover { background-color: #1e2e6e; transform: translateY(-3px); box-shadow: 0 8px 20px rgba(46, 70, 166, 0.4); color: white; }
    
    .mt-4 { margin-top: 1.5rem; }
</style>
{% endblock %}