{% extends 'base.html.twig' %}

{% block title %}Édition Déchargement #{{ fiche.id }}{% endblock %}

{% block body %}
<link href="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/css/tom-select.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/js/tom-select.complete.min.js"></script>

<div class="form-container admin-mode">
    <form method="POST" action="{{ path('app_admin_dechargement_edit', {'id': fiche.id}) }}">      
        <div class="form-header admin-border">
            <img src="{{ asset('images/sg-galva-logo.png') }}" alt="Logo" class="logo">
            <div>
                <h1 style="color: var(--primary-admin);">ÉDITION Fiche #{{ fiche.id }}</h1>
                <span class="admin-badge">MODE ADMINISTRATEUR</span>
            </div>
            <div class="header-right">
                <div class="date-input">
                    <label>Date du déchargement (Fixe)</label>
                    <div class="admin-input" style="background: #f3f4f6; color: #6b7280; border-color: #e5e7eb; font-weight: 600;">
                        <i class="fas fa-calendar-alt"></i> {{ fiche.date|date('d/m/Y') }}
                    </div>
                </div>
            </div>
        </div>

        <div class="info-grid">
            {# --- CARISTE : AFFICHAGE FIXE --- #}
            <div class="info-box admin-highlight">
                <label>Cariste (Non modifiable)</label>
                <p style="margin: 8px 0; font-weight: 600; color: #374151;">
                    {{ fiche.cariste.prenom }} 
                </p>
            </div>
            
            <div class="info-box admin-highlight">
                <label>Client</label>
                <select id="client-select" name="client_id" autocomplete="off">
                    {% for c in clients %}
                        <option value="{{ c.id }}" {% if fiche.client.id == c.id %}selected{% endif %}>
                            {{ c.nom }}
                        </option>
                    {% endfor %}
                </select>
            </div>
        </div>

        <div class="table-section admin-highlight" style="padding: 15px; border-radius: 6px;">
            <label style="font-size: 0.8rem; color: #888; text-transform: uppercase; margin-bottom: 10px; display: block;">Lignes de déchargement</label>
            <table class="table-custom admin-table">
                <thead>
                    <tr>
                        <th style="width: 15%;">NB PAQUETS</th>
                        <th style="width: 50%;">PRODUIT / DESCRIPTION</th>
                        <th style="width: 35%;">EMPLACEMENT</th>
                    </tr>
                </thead>
                <tbody>
                    {% for ligne in fiche.lignes %}
                        <tr>
                            <td style="padding: 5px;">
                                <input type="number" name="lignes[{{ ligne.id }}][qte]" value="{{ ligne.nbPaquets }}" class="admin-input text-center" style="width: 100%;">
                            </td>
                            <td style="padding: 5px;">
                                <input type="text" name="lignes[{{ ligne.id }}][desc]" value="{{ ligne.description }}" class="admin-input" style="width: 100%;">
                            </td>
                            <td style="padding: 5px;">
                                <select name="lignes[{{ ligne.id }}][emplacement]" class="admin-input" style="width: 100%;">
                                    {% for emp in emplacements %}
                                        <option value="{{ emp.id }}" {% if ligne.emplacement and ligne.emplacement.id == emp.id %}selected{% endif %}>
                                            {{ emp.nom }}
                                        </option>
                                    {% endfor %}
                                </select>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="info-box mt-4 admin-highlight">
            <label>Observations</label>
            <textarea name="observations" class="admin-input" rows="3" style="width: 100%; resize: vertical;">{{ fiche.observations }}</textarea>
        </div>

        <div class="photo-section mt-4 info-box">
            <label>Photos du déchargement</label>
            <div class="photo-grid">
                {% for photo in fiche.photos %}
                    <div class="photo-item">
                        <img src="{{ asset('uploads/fiches/' ~ photo.nomFichier) }}" alt="Photo" onclick="window.open(this.src)">
                    </div>
                {% else %}
                    <p class="no-data">Aucune photo jointe.</p>
                {% endfor %}
            </div>
        </div>

        <div class="form-footer-actions">
            <a href="{{ path('app_admin_home', {'section': 'admin-fd'}) }}" class="btn-cancel-admin">
                <i class="fas fa-times"></i> Annuler
            </a>
            <button type="submit" class="btn-save-admin">
                <i class="fas fa-save"></i> ENREGISTRER LES MODIFICATIONS
            </button>
        </div>
    </form>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        new TomSelect("#client-select", {
            create: false,
            sortField: { field: "text", direction: "asc" }
        });
    });
</script>

<style>
    :root { --primary-admin: #4f46e5; --admin-bg: #f8faff; }
    .form-container { max-width: 1000px; margin: 40px auto; background: white; padding: 40px; border-radius: 8px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); font-family: 'Inter', sans-serif; }
    .admin-mode { border-top: 8px solid var(--primary-admin); }
    .admin-border { border-bottom: 2px solid var(--primary-admin) !important; padding-bottom: 20px; margin-bottom: 30px; }
    .info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 30px; }
    .info-box { background: #fff; padding: 15px; border-radius: 6px; border: 1px solid #e5e7eb; }
    .admin-highlight { border: 1px solid #e0e7ff; background: var(--admin-bg); }
    .info-box label { display: block; font-size: 0.8rem; color: #6b7280; text-transform: uppercase; margin-bottom: 8px; font-weight: 600; }
    .admin-input { background: white; border: 1px solid #d1d5db; border-radius: 4px; padding: 8px 12px; font-size: 14px; width: 100%; box-sizing: border-box; }
    .table-custom { width: 100%; border-collapse: collapse; }
    .btn-save-admin { flex: 2; background: var(--primary-admin); color: white; border: none; padding: 16px; border-radius: 6px; font-weight: 800; cursor: pointer; }
    .btn-cancel-admin { flex: 1; background: #f3f4f6; color: #4b5563; text-align: center; padding: 16px; border-radius: 6px; text-decoration: none; }
    .photo-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px; }
    .photo-item img { width: 100%; height: 100px; object-fit: cover; border-radius: 4px; }
</style>
{% endblock %}