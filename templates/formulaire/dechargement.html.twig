{% extends 'base.html.twig' %}

{% block title %}Fiche de déchargement{% endblock %}

{% block body %}
<div class="form-container">
    <div class="form-header">
        <img src="{{ asset('images/sg-galva-logo.png') }}" alt="Logo" class="logo">
        <h1>Fiche de déchargement</h1>
        <div class="header-right">
            <a href="#" class="btn-link">Ouvrir les formulaires originaux <i class="fas fa-external-link-alt"></i></a>
            <div class="date-input">
                <label for="date-cloture">Date</label>
                <input type="date" id="date-cloture" name="date_cloture" value="{{ "now"|date("Y-m-d") }}">
            </div>
        </div>
    </div>

    <form class="main-form" method="post">
        <div class="form-row">
            <div class="form-group">
                <label for="cariste-select">Nom du cariste</label>
                <select id="cariste-select" name="cariste" class="form-control">
                    <option value="">Sélectionner...</option>
                    <option value="{{ app.user.id|default('') }}" selected>
                        {{ app.user.prenom|default('Cariste Connecté') }}
                    </option>
                </select>
            </div>
            <div class="form-group">
                <label for="client-select">Client</label>
                <div class="input-group-plus">
                    <select id="client-select" name="client" class="form-control" required>
                        <option value="">Sélectionner un client...</option>
                        <option value="Inconnu">Inconnu</option>
                        <optgroup label="Liste des clients">
                            {% for client in clients %}
                                <option value="{{ client.nom }}">{{ client.nom }}</option>
                            {% endfor %}
                        </optgroup>
                    </select>
                    <button type="button" class="btn-add-inline" id="btn-add-client" title="Ajouter un nouveau client">
                        <i class="fas fa-plus"></i>
                    </button>
                </div>
            </div>

            <div id="quick-add-client-input" class="form-group" style="display: none; margin-top: 10px; padding: 10px; background: #f0f4ff; border-radius: 4px;">
                <label>Nom du nouveau client</label>
                <input type="text" name="new_client_name" class="form-control" placeholder="Entrez le nom...">
            </div>

    <div id="new-client-group" class="form-group" style="display: none; margin-top: 10px;">
        <label for="new-client-name">Nom du nouveau client</label>
        <input type="text" id="new-client-name" name="new_client_name" class="form-control" placeholder="Entrez le nom du client...">
    </div>
        </div>

        <div class="table-section">
            <div class="table-header-info">
                <label>Détails du déchargement</label>
                <p class="subtitle"><span id="row-count">1</span> ligne(s)</p>
            </div>
            
            <table class="table-custom" id="unloading-table">
                <thead>
                    <tr>
                        <th style="width: 50px;">Action</th>
                        <th>NOMBRE DE PAQUETS</th>
                        <th>EMPLACEMENT</th>
                    </tr>
                </thead>
                <tbody id="table-body">
                    <tr class="data-row">
                        <td class="row-actions">
                            <button type="button" class="btn-remove-row" title="Supprimer"><i class="fas fa-trash"></i></button>
                        </td>
                        <td><input type="number" name="nb_paquets[]" class="table-input input-paquets" placeholder="0" min="0"></td>
                        <td><input type="text" name="emplacement[]" class="table-input" placeholder="Ex: Zone A1"></td>
                    </tr>
                </tbody>
                <tfoot>
                    <tr>
                        <td class="add-row-cell">
                            <button type="button" id="add-row-btn" class="btn-add-row">+</button>
                        </td>
                        <td class="sum-value">
                            Total : <span id="total-paquets">0</span>
                        </td>
                        <td class="sum-empty"></td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <div class="form-group">
            <label for="observations">Observations</label>
            <textarea id="observations" name="observations" class="form-control" rows="4" placeholder="Notes éventuelles..."></textarea>
        </div>

        <div class="form-group">
            <label>Joindre photos</label>
            <div class="upload-zone" id="drop-zone">
                <input type="file" id="file-input" name="photos[]" multiple hidden>
                <i class="fas fa-paperclip"></i>
                <p>Glisser-déposer ou <span class="browse">Parcourir</span></p>
            </div>
            <div id="file-preview" class="file-preview-container"></div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-submit">Valider le déchargement</button>
        </div>
    </form>
</div>

<style>
    :root {
        --primary-blue: #2e46a6;
        --secondary-gold: #dcb35c;
        --light-bg: #f8f9fa;
        --border-color: #dee2e6;
    }

    .form-container { max-width: 1000px; margin: 20px auto; background: white; padding: 30px; border: 1px solid #ddd; border-top: 6px solid var(--primary-blue); box-shadow: 0 4px 6px rgba(0,0,0,0.05); }
    .form-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 30px; border-bottom: 1px solid #eee; padding-bottom: 20px; }
    .form-header h1 { font-size: 1.8rem; color: #333; margin: 0; text-transform: uppercase; letter-spacing: 1px; }
    .logo { width: 140px; }
    .header-right { text-align: right; }
    .btn-link { color: #3498db; text-decoration: none; font-size: 0.85rem; font-weight: bold; }
    .date-input { margin-top: 15px; }
    .date-input label { font-weight: bold; margin-right: 10px; }
    .date-input input { padding: 8px; border: 1px solid #ccc; border-radius: 4px; }
    
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px; }
    .form-group { margin-bottom: 20px; }
    .form-group label { display: block; font-weight: 600; margin-bottom: 8px; color: #444; }
    .form-control { width: 100%; padding: 12px; border: 1px solid #ccc; border-radius: 4px; background: #fff; box-sizing: border-box; }
    
    .table-section { margin: 30px 0; }
    .table-header-info { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
    .subtitle { color: #888; font-size: 0.9rem; margin: 0; }
    
    .table-custom { width: 100%; border-collapse: collapse; }
    .table-custom th { background: var(--light-bg); border: 1px solid var(--border-color); padding: 12px; text-align: left; color: #555; font-size: 0.75rem; text-transform: uppercase; }
    .table-custom td { border: 1px solid var(--border-color); vertical-align: middle; }
    
    .table-input { width: 100%; border: none; padding: 12px; outline: none; box-sizing: border-box; }
    .table-input:focus { background-color: #f0f4ff; }
    
    .row-actions { text-align: center; }
    .btn-remove-row { background: transparent; border: none; color: #e74c3c; cursor: pointer; padding: 5px; }
    
    .btn-add-row { background: #2ecc71; color: white; border: none; width: 30px; height: 30px; border-radius: 50%; cursor: pointer; font-weight: bold; font-size: 1.2rem; display: flex; align-items: center; justify-content: center; margin: 5px auto; }
    
    .sum-value { background: var(--light-bg); text-align: right; padding: 12px 20px !important; font-weight: bold; color: var(--primary-blue); }
    .sum-empty { background: var(--light-bg); }

    .upload-zone { border: 2px dashed #ccc; padding: 30px; text-align: center; border-radius: 8px; color: #777; cursor: pointer; transition: 0.3s; }
    .upload-zone:hover { border-color: var(--primary-blue); background: #f9faff; }
    .upload-zone i { font-size: 1.5rem; margin-bottom: 10px; display: block; }
    .browse { color: var(--primary-blue); font-weight: bold; text-decoration: underline; }

    .form-actions { display: flex; justify-content: flex-end; margin-top: 40px; }
    .btn-submit { background-color: var(--secondary-gold); color: white; border: none; padding: 15px 50px; border-radius: 4px; font-size: 1.1rem; font-weight: bold; cursor: pointer; transition: 0.3s; box-shadow: 0 4px 0 #b38f3d; }
    .btn-submit:hover { background-color: #c9a24d; transform: translateY(-1px); }
    .btn-submit:active { transform: translateY(2px); box-shadow: none; }

    /* Alignement du select et du bouton + */
    .input-group-plus {
        display: flex;
        gap: 8px; /* Espace entre le select et le bouton */
        align-items: center;
    }

    .input-group-plus .form-control {
        flex: 1; /* Le select prend toute la place restante */
    }

    .btn-add-inline {
        background-color: #2e46a6; /* Bleu identique à ton en-tête */
        color: white;
        border: none;
        border-radius: 4px;
        width: 42px;
        height: 42px; /* Même hauteur que le champ select */
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background 0.3s ease;
    }

    .btn-add-inline:hover {
        background-color: #1e2e6e;
        transform: scale(1.05);
    }

    .btn-add-inline i {
        font-size: 1rem;
    }
</style>
{% endblock %}