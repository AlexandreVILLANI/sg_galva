{# templates/formulaire/show.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Détail Déchargement #{{ fiche.id }}{% endblock %}

{% block body %}
<div class="form-container">
    {# --- HEADER --- #}
    <div class="form-header">
        <img src="{{ asset('images/sg-galva-logo.png') }}" alt="Logo" class="logo">
        <h1>Fiche de déchargement</h1>
        <div class="header-right">
            <div class="date-input">
                <label>Date</label>
                <input type="text" value="{{ fiche.date|date('d/m/Y') }}" readonly class="form-control-static">
            </div>
        </div>
    </div>

    {# --- INFOS CARISTE / CLIENT --- #}
    <div class="info-grid">
        <div class="info-box">
            <label>Cariste</label>
            <p>{{ fiche.cariste.prenom }} {{ fiche.cariste.nom|default('') }}</p>
        </div>
        <div class="info-box">
            <label>Client</label>
            <p><strong>{{ fiche.client.nom }}</strong></p>
        </div>
    </div>

    {# --- TABLEAU DES PAQUETS --- #}
    <div class="table-section">
        <table class="table-custom">
            <thead>
                <tr>
                    <th style="width: 20%;">NOMBRE DE PAQUETS</th>
                    <th style="width: 50%;">PRODUIT / DESCRIPTION</th> {# --- Nouvelle Colonne --- #}
                    <th style="width: 30%;">EMPLACEMENT</th>
                </tr>
            </thead>
            <tbody>
                {% for ligne in fiche.lignes %}
                    <tr>
                        <td style="text-align: center; padding: 15px;">{{ ligne.nbPaquets }}</td>
                        {# --- Affichage de la description --- #}
                        <td style="padding: 15px; color: #555; font-style: italic;">
                            {{ ligne.description|default('Non précisé') }}
                        </td>
                        <td style="padding: 15px;">{{ ligne.emplacement.nom }}</td>
                    </tr>
                {% endfor %}
            </tbody>
            <tfoot>
                <tr>
                    <td class="sum-value">Total : {{ fiche.totalPaquets }} paquets</td>
                    <td class="sum-empty"></td> {# Vide pour la description #}
                    <td class="sum-empty"></td> {# Vide pour l'emplacement #}
                </tr>
            </tfoot>
        </table>
    </div>

    {# --- OBSERVATIONS --- #}
    {% if fiche.observations %}
        <div class="info-box mt-4">
            <label>Observations</label>
            <p>{{ fiche.observations|nl2br }}</p>
        </div>
    {% endif %}

    {# --- PHOTOS --- #}
    <div class="photo-section mt-4">
        <label>Photos du déchargement</label>
        <div class="photo-grid">
            {% for photo in fiche.photos %}
                <div class="photo-item">
                    <img src="{{ asset('uploads/fiches/' ~ photo.nomFichier) }}" 
                         alt="Photo déchargement" 
                         onclick="window.open(this.src)">
                </div>
            {% else %}
                <p class="no-data">Aucune photo jointe.</p>
            {% endfor %}
        </div>
    </div>

    {# --- ZONE D'ACTIONS EN BAS --- #}
    <div class="form-footer-actions">
        <a href="{{ path('app_reception_home', {'section': 'list-dechargement'}) }}" class="btn-secondary">
            <i class="fas fa-arrow-left"></i> Retour à la liste
        </a>

        {% if is_granted('ROLE_RECEPTION_TERRAIN') %}
            <a href="{{ path('app_bon_commande_new', {'ficheId': fiche.id}) }}" class="btn-create-bc-large">
                <i class="fas fa-file-invoice"></i> Créer le Bon de Commande (REFI)
            </a>
        {% endif %}
    </div>
</div>

<style>
    /* ... Tes styles existants ... */
    .info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 30px; }
    .info-box { background: #f8f9fa; padding: 15px; border-radius: 6px; border: 1px solid #eee; }
    .info-box label { display: block; font-size: 0.8rem; color: #888; text-transform: uppercase; margin-bottom: 5px; }
    .info-box p { margin: 0; font-size: 1.1rem; color: #333; }
    
    .photo-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 15px; margin-top: 10px; }
    .photo-item img { 
        width: 100%; height: 150px; object-fit: cover; border-radius: 6px; 
        cursor: pointer; border: 2px solid #eee; transition: 0.2s;
    }
    .photo-item img:hover { border-color: var(--primary-blue); transform: scale(1.02); }

    /* --- NOUVEAUX STYLES FOOTER --- */
    .form-footer-actions {
        margin-top: 50px;
        padding-top: 30px;
        border-top: 2px solid #f0f0f0;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .btn-secondary {
        color: #666;
        text-decoration: none;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .btn-create-bc-large {
        background-color: var(--primary-blue);
        color: white;
        text-decoration: none;
        padding: 15px 30px;
        border-radius: 8px;
        font-weight: 700;
        font-size: 1rem;
        display: flex;
        align-items: center;
        gap: 12px;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(46, 70, 166, 0.3);
    }

    .btn-create-bc-large:hover {
        background-color: #1e2e6e;
        transform: translateY(-3px);
        box-shadow: 0 8px 20px rgba(46, 70, 166, 0.4);
        color: white;
    }
    
    .mt-4 { margin-top: 1.5rem; }
</style>
{% endblock %}