{% extends 'base.html.twig' %}

{% block title %}Portail - SG Galva{% endblock %}

{% block body %}
<div class="portal-wrapper">
    <div class="portal-card">
        
        <div class="portal-icon">
            <i class="fas fa-user-circle"></i>
        </div>
        
        <h1>Bonjour, {{ app.user.prenom|default('Utilisateur') }} !</h1>
        <p>Vous êtes actuellement connecté(e) au système.</p>

        <div class="portal-actions">
            
            {# --- BOUTON DE REDIRECTION INTELLIGENT (S'adapte au rôle) --- #}
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_admin_home') }}" class="btn-portal btn-primary">
                    <i class="fas fa-cog"></i> Accéder à l'Administration
                </a>
            {% elseif is_granted('ROLE_COLISAGE') %}
                <a href="{{ path('app_colisage_home') }}" class="btn-portal btn-primary">
                    <i class="fas fa-box"></i> Retourner au Colisage
                </a>
            {% elseif is_granted('ROLE_CARISTE') %}
                <a href="{{ path('app_fiche_dechargement') }}" class="btn-portal btn-primary">
                    <i class="fas fa-truck-loading"></i> Retourner aux Déchargements
                </a>
            {% elseif is_granted('ROLE_RECEPTION_TERRAIN') %}
                <a href="{{ path('app_reception_terrain_home') }}" class="btn-portal btn-primary">
                    <i class="fas fa-clipboard-list"></i> Espace Réception Terrain
                </a>
            {% elseif is_granted('ROLE_RECEPTION_ORDONNANCEMENT') %}
                <a href="{{ path('app_reception_ordonnancement_home') }}" class="btn-portal btn-primary">
                    <i class="fas fa-desktop"></i> Espace Réception Bureau
                </a>
            {% elseif is_granted('ROLE_CHEF_EQUIPE') %}
                <a href="{{ path('app_chef_equipe_home') }}" class="btn-portal btn-primary">
                    <i class="fas fa-hard-hat"></i> Espace Atelier
                </a>
            {% else %}
                <p class="error-text">Aucun espace spécifique défini pour votre compte.</p>
            {% endif %}

            {# --- BOUTON DE DÉCONNEXION --- #}
            <a href="{{ path('app_logout') }}" class="btn-portal btn-danger">
                <i class="fas fa-sign-out-alt"></i> Me déconnecter
            </a>

        </div>
    </div>
</div>

<style>
    body { background-color: #f3f4f6; margin: 0; font-family: 'Inter', sans-serif; }
    
    .portal-wrapper {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

    .portal-card {
        background: #ffffff;
        padding: 40px 30px;
        border-radius: 16px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.05);
        text-align: center;
        max-width: 450px;
        width: 100%;
        border-top: 5px solid #4f46e5;
    }

    .portal-icon {
        font-size: 60px;
        color: #e5e7eb;
        margin-bottom: 15px;
    }

    .portal-card h1 {
        margin: 0 0 10px 0;
        font-size: 24px;
        color: #1f2937;
        font-weight: 800;
    }

    .portal-card p {
        color: #6b7280;
        font-size: 15px;
        margin-bottom: 30px;
    }

    .portal-actions {
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

    .btn-portal {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 16px;
        border-radius: 10px;
        font-size: 16px;
        font-weight: bold;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .btn-primary {
        background-color: #4f46e5;
        color: #ffffff;
        box-shadow: 0 4px 6px rgba(79, 70, 229, 0.2);
    }

    .btn-primary:hover {
        background-color: #4338ca;
        transform: translateY(-2px);
    }

    .btn-danger {
        background-color: #fff1f2;
        color: #e11d48;
        border: 2px solid #ffe4e6;
    }

    .btn-danger:hover {
        background-color: #ffe4e6;
        color: #be123c;
    }

    .error-text {
        color: #ef4444;
        font-weight: bold;
        background: #fee2e2;
        padding: 10px;
        border-radius: 8px;
    }
</style>
{% endblock %}