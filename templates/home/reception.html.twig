{% extends 'base.html.twig' %}

{% block title %}Portail Réception - SG Galva{% endblock %}

{% block body %}
<div class="dashboard-container">
    <aside class="sidebar">
        <div class="sidebar-top">
            <div class="sidebar-header">
                <div class="logo-box">SG</div>
                <span class="brand-name">Portail Galva</span>
            </div>

            <nav class="sidebar-nav">
                <a href="#" class="nav-item" data-target="list-dechargement">
                    <i class="far fa-file-alt"></i>
                    <span>Formulaire de déchargement</span>
                </a>
                <a href="#" class="nav-item" data-target="list-scans">
                    <i class="far fa-edit"></i>
                    <span>Scan des bon de commande</span>
                </a>
            </nav>
        </div>

        <div class="sidebar-footer">
            <a href="{{ path('app_logout') }}" class="logout-link">
                <i class="fas fa-sign-out-alt"></i>
                <span>Déconnexion</span>
            </a>
        </div>
    </aside>

    <main class="main-content">
        <div id="empty-state" class="empty-placeholder">
            <div class="dashed-container">
                <p>Sélectionnez un document dans le menu de gauche</p>
            </div>
        </div>

        <div id="content-area">
            {{ include('components/reception/_list_dechargement.html.twig') }}
            {{ include('components/reception/_list_scans.html.twig') }}
        </div>
    </main>
</div>

<style>
    :root {
        --sidebar-width: 260px;
        --primary-blue: #2e46a6;
        --text-gray: #6b7280;
        --bg-gray: #f9fafb;
        --border-color: #f3f4f6;
    }

    body, html { margin: 0; padding: 0; height: 100vh; font-family: 'Inter', -apple-system, sans-serif; background: white; }
    .dashboard-container { display: flex; height: 100vh; }

    /* Sidebar */
    .sidebar { 
        width: var(--sidebar-width); 
        border-right: 1px solid var(--border-color); 
        display: flex; 
        flex-direction: column; 
        justify-content: space-between;
        background: white;
    }
    .sidebar-header { display: flex; align-items: center; padding: 25px 20px; gap: 10px; }
    .logo-box { 
        background: var(--primary-blue); 
        color: white; 
        width: 32px; 
        height: 32px; 
        display: flex; 
        align-items: center; 
        justify-content: center; 
        border-radius: 6px; 
        font-weight: 800; 
        font-size: 13px; 
    }
    .brand-name { font-weight: 700; color: #111827; font-size: 15px; letter-spacing: -0.3px; }

    .nav-item { 
        display: flex; 
        align-items: flex-start; 
        gap: 12px; 
        padding: 12px 20px; 
        text-decoration: none; 
        color: #4b5563; 
        font-size: 13px; 
        line-height: 1.4;
        transition: 0.2s;
    }
    .nav-item i { margin-top: 3px; font-size: 14px; }
    .nav-item:hover { background: var(--bg-gray); }
    .nav-item.active { color: var(--primary-blue); font-weight: 500; }

    .sidebar-footer { padding: 15px 20px; border-top: 1px solid var(--border-color); }
    .logout-link { 
        color: #ef4444; 
        text-decoration: none; 
        display: flex; 
        align-items: center; 
        gap: 10px; 
        font-size: 13px; 
        font-weight: 500; 
    }

    /* Main Content */
    .main-content { 
        flex-grow: 1; 
        background: white; 
        padding: 20px; 
        display: flex; 
        flex-direction: column; 
    }
    
    .empty-placeholder { 
        flex-grow: 1; 
        display: flex; 
        padding: 10px; 
    }

    .dashed-container { 
        flex-grow: 1; 
        border: 2px dashed #e5e7eb; 
        border-radius: 12px; 
        display: flex; 
        align-items: center; 
        justify-content: center; 
        color: #9ca3af; 
        font-size: 14px;
        background: #fafafa;
    }

    /* Sections de listes */
    .content-section { display: none; padding: 20px; }
    .content-section.active { display: block; }
</style>

<script>
    function initReceptionDashboard() {
        const navItems = document.querySelectorAll('.nav-item');
        const emptyState = document.getElementById('empty-state');
        const sections = document.querySelectorAll('.content-section');

        console.log("Initialisation du dashboard :", navItems.length, "éléments trouvés");

        navItems.forEach(item => {
            const newItem = item.cloneNode(true);
            item.parentNode.replaceChild(newItem, item);

            newItem.addEventListener('click', function(e) {
                e.preventDefault();
                
                navItems.forEach(i => i.classList.remove('active')); 
                document.querySelectorAll('.nav-item').forEach(i => i.classList.remove('active'));
                this.classList.add('active');

                if(emptyState) emptyState.style.display = 'none';

                document.querySelectorAll('.content-section').forEach(s => {
                    s.classList.remove('active');
                    s.style.display = 'none';
                });

                const targetId = this.getAttribute('data-target');
                const targetSection = document.getElementById(targetId);
                
                if (targetSection) {
                    targetSection.classList.add('active');
                    targetSection.style.display = 'block';
                }
            });
        });
    }

    document.addEventListener('DOMContentLoaded', initReceptionDashboard);
    document.addEventListener('turbo:load', initReceptionDashboard);
</script>
{% endblock %}