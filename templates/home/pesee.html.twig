{% extends 'base.html.twig' %}

{% block title %}Pesée - SG Galva{% endblock %}

{% block body %}
<div class="dashboard-container">
    <aside class="sidebar">
        <div class="sidebar-top">
            <div class="sidebar-header">
                <div class="logo-box" style="background: var(--primary-blue);">PE</div>
                <span class="brand-name">Équipe Pesée</span>
            </div>

            <nav class="sidebar-nav">
                <a href="#" class="nav-item active" data-target="pesee-list" onclick="showSection('pesee-list', event)">
                    <i class="fas fa-weight-hanging"></i>
                    <span>Bons à Peser</span>
                </a>
                <a href="#" class="nav-item" data-target="pesee-urgence" onclick="showSection('pesee-urgence', event)">
                    <i class="fas fa-exclamation-triangle"></i>
                    <span>Déchargements d'Urgence</span>
                </a>
            </nav>
        </div>

        <div class="sidebar-footer">
            <a href="{{ path('app_logout') }}" class="logout-link">
                <i class="fas fa-sign-out-alt"></i>
                <span>Déconnexion</span>
            </a>
        </div>
    </aside>

    <main class="main-content">
        <header class="user-welcome-bar">
            <div class="welcome-message">
                Bonjour, <strong>{{ app.user.prenom|default('Opérateur Pesée') }}</strong>
            </div>
            <div class="current-date">
                <i class="far fa-calendar-alt"></i>
                {{ "now"|date('d/m/Y', 'Europe/Paris') }}
            </div>
        </header>

        <div id="content-area">
            <div id="pesee-list" class="content-section">
                
                {# On inclut ton nouveau composant ici ! #}
                {{ include('components/pesee/_list_planning.html.twig') }}

            </div>

            <div id="pesee-urgence" class="content-section" style="display: none;">
                {{ include('components/pesee/_list_urgence.html.twig') }}
            </div>
        </div>
    </main>
</div>

<script>
    function showSection(sectionId, event = null) {
        if (event) event.preventDefault();

        document.querySelectorAll('.content-section').forEach(sec => {
            sec.style.display = 'none';
            sec.classList.remove('active');
        });

        document.querySelectorAll('.nav-item').forEach(nav => {
            nav.classList.remove('active');
        });

        const target = document.getElementById(sectionId);
        if (target) {
            target.style.display = 'block';
            target.classList.add('active');
        }

        const nav = document.querySelector(`.nav-item[data-target="${sectionId}"]`);
        if (nav) nav.classList.add('active');
    }

    function initPeseeDashboard() {
        const urlParams = new URLSearchParams(window.location.search);
        const section = urlParams.get('section');
        
        if (section) {
            showSection(section);
        } else {
            showSection('pesee-list');
        }
    }

    document.addEventListener('turbo:load', initPeseeDashboard);
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initPeseeDashboard);
    } else {
        initPeseeDashboard();
    }
</script>

<style>
    :root {
        --sidebar-width: 260px;
        --primary-blue: #2e46a6;
        --primary-green: #10b981; 
        --primary-gold: #dcb35c;
        --text-gray: #6b7280;
        --bg-gray: #f9fafb;
        --border-color: #f3f4f6;
    }

    body, html { margin: 0; padding: 0; height: 100vh; font-family: 'Inter', sans-serif; background: white; }
    .dashboard-container { display: flex; height: 100vh; }

    /* Sidebar */
    .sidebar { 
        width: var(--sidebar-width); 
        border-right: 1px solid var(--border-color); 
        display: flex; flex-direction: column; justify-content: space-between; background: white;
    }
    .sidebar-header { display: flex; align-items: center; padding: 25px 20px; gap: 10px; }
    .logo-box { 
        color: white; width: 32px; height: 32px; 
        display: flex; align-items: center; justify-content: center; 
        border-radius: 6px; font-weight: 800; font-size: 13px; 
    }
    .brand-name { font-weight: 700; color: #111827; font-size: 15px; letter-spacing: -0.3px; }

    .nav-item { 
        display: flex; align-items: center; gap: 12px; padding: 12px 20px; 
        text-decoration: none; color: #4b5563; font-size: 13px; transition: 0.2s;
    }
    .nav-item i { font-size: 14px; width: 20px; text-align: center; }
    .nav-item:hover { background: var(--bg-gray); }
    
    .nav-item.active { 
        color: var(--primary-blue);
        font-weight: 600; 
        background: #eff6ff; 
        border-right: 3px solid var(--primary-blue); 
    }

    .sidebar-footer { padding: 15px 20px; border-top: 1px solid var(--border-color); }
    .logout-link { color: #ef4444; text-decoration: none; display: flex; align-items: center; gap: 10px; font-size: 13px; font-weight: 500; }

    /* Main Content */
    .main-content { flex-grow: 1; background: white; padding: 20px; display: flex; flex-direction: column; overflow-y: auto; }
    
    .user-welcome-bar {
        display: flex; justify-content: space-between; align-items: center;
        padding: 10px 20px 25px 20px; border-bottom: 1px solid var(--border-color); margin-bottom: 20px;
    }

    .welcome-message { font-size: 18px; color: #111827; }
    .welcome-message strong { color: var(--primary-blue); font-weight: 700; text-transform: capitalize; }

    .current-date {
        font-size: 13px; color: var(--text-gray); display: flex; align-items: center; gap: 8px;
        background: var(--bg-gray); padding: 6px 12px; border-radius: 20px; border: 1px solid var(--border-color);
    }

    .content-section { display: none; }
    .content-section.active { display: block; animation: fadeIn 0.3s ease; }

    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(5px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>
{% endblock %}