{% extends 'base.html.twig' %}

{% block title %}Administration - SG GALVA{% endblock %}

{% block body %}
<div class="dashboard-container">
    <aside class="sidebar">
        <div class="sidebar-top">
            <div class="sidebar-header">
                <div class="logo-box" style="background: var(--primary-admin);">AD</div>
                <span class="brand-name">Administrateur</span>
            </div>
            <nav class="sidebar-nav">
                <!-- Vue d'ensemble -->
                <a href="#" class="nav-item" data-target="admin-stats">
                    <i class="fas fa-chart-line"></i>
                    <span>Statistiques</span>
                </a>
                
                <div style="margin: 15px 20px 5px 20px; font-size: 11px; font-weight: 700; color: #9ca3af; text-transform: uppercase; letter-spacing: 0.5px;">Flux de Production</div>
                
                <a href="#" class="nav-item" data-target="admin-fd">
                    <i class="fas fa-clipboard-check"></i>
                    <span>Fiche de déchargement</span>
                </a>
                <a href="#" class="nav-item active" data-target="admin-bc">
                    <i class="fas fa-file-invoice"></i>
                    <span>Bon de commande</span>
                </a>
                <a href="#" class="nav-item" data-target="admin-bt">
                    <i class="fas fa-tools"></i>
                    <span>Bon de travail</span>
                </a>
                <a href="#" class="nav-item" data-target="admin-pl">
                    <i class="fas fa-calendar-alt"></i>
                    <span>Planning</span>
                </a>
                <a href="#" class="nav-item" data-target="admin-bl">
                    <i class="fas fa-truck"></i>
                    <span>Bon de livraison</span>
                </a>

                <div style="margin: 15px 20px 5px 20px; font-size: 11px; font-weight: 700; color: #9ca3af; text-transform: uppercase; letter-spacing: 0.5px;">Gestion</div>
                
                <a href="#" class="nav-item" data-target="admin-cl">
                    <i class="fas fa-building"></i>
                    <span>Clients</span>
                </a> 
                <a href="#" class="nav-item" data-target="admin-us">
                    <i class="fas fa-users"></i>
                    <span>Utilisateurs</span>
                </a>
                <a href="#" class="nav-item" data-target="admin-settings">
                    <i class="fas fa-cog"></i>
                    <span>Paramètres</span>
                </a>
            </nav>
        </div>

        <div class="sidebar-footer">
            <a href="{{ path('app_logout') }}" class="logout-link">
                <i class="fas fa-sign-out-alt"></i>
                <span>Déconnexion</span>
            </a>
        </div>
    </aside>

    <main class="main-content">
        <header class="user-welcome-bar">
            <div class="welcome-message">
                Bonjour, <strong>{{ app.user.prenom|default('Administrateur') }}</strong>
            </div>
            <div class="current-date">
                <i class="far fa-calendar-alt"></i>
                {{ "now"|date('d/m/Y', 'Europe/Paris') }}
            </div>
        </header>
        <div style="padding: 0 20px;">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div style="padding: 15px; border-radius: 8px; margin-bottom: 20px; font-weight: bold; display: flex; align-items: center; gap: 10px; 
                        {% if label == 'success' %}background-color: #dcfce7; color: #166534; border-left: 5px solid #22c55e;
                        {% elseif label == 'error' %}background-color: #fee2e2; color: #991b1b; border-left: 5px solid #ef4444;{% endif %}">
                        
                        <i class="fas {% if label == 'success' %}fa-check-circle{% else %}fa-exclamation-circle{% endif %}"></i>
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}
        </div>
        <div id="empty-state" class="empty-placeholder" style="display: none;">
            <div class="dashed-container">
                <p>Sélectionnez une catégorie dans le menu de gauche</p>
            </div>
        </div>

        <div id="content-area">
            
            <section id="admin-bc" class="content-section active">
                {{ include('components/admin/_list_bon_commande.html.twig') }}                
            </section>

            <section id="admin-fd" class="content-section">
                {{ include('components/admin/_list_fiche_dechargement.html.twig') }} 
            </section>

            <section id="admin-bt" class="content-section">
                {{ include('components/admin/_list_bon_travail.html.twig') }}
            </section>

            <section id="admin-pl" class="content-section">
                {{ include('components/admin/_list_planning.html.twig') }}
            </section>

            <section id="admin-cl" class="content-section">
                {{ include('components/admin/_list_client.html.twig') }}
            </section>

            <section id="admin-us" class="content-section">
                {{ include('components/admin/_list_user.html.twig') }}
            </section>

            <section id="admin-bl" class="content-section">
                {{ include('components/admin/_list_bon_livraison.html.twig') }}
            </section>

            <section id="admin-settings" class="content-section">
                <div style="background: white; border: 1px solid var(--border-color); border-radius: 8px; padding: 20px; max-width: 600px;">
                    <h2 style="margin-top: 0; font-size: 18px; color: #111827; border-bottom: 1px solid var(--border-color); padding-bottom: 10px;">Paramètres Système</h2>
                    <p style="color: var(--text-gray); font-size: 14px; margin-bottom: 20px;">Configuration globale de l'application.</p>
                    
                    <form action="{{ path('app_admin_settings_update') }}" method="POST">
                        <div style="margin-bottom: 25px;">
                            <label for="retention_jours" style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 5px;">Délai de conservation des photos (en jours)</label>
                            <input type="number" id="retention_jours" name="retention_jours" value="{{ retention_jours|default('30') }}" min="1" max="3650" style="width: 100%; padding: 8px 12px; border: 1px solid #d1d5db; border-radius: 6px; font-size: 14px;" oninput="updateMonthsIndicator(this.value)">
                            <p style="font-size: 12px; color: #6b7280; margin-top: 5px;">
                                Les photos de Fiches et Bons de Commande plus anciennes que ce délai seront automatiquement supprimées du serveur.<br>
                                <strong id="months_indicator" style="color: var(--primary-admin); font-size: 13px;">Soit environ 1 mois.</strong>
                            </p>
                        </div>

                        <div style="margin-bottom: 25px; padding-top: 20px; border-top: 1px solid var(--border-color);">
                            <label for="global_banner_message" style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 5px;">Bannière d'information globale</label>
                            <input type="text" id="global_banner_message" name="global_banner_message" value="{{ banner_message|default('') }}" placeholder="Ex: Rappel: Réunion sécurité à 16h..." style="width: 100%; padding: 8px 12px; border: 1px solid #d1d5db; border-radius: 6px; font-size: 14px;">
                            <p style="font-size: 12px; color: #6b7280; margin-top: 5px;">Ce texte s'affichera en haut de l'écran pour tous les utilisateurs. Laissez vide pour masquer la bannière.</p>
                        </div>

                        <button type="submit" style="background: var(--primary-admin); color: white; border: none; padding: 10px 16px; border-radius: 6px; font-weight: 600; cursor: pointer; transition: background 0.2s;" onmouseover="this.style.background='#4338ca'" onmouseout="this.style.background='var(--primary-admin)'"><i class="fas fa-save" style="margin-right: 8px;"></i>Enregistrer</button>
                    </form>
                </div>
            </section>

            <section id="admin-stats" class="content-section">
                {{ include('components/admin/_list_stats.html.twig') }}
            </section>
        </div>
    </main>
</div>

<script>
    function initAdminDashboard() {
        const navItems = document.querySelectorAll('.nav-item');
        const emptyState = document.getElementById('empty-state');
        const sections = document.querySelectorAll('.content-section');

        // Initialiser l'indicateur de mois
        const inputJours = document.getElementById('retention_jours');
        if (inputJours) updateMonthsIndicator(inputJours.value);

        function showSection(id) {            
            const target = document.getElementById(id);
            const nav = document.querySelector(`[data-target="${id}"]`);

            if (target && nav) {
                if (emptyState) emptyState.style.display = 'none';
                
                // 1. Cacher toutes les sections
                sections.forEach(s => { 
                    s.style.display = 'none'; 
                    s.classList.remove('active'); 
                });
                navItems.forEach(i => i.classList.remove('active'));

                // 2. Afficher la cible
                target.style.display = 'block';
                target.classList.add('active');
                nav.classList.add('active');

                // 3. Sauvegarde de l'onglet actif dans le cache du navigateur
                localStorage.setItem('adminLastTab', id);
            }
        }

        // Clic sur le menu
        navItems.forEach(item => {
            item.onclick = function(e) {
                e.preventDefault();
                showSection(this.getAttribute('data-target'));
            };
        });

        // Restauration du dernier onglet visité au rechargement de la page
        const urlParams = new URLSearchParams(window.location.search);
        const sectionParam = urlParams.get('section');
        const storedTab = localStorage.getItem('adminLastTab');

        if (sectionParam) {
            showSection(sectionParam);
            window.history.replaceState({}, document.title, window.location.pathname);
        } else if (storedTab) {
            showSection(storedTab);
        } else {
            showSection('admin-stats'); // Onglet par défaut
        }
    }

    // Gestion propre avec Symfony Turbo
    document.addEventListener('turbo:load', initAdminDashboard);
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initAdminDashboard);
    } else {
        initAdminDashboard();
    }

    function updateMonthsIndicator(days) {
        const indicator = document.getElementById('months_indicator');
        if (!indicator || !days) return;
        const months = Math.round((parseInt(days) / 30.41) * 10) / 10;
        if (months < 1) {
            indicator.innerText = "Soit moins d'un mois.";
        } else {
            indicator.innerText = `Soit environ ${months} mois.`;
        }
    }
</script>

<style>
    :root {
        --sidebar-width: 260px;
        --primary-admin: #4f46e5; /* Indigo : Couleur spécifique à l'admin */
        --text-gray: #6b7280;
        --bg-gray: #f9fafb;
        --border-color: #f3f4f6;
    }

    body, html { margin: 0; padding: 0; height: 100vh; font-family: 'Inter', sans-serif; background: white; }
    .dashboard-container { display: flex; height: 100vh; }

    /* Sidebar */
    .sidebar { 
        width: var(--sidebar-width); 
        border-right: 1px solid var(--border-color); 
        display: flex; flex-direction: column; justify-content: space-between; background: white;
    }
    .sidebar-header { display: flex; align-items: center; padding: 25px 20px; gap: 10px; }
    .logo-box { 
        color: white; width: 32px; height: 32px; 
        display: flex; align-items: center; justify-content: center; 
        border-radius: 6px; font-weight: 800; font-size: 13px; 
    }
    .brand-name { font-weight: 700; color: #111827; font-size: 15px; letter-spacing: -0.3px; }

    .nav-item { 
        display: flex; align-items: center; gap: 12px; padding: 12px 20px; 
        text-decoration: none; color: #4b5563; font-size: 13px; transition: 0.2s;
    }
    .nav-item i { font-size: 14px; width: 20px; text-align: center; }
    .nav-item:hover { background: var(--bg-gray); }
    
    .nav-item.active { 
        color: var(--primary-admin); 
        font-weight: 600; 
        background: #eef2ff; /* Fond légèrement teinté de la couleur admin */
        border-right: 3px solid var(--primary-admin); 
    }

    .sidebar-footer { padding: 15px 20px; border-top: 1px solid var(--border-color); }
    .logout-link { color: #ef4444; text-decoration: none; display: flex; align-items: center; gap: 10px; font-size: 13px; font-weight: 500; }

    /* Main Content */
    .main-content { flex-grow: 1; background: white; padding: 20px; display: flex; flex-direction: column; overflow-y: auto; }
    
    .user-welcome-bar {
        display: flex; justify-content: space-between; align-items: center;
        padding: 10px 20px 25px 20px; border-bottom: 1px solid var(--border-color); margin-bottom: 20px;
    }

    .welcome-message { font-size: 18px; color: #111827; }
    .welcome-message strong { color: var(--primary-admin); font-weight: 700; text-transform: capitalize; }

    .current-date {
        font-size: 13px; color: var(--text-gray); display: flex; align-items: center; gap: 8px;
        background: var(--bg-gray); padding: 6px 12px; border-radius: 20px; border: 1px solid var(--border-color);
    }

    .content-section { display: none; }
    .content-section.active { display: block; animation: fadeIn 0.3s ease; }

    /* Espaces réservés visuels en attendant tes composants */
    .placeholder-text {
        text-align: center;
        padding: 50px;
        color: #9ca3af;
        border: 2px dashed #e5e7eb;
        border-radius: 8px;
        background: #fafafa;
    }

    .empty-placeholder { flex-grow: 1; display: flex; padding: 10px; }
    .dashed-container { 
        flex-grow: 1; border: 2px dashed #e5e7eb; border-radius: 12px; 
        display: flex; align-items: center; justify-content: center; 
        color: #9ca3af; font-size: 14px; background: #fafafa;
    }

    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(5px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>
{% endblock %}