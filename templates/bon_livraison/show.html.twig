{% extends 'base.html.twig' %}

{% block title %}Bon de Livraison - {{ bl.numero }}{% endblock %}

{% block body %}
<div class="bc-wrapper">
    {{ form_start(form, {'attr': {'class': 'bc-paper', 'id': 'form-bl'}}) }}
    
    {% for message in app.flashes('success') %}
        <div style="background: #dcfce7; color: #166534; padding: 15px; margin-bottom: 20px; border-radius: 5px; border: 1px solid #bbf7d0; text-align: center; font-weight: bold;">
            <i class="fas fa-check-circle"></i> {{ message }}
        </div>
    {% endfor %}

    <div class="bc-header">
        <div class="bc-logo-container">
            <img src="{{ asset('images/sg-galva-logo.png') }}" alt="Logo" class="bc-logo">
        </div>
        <div class="bc-title-container">
            <h1>BON DE LIVRAISON</h1>
            <p style="text-align:center; color:#2e46a6; font-weight:bold; margin-top:5px;">Réf. Commande : {{ commande.refi }}</p>
        </div>
        <div class="bc-refi-container">
            <label>N° BL -</label>
            <input type="text" class="refi-input-ghost" value="{{ bl.numero }}" readonly>
            <div style="font-size: 12px; font-weight: normal; color: #666; margin-top: 5px;">
                (Issu du BT : {{ bt.numero }})
            </div>
        </div>
    </div>

    <div class="bc-top-grid" style="margin-bottom: 20px;">
        <div class="bc-box treatment-box" style="padding: 10px; border: 1px solid #ccc; background: #f9f9f9;">
            <p class="box-label" style="font-weight: bold; margin-bottom: 5px;">TRAITEMENT :</p>
            <div class="checkbox-group" style="display: flex; gap: 20px;">
                <label><input type="checkbox" {% if not commande.isCataphorese %}checked="checked"{% endif %} disabled> Galvanisation {% if commande.typeGalva and commande.typeGalva != 'CATA' %}- {{ commande.typeGalva }}{% endif %}</label>
                <label><input type="checkbox" {% if commande.isCataphorese %}checked="checked"{% endif %} disabled> Cataphorèse</label>
            </div>
        </div>
    </div>

    <div class="bc-middle-grid">
        <div class="bc-box client-box">
            <p class="box-label">ADRESSE DE FACTURATION</p>
            <div class="frame-content">
                <strong>{{ commande.fiche.client.nom }}</strong><br>
                {{ commande.fiche.client.adresseFacturation|nl2br }}<br>
                {{ commande.fiche.client.codePostal }} {{ commande.fiche.client.ville }}
            </div>
        </div>
        <div class="bc-box driver-box">
            <p class="box-label">ADRESSE DE LIVRAISON</p>
            <div class="frame-content">
                <strong>{{ commande.fiche.client.nom }}</strong><br>
                {{ commande.fiche.client.adresseLivraison|default(commande.fiche.client.adresseFacturation)|nl2br }}<br>
                {{ commande.fiche.client.codePostal }} {{ commande.fiche.client.ville }}
            </div>
        </div>
    </div>

    <div class="bc-box description-box table-wrapper">
        <p class="box-label">DÉTAILS DES MARCHANDISES LIVRÉES</p>
        <table class="bc-table mt-2">
            <thead>
                <tr>
                    <th width="8%" class="center">Qté</th>
                    <th width="25%">Désignation</th>
                    <th width="5%" class="center">U</th>
                    <th width="12%">Référence</th>
                    <th width="15%">Trav. Annexes</th>
                    <th width="10%" class="right">Poids (Kg)</th>
                    <th width="10%" class="center">Prix/T</th>
                    <th width="15%">Observations</th>
                </tr>
            </thead>
            <tbody>
                {% set totalPoids = 0 %}
                {% for ligne in bt.lignes %}
                    <tr>
                        <td class="center fw-bold text-blue">{{ ligne.nbPaquets }}</td>
                        <td class="designation">
                            <strong class="fw-bold">{{ ligne.description|default('-') }}</strong>
                            {% if ligne.emplacement or ligne.emplacementApresProduction %}
                                <div class="sub-info">Avant: {{ ligne.emplacement ? ligne.emplacement.nom : '-' }} | Après: {{ ligne.emplacementApresProduction ? ligne.emplacementApresProduction.nom : '-' }}</div>
                            {% endif %}
                        </td>
                        <td class="center">{{ ligne.u|default('-') }}</td>
                        <td>{{ ligne.reference|default('-') }}</td>
                        <td>{{ ligne.travauxAnnexes|default('-') }}</td>
                        
                        <td class="right fw-bold">{{ ligne.poids ? ligne.poids|number_format(2, ',', ' ') : '-' }}</td>
                        
                        <td class="center fw-bold text-green">
                            {{ ligne.prixTonne ? ligne.prixTonne|number_format(2, ',', ' ') ~ ' €' : '-' }}
                        </td>
                        
                        <td><span style="font-size: 11px; color: #64748b;">{{ ligne.observations|default('-') }}</span></td>
                    </tr>
                    {% set totalPoids = totalPoids + (ligne.poids|default(0)) %}
                {% else %}
                    <tr><td colspan="8" class="center muted py-3">Aucune marchandise trouvée.</td></tr>
                {% endfor %}
                
                {# Ligne du total #}
                <tr style="background-color: #f8faff; font-weight: bold; border-top: 2px solid #e2e8f0;">
                    <td colspan="5" style="text-align: right; padding-right: 15px; text-transform: uppercase; color: #64748b;">Total Poids (Kg) :</td>
                    <td style="text-align: right; color: #2e46a6; font-size: 14px;">{{ totalPoids|number_format(2, ',', ' ') }}</td>
                    <td colspan="2"></td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="bc-box">
        <p class="box-label">INFORMATIONS DE TRANSPORT ET ENLÈVEMENT</p>
        <div class="tech-grid" style="grid-template-columns: 1fr 1fr 1fr 1fr;">
            <div class="tech-col">
                <span class="label">DATE ENLÈVEMENT :</span>
                {{ form_widget(form.dateEnlevement) }}
            </div>
            <div class="tech-col">
                <span class="label">TRANSPORTEUR :</span>
                {{ form_widget(form.transporteur) }}
            </div>
            <div class="tech-col">
                <span class="label">CHAUFFEUR :</span>
                {{ form_widget(form.chauffeur) }}
            </div>
            <div class="tech-col">
                <span class="label">IMMATRICULATION :</span>
                {{ form_widget(form.immatriculation) }}
            </div>
        </div>

        {# Le champ caché qui contient la signature générée par Symfony #}
        {{ form_widget(form.signature) }}

        <div style="margin-top: 20px; border-top: 1px dashed #ccc; padding-top: 15px; text-align: center;">
            <span class="label" style="display:block; margin-bottom:10px;">SIGNATURE DU CHAUFFEUR :</span>
            
            {% if bl.signature %}
                <div id="existing-signature-container">
                    <img src="{{ bl.signature }}" alt="Signature Chauffeur" style="max-height: 120px; border-bottom: 2px solid #2e46a6; padding-bottom: 5px;">
                    <br>
                    <button type="button" id="btn-edit-signature" class="no-print" style="margin-top: 10px; background: #6b7280; color: white; border: none; padding: 6px 15px; border-radius: 4px; cursor: pointer; font-size: 12px;">
                        <i class="fas fa-pen"></i> Modifier la signature
                    </button>
                </div>
                
                <div id="canvas-container" style="display: none; position: relative;">
                    <canvas id="signature-pad" width="500" height="200" style="border: 2px solid #2e46a6; border-radius: 8px; background: #f8faff; cursor: crosshair; touch-action: none; display: inline-block;"></canvas>
                    <br>
                    <button type="button" id="clear-signature" style="margin-top: 5px; background: #e06e54; color: white; border: none; padding: 5px 15px; border-radius: 4px; cursor: pointer; font-size: 12px;">
                        <i class="fas fa-eraser"></i> Effacer
                    </button>
                    <button type="button" id="cancel-edit-signature" style="margin-top: 5px; background: #6b7280; color: white; border: none; padding: 5px 15px; border-radius: 4px; cursor: pointer; font-size: 12px; margin-left: 10px;">
                        Annuler
                    </button>
                </div>
            {% else %}
                <div id="canvas-container" style="display: inline-block; position: relative;">
                    <canvas id="signature-pad" width="500" height="200" style="border: 2px solid #2e46a6; border-radius: 8px; background: #f8faff; cursor: crosshair; touch-action: none;"></canvas>
                    <br>
                    <button type="button" id="clear-signature" style="margin-top: 5px; background: #e06e54; color: white; border: none; padding: 5px 15px; border-radius: 4px; cursor: pointer; font-size: 12px;">
                        <i class="fas fa-eraser"></i> Effacer
                    </button>
                </div>
            {% endif %}
        </div>
    </div>

    <div class="bc-box no-print">
        <p class="box-label">DOCUMENTS DU BON DE LIVRAISON (PHOTOS / PDF)</p>
        
        <div style="margin-bottom: 20px;">
            <label class="label">AJOUTER DES DOCUMENTS :</label>
            {{ form_widget(form.documentFiles, {'attr': {'class': 'form-control', 'style': 'margin-top: 5px;'}}) }}
        </div>

        {% if bl.documents|length > 0 %}
            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 15px;">
                {% for doc in bl.documents %}
                    {% set ext = doc.nomFichier|split('.')|last|lower %}
                    <div style="border: 1px solid #ccc; padding: 10px; border-radius: 5px; text-align: center; background: #fff; position: relative;" id="doc-{{ doc.id }}">
                        
                        <button type="button" class="btn-delete-doc" data-id="{{ doc.id }}" style="position: absolute; top: 5px; right: 5px; background: #e06e54; color: white; border: none; border-radius: 50%; width: 25px; height: 25px; cursor: pointer; display: flex; align-items: center; justify-content: center;">
                            <i class="fas fa-times"></i>
                        </button>

                        {% if ext == 'pdf' %}
                            <a href="{{ asset('uploads/bl/' ~ doc.nomFichier) }}" target="_blank" style="text-decoration: none; color: #2e46a6; display: block; padding-top: 15px;">
                                <i class="fas fa-file-pdf" style="font-size: 40px; color: #e06e54;"></i>
                                <div style="margin-top: 10px; font-size: 12px; word-break: break-all;">{{ doc.nomFichier }}</div>
                                <span style="font-size: 10px; color: #666; display: block; margin-top: 5px;">Cliquer pour ouvrir</span>
                            </a>
                        {% else %}
                            <a href="{{ asset('uploads/bl/' ~ doc.nomFichier) }}" target="_blank">
                                <img src="{{ asset('uploads/bl/' ~ doc.nomFichier) }}" style="max-width: 100%; max-height: 150px; object-fit: contain; border-radius: 4px;">
                            </a>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <p style="color: #666; font-size: 13px; font-style: italic;">Aucun document rattaché à ce Bon de Livraison.</p>
        {% endif %}
    </div>

    {% if commande.photos|length > 0 or commande.fiche.photos|length > 0 %}
        <div class="bc-box no-print">
            <p class="box-label">PHOTOS PRÉCÉDENTES (RÉCEPTION & BON DE COMMANDE)</p>
            
            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 15px;">
                
                {% for photo in commande.fiche.photos %}
                    <div style="border: 1px solid #ddd; padding: 5px; border-radius: 5px; text-align: center; background: #fafafa;">
                        <span style="font-size: 10px; color: #666; display: block; margin-bottom: 5px; font-weight: bold;">Réception</span>
                        <a href="{{ asset('uploads/fiches/' ~ photo.nomFichier) }}" target="_blank">
                            <img src="{{ asset('uploads/fiches/' ~ photo.nomFichier) }}" style="max-width: 100%; max-height: 120px; object-fit: contain; border-radius: 4px;">
                        </a>
                    </div>
                {% endfor %}

                {% for photo in commande.photos %}
                    <div style="border: 1px solid #ddd; padding: 5px; border-radius: 5px; text-align: center; background: #fafafa;">
                        <span style="font-size: 10px; color: #666; display: block; margin-bottom: 5px; font-weight: bold;">Bon de commande</span>
                        <a href="{{ asset('uploads/bons/' ~ photo.nomFichier) }}" target="_blank">
                            <img src="{{ asset('uploads/bons/' ~ photo.nomFichier) }}" style="max-width: 100%; max-height: 120px; object-fit: contain; border-radius: 4px;">
                        </a>
                    </div>
                {% endfor %}
            </div>
        </div>
    {% endif %}

    <div class="bc-actions no-print">
        <a href="{{ path('app_reception_ordonnancement_home', {'section': 'list-bons-livraison'}) }}" class="btn-cancel" style="background: #6b7280;">
            <i class="fas fa-arrow-left"></i> Retour Liste BL
        </a>
        <button type="button" class="btn-print" onclick="window.print()" style="background: #374151;">
            <i class="fas fa-print"></i> Imprimer
        </button>
        <button type="submit" class="btn-confirm" id="btn-save-bl">
            <i class="fas fa-check-circle"></i> ENREGISTRER LE BL
        </button>
    </div>

    {{ form_end(form) }}
</div>

<script>
    function initBLSignature() {
        const canvas = document.getElementById('signature-pad');
        if (!canvas || canvas.dataset.initialized) return;
        canvas.dataset.initialized = 'true';
        
        const ctx = canvas ? canvas.getContext('2d') : null;
        const form = document.getElementById('form-bl');
        const signatureInput = document.getElementById('bon_livraison_signature'); 
        
        const existingContainer = document.getElementById('existing-signature-container');
        const canvasContainer = document.getElementById('canvas-container');
        const btnEditSig = document.getElementById('btn-edit-signature');
        const btnCancelEdit = document.getElementById('cancel-edit-signature');
        const clearBtn = document.getElementById('clear-signature');

        let isDrawing = false;
        let isSignatureModified = false;

        if (btnEditSig) {
            btnEditSig.addEventListener('click', () => {
                existingContainer.style.display = 'none';
                canvasContainer.style.display = 'inline-block';
                isSignatureModified = true;
                signatureInput.value = ''; 
            });
        }

        if (btnCancelEdit) {
            btnCancelEdit.addEventListener('click', () => {
                existingContainer.style.display = 'block';
                canvasContainer.style.display = 'none';
                isSignatureModified = false;
                signatureInput.value = signatureInput.defaultValue; 
                if (ctx) ctx.clearRect(0, 0, canvas.width, canvas.height);
            });
        }

        if (canvas && ctx) {
            ctx.lineWidth = 3;
            ctx.lineCap = 'round';
            ctx.strokeStyle = '#000000';

            function startPosition(e) {
                isDrawing = true;
                ctx.beginPath();
                draw(e);
            }

            function endPosition() {
                isDrawing = false;
                ctx.beginPath();
            }

            function draw(e) {
                if (!isDrawing) return;
                
                const rect = canvas.getBoundingClientRect();
                let clientX, clientY;

                if (e.type.includes('touch')) {
                    e.preventDefault(); 
                    clientX = e.touches[0].clientX;
                    clientY = e.touches[0].clientY;
                } else {
                    clientX = e.clientX;
                    clientY = e.clientY;
                }

                ctx.lineTo(clientX - rect.left, clientY - rect.top);
                ctx.stroke();
                ctx.beginPath();
                ctx.moveTo(clientX - rect.left, clientY - rect.top);
            }

            canvas.addEventListener('mousedown', startPosition);
            canvas.addEventListener('mouseup', endPosition);
            canvas.addEventListener('mousemove', draw);
            canvas.addEventListener('mouseout', endPosition);

            canvas.addEventListener('touchstart', startPosition, { passive: false });
            canvas.addEventListener('touchend', endPosition);
            canvas.addEventListener('touchmove', draw, { passive: false });

            clearBtn.addEventListener('click', () => {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                signatureInput.value = ''; 
            });
        }

        form.addEventListener('submit', function(e) {
            if (canvas && canvasContainer.style.display !== 'none') {
                const blank = document.createElement('canvas');
                blank.width = canvas.width;
                blank.height = canvas.height;
                
                if (canvas.toDataURL() !== blank.toDataURL()) {
                    signatureInput.value = canvas.toDataURL('image/png');
                } else if (isSignatureModified) {
                    signatureInput.value = '';
                }
            }
        });

        document.querySelectorAll('.btn-delete-doc').forEach(btn => {
            btn.addEventListener('click', function() {
                if (confirm('Voulez-vous vraiment supprimer ce document ?')) {
                    const docId = this.dataset.id;
                    const container = document.getElementById('doc-' + docId);
                    
                    const url = "{{ path('app_livraison_document_delete', {'id': 'DOC_ID'}) }}".replace('DOC_ID', docId);
                    
                    fetch(url, {
                        method: 'POST',
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            container.remove();
                        } else {
                            alert(data.message || 'Une erreur est survenue.');
                        }
                    })
                    .catch(error => {
                        alert('Erreur réseau lors de la suppression.');
                    });
                }
            });
        });
    }

    // Initialisation
    document.addEventListener('turbo:load', initBLSignature);
    initBLSignature();
</script>

<style>
    /* Structure de base */
    .bc-wrapper { background: #f0f0f0; min-height: 100vh; padding: 40px 20px; font-family: Arial, sans-serif; color: #1a1a1a; }
    .bc-paper { max-width: 900px; margin: 0 auto; background: white; padding: 40px; box-shadow: 0 0 20px rgba(0,0,0,0.1); }
    .bc-box { border: 1px solid #ddd; padding: 15px; margin-bottom: 20px; position: relative; }
    
    /* En-tête */
    .bc-header { display: grid; grid-template-columns: 1fr 2fr 1.5fr; align-items: center; border-bottom: 2px solid #000; padding-bottom: 10px; margin-bottom: 20px; }
    .bc-logo { max-width: 120px; }
    .bc-title-container h1 { font-size: 22px; font-weight: 800; text-align: center; margin: 0; }
    .bc-refi-container { text-align: right; font-size: 20px; font-weight: bold; }
    .refi-input-ghost { border: none; font-weight: bold; font-size: 20px; width: 140px; text-align: right; outline: none; background: transparent; }
    
    /* Grilles d'infos */
    .bc-middle-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0; margin-bottom: 20px; }
    .box-label { font-weight: bold; font-size: 11px; color: #666; border-bottom: 1px solid #eee; padding-bottom: 5px; margin-bottom: 10px; text-transform: uppercase; }
    .tech-grid { display: grid; gap: 15px; }
    .label { font-weight: bold; font-size: 11px; text-transform: uppercase; margin-right: 5px; color: #444; }

    /* Inputs fantômes pour les formulaires de transporteur */
    .ghost-input { border: none; border-bottom: 1px dashed #2e46a6; outline: none; font-family: inherit; font-size: 13px; padding: 2px 0; background: transparent; width: 100%; }
    .ghost-input:focus { border-bottom: 1px solid #2e46a6; background: #f8faff; }

    /* --- NOUVEAUX STYLES DU TABLEAU MODERNE --- */
    .table-wrapper { padding: 0; border: 1px solid #e5e7eb; overflow: hidden; border-radius: 6px; }
    .bc-table { width: 100%; border-collapse: collapse; font-size: 13px; background: white; }
    
    .bc-table th { 
        background: #f8fafc; 
        border-bottom: 2px solid #e2e8f0; 
        padding: 10px 8px; 
        text-align: left; 
        font-size: 11px; 
        text-transform: uppercase; 
        color: #64748b;
        letter-spacing: 0.5px;
    }
    
    .bc-table td { 
        border-bottom: 1px solid #f1f5f9; 
        height: 40px; 
        vertical-align: middle; 
        padding: 0 8px;
        transition: background-color 0.2s;
    }
    
    .bc-table tbody tr:hover td {
        background-color: #f8fafc;
    }
    .bc-table tr:last-child td { border-bottom: none; }

    /* Utilitaires de texte */
    .center { text-align: center; } 
    .right { text-align: right; }
    .fw-bold { font-weight: 600; }
    .text-blue { color: #2e46a6; }
    .text-green { color: #10b981; }
    .muted { color: #94a3b8; }
    .sub-info { font-size: 10px; color: #64748b; margin-top: 2px; }

    /* Actions en bas */
    .bc-actions { display: flex; gap: 15px; margin-top: 30px; }
    .btn-cancel { flex: 1; color: white; padding: 15px; text-align: center; border-radius: 5px; text-decoration: none; font-weight: bold; display: flex; align-items: center; justify-content: center; gap: 8px; }
    .btn-confirm { flex: 2; background: #10b981; color: white; border: none; padding: 15px; border-radius: 5px; font-weight: bold; cursor: pointer; font-size: 16px; display: flex; align-items: center; justify-content: center; gap: 8px; transition: 0.2s; }
    .btn-confirm:hover { background: #059669; }
    .btn-print { flex: 1; color: white; border: none; padding: 15px 20px; border-radius: 5px; cursor: pointer; font-size: 16px; display: flex; align-items: center; justify-content: center; gap: 8px; }

    @media print {
        @page { margin: 0; }
        body { margin: 1.5cm; }
        .no-print { display: none !important; }
        .bc-wrapper { padding: 0; background: white; }
        .bc-paper { box-shadow: none; border: none; padding: 0; margin: 0; max-width: 100%; }
        .bc-box, .table-wrapper { border: 1px solid #000; }
        .ghost-input { border-bottom: none; }
    }
</style>
{% endblock %}