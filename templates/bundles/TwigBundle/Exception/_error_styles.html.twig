<style>
    body { background-color: #f3f4f6; margin: 0; font-family: 'Inter', sans-serif; }
    
    .error-wrapper {
        min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 20px;
    }

    .error-card {
        background: #ffffff; padding: 40px 30px; border-radius: 16px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.05); text-align: center;
        max-width: 450px; width: 100%; border-top: 5px solid #f59e0b;
    }

    .error-icon { font-size: 60px; margin-bottom: 15px; }
    .error-card h1 { margin: 0 0 10px 0; font-size: 24px; color: #1f2937; font-weight: 800; }
    .error-card p { color: #6b7280; font-size: 15px; margin-bottom: 30px; }

    .error-actions { display: flex; flex-direction: column; gap: 15px; }

    .btn-error {
        display: flex; align-items: center; justify-content: center; gap: 10px;
        padding: 16px; border-radius: 10px; font-size: 16px; font-weight: bold;
        text-decoration: none; transition: all 0.2s ease;
    }

    .btn-primary { background-color: #4f46e5; color: #ffffff; }
    .btn-primary:hover { background-color: #4338ca; transform: translateY(-2px); }

