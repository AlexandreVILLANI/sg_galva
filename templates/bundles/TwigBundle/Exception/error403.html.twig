{% extends 'base.html.twig' %}

{% block title %}Accès Refusé - SG Galva{% endblock %}

{% block body %}
<div class="error-wrapper">
    <div class="error-card" style="border-top-color: #ef4444;">
        <img src="{{ asset('images/sg-galva-logo.png') }}" alt="Logo SG Galva" class="error-logo">

        <div class="error-icon" style="color: #ef4444;">
            <i class="fas fa-lock"></i>
        </div>
        <h1>Accès Refusé (403)</h1>
        <p>Votre rôle actuel ne vous permet pas d'accéder à cet espace.</p>
        
        <div class="error-actions">
            <a href="{{ path('app_home') }}" class="btn-error btn-primary">
                <i class="fas fa-arrow-left"></i> Retour à mon espace
            </a>
        </div>
    </div>
</div>
{% include 'bundles/TwigBundle/Exception/_error_styles.html.twig' %}
{% endblock %}