{% extends 'base.html.twig' %}

{% block title %}Page introuvable - SG Galva{% endblock %}

{% block body %}
<div class="error-wrapper">
    <div class="error-card">
        <img src="{{ asset('images/sg-galva-logo.png') }}" alt="Logo SG Galva" class="error-logo">
        
        <div class="error-icon" style="color: #f59e0b;">
            <i class="fas fa-map-signs"></i>
        </div>
        <h1>Oups ! Page introuvable (404)</h1>
        <p>Le lien que vous avez suivi est cassé ou la page a été retirée.</p>
        
        <div class="error-actions">
            <a href="{{ path('app_home') }}" class="btn-error btn-primary">
                <i class="fas fa-home"></i> Retourner à l'accueil
            </a>
        </div>
    </div>
</div>
{% include 'bundles/TwigBundle/Exception/_error_styles.html.twig' %}
{% endblock %}