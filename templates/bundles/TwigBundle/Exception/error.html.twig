{% extends 'base.html.twig' %}

{% block title %}Erreur Système - SG Galva{% endblock %}

{% block body %}
<div class="error-wrapper">
    <div class="error-card" style="border-top-color: #6b7280;">
        <img src="{{ asset('images/sg-galva-logo.png') }}" alt="Logo SG Galva" class="error-logo">

        <div class="error-icon" style="color: #6b7280;">
            <i class="fas fa-tools"></i>
        </div>
        <h1>Erreur Système (500)</h1>
        <p>Une erreur inattendue s'est produite. Si le problème persiste, contactez l'administrateur.</p>
        
        <div class="error-actions">
            <a href="{{ path('app_home') }}" class="btn-error btn-primary">
                <i class="fas fa-home"></i> Retourner à l'accueil
            </a>
        </div>
    </div>
</div>
{% include 'bundles/TwigBundle/Exception/_error_styles.html.twig' %}
{% endblock %}