{% extends 'base.html.twig' %}

{% block title %}Modifier Client - SG Galva{% endblock %}

{% block body %}
<div class="admin-form-container">
    <div class="form-card large">
        <header class="form-card-header">
            <a href="{{ path('app_admin_home', {'section': 'admin-cl'}) }}" class="btn-back">
                <i class="fas fa-arrow-left"></i> Retour
            </a>
            <h1>Modifier le client : <span style="color: var(--primary-admin);">{{ client.nom }}</span></h1>
        </header>

        {{ form_start(form, {'attr': {'class': 'modern-form'}}) }}
            
            <div class="form-block">
                <h3 class="block-title"><i class="fas fa-id-card"></i> Identité & Contact</h3>
                <div class="form-grid">
                    <div class="full-width">{{ form_row(form.nom) }}</div>
                    <div>{{ form_row(form.abrege) }}</div>
                    <div>{{ form_row(form.refInterne) }}</div>
                    <div>{{ form_row(form.contact) }}</div>
                    <div>{{ form_row(form.email) }}</div>
                    <div>{{ form_row(form.telephone) }}</div>
                    <div>{{ form_row(form.fax) }}</div>
                </div>
            </div>

            <div class="form-block">
                <h3 class="block-title"><i class="fas fa-map-marker-alt"></i> Localisation</h3>
                <div class="form-grid">
                    <div class="full-width">{{ form_row(form.adresse_facturation) }}</div>
                    <div class="full-width">{{ form_row(form.adresse_livraison) }}</div>
                    <div>{{ form_row(form.codePostal) }}</div>
                    <div>{{ form_row(form.ville) }}</div>
                    <div>{{ form_row(form.pays) }}</div>
                </div>
            </div>

            <div class="form-block">
                <h3 class="block-title"><i class="fas fa-file-invoice-dollar"></i> Administratif & Alertes</h3>
                <div class="form-grid">
                    <div>{{ form_row(form.siret) }}</div>
                    <div>{{ form_row(form.tvaIntra) }}</div>
                    <div>{{ form_row(form.categorieComptable) }}</div>
                    <div>{{ form_row(form.encoursAutorise) }}</div>
                    <div>{{ form_row(form.portefeuilleBlFa) }}</div>
                    <div>{{ form_row(form.payeur) }}</div>
                    <div>{{ form_row(form.assuranceCredit) }}</div>
                    
                    <div class="full-width">{{ form_row(form.messageAlerte) }}</div>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-submit">
                    <i class="fas fa-save"></i> Enregistrer les modifications
                </button>
            </div>
        {{ form_end(form) }}
    </div>
</div>

<style>
    :root { --primary-admin: #4f46e5; }
    .admin-form-container { padding: 20px; background: #f3f4f6; min-height: 100vh; display: flex; justify-content: center; }
    .form-card.large { max-width: 1000px; width: 100%; background: white; padding: 40px; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); }
    
    .form-card-header { display: flex; align-items: center; gap: 20px; margin-bottom: 30px; }
    .form-card-header h1 { font-size: 1.6rem; color: #111827; margin: 0; }

    .form-block { background: #fafafa; border: 1px solid #eee; padding: 25px; border-radius: 10px; margin-bottom: 30px; }
    .block-title { margin-top: 0; margin-bottom: 20px; font-size: 1.1rem; color: var(--primary-admin); border-bottom: 2px solid #eef2ff; padding-bottom: 10px; display: flex; align-items: center; gap: 10px; }

    .form-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px 25px; }
    .full-width { grid-column: 1 / -1; }

    label { display: block; font-size: 0.85rem; font-weight: 600; color: #4b5563; margin-bottom: 6px; }
    input, textarea { width: 100%; padding: 10px 12px; border: 1px solid #d1d5db; border-radius: 6px; font-size: 0.9rem; box-sizing: border-box; }
    input:focus, textarea:focus { border-color: var(--primary-admin); outline: none; ring: 2px rgba(79, 70, 229, 0.2); }

    .form-actions { text-align: right; margin-top: 20px; }
    .btn-submit { background: var(--primary-admin); color: white; border: none; padding: 15px 35px; border-radius: 8px; font-weight: 700; cursor: pointer; font-size: 1rem; transition: 0.2s; }
    .btn-submit:hover { background: #4338ca; transform: translateY(-2px); }
</style>
{% endblock %}