{% extends 'base.html.twig' %}

{% block title %}Nouveau Compte - Admin{% endblock %}

{% block body %}
<div class="admin-wrapper" style="max-width: 600px; margin: 40px auto; padding: 20px;">
    
    <div style="margin-bottom: 20px;">
        <a href="{{ path('app_admin_home', {'section': 'admin-us'}) }}" style="color: #6b7280; text-decoration: none; font-weight: bold;">
            <i class="fas fa-arrow-left"></i> Retour à la liste
        </a>
    </div>

    <div style="background: white; padding: 30px; border-radius: 12px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); border-top: 5px solid #10b981;">
        <h1 style="margin-top: 0; font-size: 24px; color: #1f2937;">
            <i class="fas fa-user-plus" style="color: #10b981;"></i> Créer un compte
        </h1>
        <p style="color: #6b7280; margin-bottom: 25px;">Ajoutez un nouveau collaborateur au système.</p>

        {{ form_start(form) }}
            
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 20px;">
                <div>
                    {{ form_label(form.username, null, {'label_attr': {'style': 'font-weight: bold; color: #374151; display: block; margin-bottom: 5px;'}}) }}
                    {{ form_widget(form.username, {'attr': {'style': 'width: 100%; padding: 10px; border: 1px solid #d1d5db; border-radius: 6px; font-size: 15px;'}}) }}
                </div>
                <div>
                    {{ form_label(form.prenom, null, {'label_attr': {'style': 'font-weight: bold; color: #374151; display: block; margin-bottom: 5px;'}}) }}
                    {{ form_widget(form.prenom, {'attr': {'style': 'width: 100%; padding: 10px; border: 1px solid #d1d5db; border-radius: 6px; font-size: 15px;'}}) }}
                </div>
            </div>

            <div style="margin-bottom: 20px;">
                {{ form_label(form.password, null, {'label_attr': {'style': 'font-weight: bold; color: #374151; display: block; margin-bottom: 5px;'}}) }}
                {{ form_widget(form.password, {'attr': {'style': 'width: 100%; padding: 10px; border: 1px solid #d1d5db; border-radius: 6px; font-size: 15px;'}}) }}
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 30px;">
                <div>
                    {{ form_label(form.userRole, null, {'label_attr': {'style': 'font-weight: bold; color: #374151; display: block; margin-bottom: 5px;'}}) }}
                    {{ form_widget(form.userRole, {'attr': {'style': 'width: 100%; padding: 10px; border: 1px solid #d1d5db; border-radius: 6px; font-size: 15px; background-color: #f9fafb;'}}) }}
                </div>
                <div>
                    {{ form_label(form.typeAcces, null, {'label_attr': {'style': 'font-weight: bold; color: #374151; display: block; margin-bottom: 5px;'}}) }}
                    {{ form_widget(form.typeAcces, {'attr': {'style': 'width: 100%; padding: 10px; border: 1px solid #d1d5db; border-radius: 6px; font-size: 15px; background-color: #f9fafb;'}}) }}
                </div>
            </div>

            <button type="submit" style="width: 100%; background: #10b981; color: white; border: none; padding: 15px; border-radius: 8px; font-weight: bold; font-size: 16px; cursor: pointer;">
                <i class="fas fa-check"></i> Créer l'utilisateur
            </button>

        {{ form_end(form) }}
    </div>
</div>
{% endblock %}