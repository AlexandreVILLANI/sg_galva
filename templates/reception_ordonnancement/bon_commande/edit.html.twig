{% extends 'base.html.twig' %}

{% block title %}Ordonnancement - REFI {{ bon.refi }}<script>
    function applyBcGalvaLogic() {
        const checkGalva = document.getElementById("bon_de_commande_isGalvanisation") || document.querySelector('input[name="bon_de_commande[isGalvanisation]"]');
        const checkCata = document.getElementById("bon_de_commande_isCataphorese") || document.querySelector('input[name="bon_de_commande[isCataphorese]"]');
        const selectType = document.getElementById("bon_de_commande_typeGalva") || document.querySelector('select[name="bon_de_commande[typeGalva]"]');

        if (checkGalva && checkCata && selectType) {
            const allOptions = Array.from(selectType.options).map(opt => ({
                value: opt.value,
                text: opt.text,
                selected: opt.selected
            }));

            function updateSelect() {
                const currentValue = selectType.value;
                selectType.innerHTML = '';

                let allowedValues = [];
                if (checkGalva.checked) {
                    allowedValues.push('GB (Grand Bain)', 'PB (Petit Bain)', 'Mixte (GB + PB)', 'GB', 'PB', 'Mixte');
                }
                if (checkCata.checked) {
                    allowedValues.push('Cataphorèse', 'CATA');
                }
                if (!checkGalva.checked && !checkCata.checked) {
                    allowedValues = allOptions.map(o => o.value);
                }

                allOptions.forEach(opt => {
                    if (allowedValues.includes(opt.value) || allowedValues.includes(opt.text)) {
                        const newOpt = document.createElement('option');
                        newOpt.value = opt.value;
                        newOpt.text = opt.text;
                        if (opt.value === currentValue) {
                            newOpt.selected = true;
                        }
                        selectType.appendChild(newOpt);
                    }
                });
            }

            checkGalva.addEventListener('change', function(e) {
                if (this.checked) {
                    checkCata.checked = false;
                } else if (!checkCata.checked) {
                    this.checked = true;
                }
                updateSelect();
            });

            checkCata.addEventListener('change', function(e) {
                if (this.checked) {
                    checkGalva.checked = false;
                } else if (!checkGalva.checked) {
                    this.checked = true;
                }
                updateSelect();
            });

            if (checkGalva.checked && checkCata.checked) {
                checkCata.checked = false;
            } else if (!checkGalva.checked && !checkCata.checked) {
                checkGalva.checked = true;
            }
            
            updateSelect();
        }
    }
    
    // Execute immediately
    applyBcGalvaLogic();
</script>
{% endblock %}

{% block body %}
<div class="dashboard-container">
    <main class="main-content">
        {# --- FORMULAIRE --- #}
        <div class="bc-wrapper" style="padding: 0;">
            {{ form_start(form, {'attr': {'class': 'bc-paper'}}) }}
                
                {# --- ENTÊTE --- #}
                <div class="bc-header">
                    <div class="bc-logo-container">
                        <img src="{{ asset('images/sg-galva-logo.png') }}" alt="Logo" class="bc-logo">
                    </div>
                    <div class="bc-title-container">
                        <h1>BON DE COMMANDE <br><small style="font-size: 14px; color: #666;">(Validation Ordonnancement)</small></h1>
                    </div>
                    <div class="bc-refi-container">
                        <label>REFI -</label>
                        <div style="display: inline-flex; align-items: center;">
                            {{ form_widget(form.refi, {'attr': {'class': 'refi-input-ghost', 'readonly': 'readonly'}}) }}
                            {# Bouton Copier REFI #}
                            <button type="button" class="btn-copy no-print" onclick="copyFromInput('{{ form.refi.vars.id }}', this)" title="Copier le REFI">
                                <i class="far fa-copy"></i>
                            </button>
                        </div>
                    </div>
                </div>

                {# --- GRILLE TECHNIQUE --- #}
                <div class="bc-top-grid">
                    <div class="bc-box treatment-box">
                        <p class="box-label">TRAITEMENT :</p>
                        <div class="checkbox-group">
                            <label>{{ form_widget(form.isGalvanisation) }} (Galvanisation)</label>
                            <label>{{ form_widget(form.isCataphorese) }} (Cataphorèse)</label>
                        </div>
                    </div>
                    <div class="bc-box summary-box">
                        <div class="summary-line">
                            <span>Forfait :</span> 
                            <div class="flex-copy">
                                <strong>{{ form_widget(form.forfait) }}</strong>
                                <button type="button" class="btn-copy no-print" onclick="copyFromInput('{{ form.forfait.vars.id }}', this)"><i class="far fa-copy"></i></button>
                            </div>
                        </div>
                        <div class="summary-line">
                            <span>Nb PAQ :</span> 
                            <strong class="val-readonly">{{ fiche.totalPaquets|default(0) }}</strong> 
                        </div>
                        <div class="summary-line">
                            <span>Stockage :</span> 
                            <strong>{{ form_widget(form.stockage) }}</strong>
                        </div>
                        <div class="summary-line">
                            <span>GALVA :</span> 
                            <strong>{{ form_widget(form.typeGalva) }}</strong>
                        </div>
                    </div>
                </div>

                {# --- INFOS CLIENT / CHAUFFEUR --- #}
                <div class="bc-middle-grid">
                    <div class="bc-box client-box">
                        <div class="field flex-copy-row">
                            <span class="label">SOCIETE :</span> 
                            <span class="val">{{ bon.client.nom }}</span>
                            <button type="button" class="btn-copy no-print" onclick="copyText('{{ bon.client.nom|e('js') }}', this)"><i class="far fa-copy"></i></button>
                        </div>
                        <div class="field flex-copy-row">
                            <span class="label">Adresse :</span> 
                            <span class="val">{{ bon.client.adresseFacturation|default(bon.client.adresseLivraison) }}</span>
                            <button type="button" class="btn-copy no-print" onclick="copyText('{{ bon.client.adresseFacturation|default(bon.client.adresseLivraison)|e('js') }}', this)"><i class="far fa-copy"></i></button>
                        </div>
                        <div class="field">
                            <span class="label">Date :</span> 
                            <span class="val">{{ bon.date|date('d/m/Y H:i', 'Europe/Paris') }}</span>
                        </div>
                    </div>
                    <div class="bc-box driver-box">
                        <div class="field">
                            <span class="label">Nom du chauffeur :</span> 
                            <div class="flex-copy">
                                {{ form_widget(form.nomChauffeur) }}
                                <button type="button" class="btn-copy no-print" onclick="copyFromInput('{{ form.nomChauffeur.vars.id }}', this)"><i class="far fa-copy"></i></button>
                            </div>
                        </div>
                        <div class="field flex-copy-row">
                            <span class="label">Tél :</span> 
                            <span class="val">{{ bon.client.telephone|default('(Non renseigné)') }}</span>
                            {% if bon.client.telephone %}
                                <button type="button" class="btn-copy no-print" onclick="copyText('{{ bon.client.telephone|e('js') }}', this)"><i class="far fa-copy"></i></button>
                            {% endif %}
                        </div>
                        <div class="field flex-copy-row">
                            <span class="label">Fax :</span> 
                            <span class="val">{{ bon.client.fax|default('(Non renseigné)') }}</span>
                            {% if bon.client.fax %}
                                <button type="button" class="btn-copy no-print" onclick="copyText('{{ bon.client.fax|e('js') }}', this)"><i class="far fa-copy"></i></button>
                            {% endif %}
                        </div>
                    </div>
                </div>

                {# --- DÉTAILS DÉCHARGEMENT --- #}
                <div class="bc-box description-box">
                    <p><strong>DÉTAILS DU DÉCHARGEMENT</strong></p>
                    <ul class="bc-tech-list">
                        {% for ligne in fiche.lignes|default([]) %}
                            <li>
                                <strong>{{ ligne.nbPaquets }}</strong> Paquet{{ ligne.nbPaquets > 1 ? 's' : '' }} 
                                de <strong>{{ ligne.description|default('(Produit non précisé)') }}</strong>
                                — Situé en : <strong>{{ ligne.emplacement.nom }}</strong>
                            </li>
                        {% else %}
                            <li>Aucun détail disponible.</li>
                        {% endfor %}
                    </ul>
                </div>

                {# --- OBSERVATIONS --- #}
                <div class="bc-box comment-box">
                    <div class="flex-copy-row" style="margin-bottom: 5px;">
                        <span class="label">Commentaires / Observations finales :</span>
                        <button type="button" class="btn-copy no-print" onclick="copyFromInput('{{ form.commentaire.vars.id }}', this)" title="Copier le commentaire"><i class="far fa-copy"></i></button>
                    </div>
                    <div>
                        {{ form_widget(form.commentaire, {'attr': {'placeholder': 'Saisir ici les instructions pour la production...', 'rows': '3'}}) }}
                    </div>
                </div>

                {# --- SECTION PHOTOS --- #}
                <div class="photo-section mt-4">
                    <div class="bc-box">
                        <label class="label"><i class="fas fa-camera"></i> Photos du dossier</label>
                        <div class="photo-grid">
                            {% for photo in fiche.photos|default([]) %}
                                <div class="photo-item archive-item">
                                    <img src="{{ asset('uploads/fiches/' ~ photo.nomFichier) }}" onclick="window.open(this.src)">
                                    <small class="photo-tag">Cariste</small>
                                </div>
                            {% endfor %}
                            {% for photo in bon.photos %}
                                <div class="photo-item">
                                    <img src="{{ asset('uploads/bons/' ~ photo.nomFichier) }}" onclick="window.open(this.src)">
                                    <small class="photo-tag" style="background: #2e46a6;">BC</small>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>

                {# --- ACTIONS --- #}
                <div class="bc-actions no-print">
                    {# 1. Annuler #}
                    <a href="{{ path('app_reception_ordonnancement_home') }}" class="btn-cancel">
                        <i class="fas fa-times"></i> Annuler
                    </a>
                    
                    {# 2. CRÉER BON DE TRAVAIL (Nouveau Bouton) #}
                    {% if form.vars.value.id %}
                        <a href="{{ path('app_bon_travail_new', {'id': form.vars.value.id}) }}" class="btn-bt">
                            <i class="fas fa-tools"></i> CRÉER BON DE TRAVAIL
                        </a>
                    {% endif %}

                    {# 3. Valider #}
                    <button type="submit" class="btn-save-ordo">
                        <i class="fas fa-check-circle"></i> VALIDER L'ORDONNANCEMENT
                    </button>
                </div>

                {% do form.imageFiles.setRendered %}
                
                <div style="display: none;">
                    {{ form_widget(form.lignes) }}
                </div>

                {{ form_rest(form) }}
            {{ form_end(form) }}
        </div>
    </main>
</div>

{# --- SCRIPT DE COPIE --- #}
<script>
    function copyText(text, btnElement) {
        navigator.clipboard.writeText(text).then(() => { showSuccess(btnElement); }).catch(err => { console.error('Erreur copie :', err); });
    }
    function copyFromInput(inputId, btnElement) {
        const input = document.getElementById(inputId);
        if(input) {
            navigator.clipboard.writeText(input.value).then(() => { showSuccess(btnElement); });
        }
    function showSuccess(btn) {
        const originalIcon = btn.innerHTML;
        btn.innerHTML = '<i class="fas fa-check"></i>';
        btn.classList.add('copy-success');
        setTimeout(() => {
            btn.innerHTML = originalIcon;
            btn.classList.remove('copy-success');
        }, 1500);
    }

    document.addEventListener('DOMContentLoaded', function() {
        const checkGalva = document.getElementById('{{ form.isGalvanisation.vars.id }}');
        const checkCata = document.getElementById('{{ form.isCataphorese.vars.id }}');
        const selectType = document.getElementById('{{ form.typeGalva.vars.id }}');

        if (checkGalva && checkCata && selectType) {
            // Save original options
            const allOptions = Array.from(selectType.options).map(opt => ({
                value: opt.value,
                text: opt.text,
                selected: opt.selected
            }));

            function updateSelect() {
                const currentValue = selectType.value;
                selectType.innerHTML = '';

                let allowedValues = [];
                
                if (checkGalva.checked) {
                    allowedValues.push('GB', 'PB', 'Mixte');
                }
                if (checkCata.checked) {
                    allowedValues.push('Cataphorèse');
                }
                
                if (!checkGalva.checked && !checkCata.checked) {
                    // This shouldn't happen anymore, but just in case
                    allowedValues = allOptions.map(o => o.value);
                }

                allOptions.forEach(opt => {
                    if (allowedValues.includes(opt.value)) {
                        const newOpt = document.createElement('option');
                        newOpt.value = opt.value;
                        newOpt.text = opt.text;
                        if (opt.value === currentValue) {
                            newOpt.selected = true;
                        }
                        selectType.appendChild(newOpt);
                    }
                });
            }

            // Enforce mutual exclusivity and at least one checked
            checkGalva.addEventListener('change', function(e) {
                if (this.checked) {
                    checkCata.checked = false;
                } else if (!checkCata.checked) {
                    this.checked = true; // Prevent unchecking if it's the last one
                }
                updateSelect();
            });

            checkCata.addEventListener('change', function(e) {
                if (this.checked) {
                    checkGalva.checked = false;
                } else if (!checkGalva.checked) {
                    this.checked = true; // Prevent unchecking if it's the last one
                }
                updateSelect();
            });

            // Initial setup: ensure one is checked
            if (checkGalva.checked && checkCata.checked) {
                checkCata.checked = false;
            } else if (!checkGalva.checked && !checkCata.checked) {
                checkGalva.checked = true;
            }
            
            updateSelect();
        }
    });
</script>

