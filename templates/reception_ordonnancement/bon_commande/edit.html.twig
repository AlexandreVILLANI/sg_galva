    .bc-refi-container { text-align: right; font-size: 20px; font-weight: bold; }
    .bc-refi-container input { border: none; font-weight: bold; font-size: 20px; width: 140px; text-align: right; outline: none; background: transparent; }

    .bc-top-grid, .bc-middle-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0; }
    .summary-line { display: flex; justify-content: space-between; border-bottom: 1px solid #f0f0f0; padding: 3px 0; font-size: 13px; align-items: center; }
    .label { font-weight: bold; font-size: 12px; text-transform: uppercase; margin-right: 5px; color: #666; }
    .field { margin-bottom: 15px; }

    .driver-box input, .summary-box select, .comment-box textarea { border: none; border-bottom: 1px dashed #2e46a6; background: transparent; outline: none; font-family: inherit; }
    .comment-box textarea { width: 100%; font-size: 15px; padding: 10px 0; resize: vertical; }

    .bc-actions { display: flex; gap: 20px; margin-top: 30px; align-items: stretch; }
    
    .btn-cancel { flex: 0.5; background: var(--danger-red); color: white; padding: 15px; text-align: center; border-radius: 5px; text-decoration: none; font-weight: bold; display: flex; align-items: center; justify-content: center; gap: 8px; }
    
    .btn-bt { 
        flex: 1.5; 
        background: #dcb35c; 
        color: white; 
        text-align: center; 
        border-radius: 5px; 
        text-decoration: none; 
        font-weight: bold; 
        display: flex; 
        align-items: center; 
        justify-content: center; 
        gap: 10px;
        transition: 0.2s;
        border: 2px solid #c9a24d;
    }
    .btn-bt:hover { background: #c9a24d; transform: translateY(-2px); box-shadow: 0 4px 8px rgba(0,0,0,0.15); }

    .btn-save-ordo { flex: 2; background: var(--success-green); color: white; border: none; padding: 15px; border-radius: 5px; font-weight: bold; cursor: pointer; font-size: 16px; transition: 0.3s; display: flex; align-items: center; justify-content: center; gap: 8px; }
    .btn-save-ordo:hover { background: #059669; transform: translateY(-2px); }

    /* GRILLE PHOTOS */
    .photo-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 15px; }
    .photo-item { position: relative; height: 140px; border-radius: 6px; border: 2px solid #eee; overflow: hidden; }
    .photo-item img { width: 100%; height: 100%; object-fit: cover; cursor: pointer; }
    .archive-item img { filter: contrast(0.8) grayscale(20%); }
    .photo-tag { position: absolute; bottom: 5px; left: 5px; background: rgba(0,0,0,0.6); color: white; padding: 2px 6px; border-radius: 3px; font-size: 9px; text-transform: uppercase; }

    @media print { 
        .no-print, .user-welcome-bar, .sidebar { display: none !important; } 
        .main-content { padding: 0 !important; margin: 0 !important; }
        .bc-wrapper { padding: 0; background: white; } 
        .bc-paper { box-shadow: none; border: none; margin: 0; max-width: 100%; padding: 0; } 
    }
</style>
