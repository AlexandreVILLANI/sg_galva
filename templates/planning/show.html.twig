{% extends 'base.html.twig' %}

{% block title %}Consultation Planning - {{ planning.datePlanning|date('d/m/Y') }}{% endblock %}

{% block body %}
<div class="bc-wrapper">
    <div class="bc-paper">
        
        {# --- ENTÊTE --- #}
        <div class="bc-header">
            <div class="bc-logo-container">
                <img src="{{ asset('images/sg-galva-logo.png') }}" alt="Logo" class="bc-logo">
            </div>
            <div class="bc-title-container">
                <h1>FEUILLE DE PLANNING</h1>
                <p class="subtitle" style="color: var(--primary-blue);">CONSULTATION - ÉQUIPE PESÉE</p>
            </div>
            <div class="bc-refi-container">
                <div class="date-box">
                    <small>PLANNING DU</small>
                    <span class="value">{{ planning.datePlanning|date('d/m/Y') }}</span>
                </div>
            </div>
        </div>

        {# --- CALCUL DES STATISTIQUES (PESÉE) --- #}
        {% set peseeFaite = 0 %}
        {% set peseeAfaire = 0 %}

        {% for ligne in planning.lignes %}
            {% set btComplet = false %}
            {% if ligne.bonTravail and ligne.bonTravail.lignes|length > 0 %}
                {% set btComplet = true %}
                {% for ligneBT in ligne.bonTravail.lignes %}
                    {% if ligneBT.poids is null or ligneBT.poids <= 0 %}
                        {% set btComplet = false %}
                    {% endif %}
                {% endfor %}
            {% endif %}

            {% if btComplet %}
                {% set peseeFaite = peseeFaite + 1 %}
            {% else %}
                {% set peseeAfaire = peseeAfaire + 1 %}
            {% endif %}
        {% endfor %}

        {# --- CONFIG & KPI --- #}
        <div class="bc-top-grid">
            <div class="bc-box category-box">
                <p class="box-label">CATÉGORIE</p>
                <div class="radio-group">
                    <label class="radio-item" style="opacity: {{ planning.categorie == 'GB' ? '1' : '0.4' }};">
                        <input type="radio" disabled {% if planning.categorie == 'GB' %}checked{% endif %}> GRAND BAIN (GB)
                    </label>
                    <label class="radio-item" style="opacity: {{ planning.categorie == 'PB' ? '1' : '0.4' }};">
                        <input type="radio" disabled {% if planning.categorie == 'PB' %}checked{% endif %}> PETIT BAIN (PB)
                    </label>
                </div>
            </div>
            <div class="bc-box stats-box">
                <p class="box-label">AVANCEMENT DE LA PESÉE</p>
                <div class="stats-flex">
                    <div class="stat-item blue">
                        <small>PESÉES TERMINÉES</small>
                        <strong>{{ peseeFaite }}</strong>
                    </div>
                    <div class="stat-divider"></div>
                    <div class="stat-item gray">
                        <small>RESTANT À PESER</small>
                        <strong>{{ peseeAfaire }}</strong>
                    </div>
                </div>
            </div>
        </div>

        {# --- TABLEAU DE CONSULTATION --- #}
        <div class="planning-table-container">
            <table class="bc-table">
                <thead>         
                    <tr>
                        <th style="width: 100px;">REFI</th>
                        <th style="width: 200px;">CLIENT</th>
                        <th style="width: 45px;">IMP.</th>
                        <th style="width: 150px;">H. M.A.D</th>
                        <th style="width: 250px;">OBSERVATIONS</th>
                        <th style="width: 100px;">AVANCEMENT</th>
                        <th style="width: 120px;">STATUT PESÉE</th> {# Colonne modifiée #}
                    </tr>                
                </thead>
                <tbody>
                    {% for ligne in planning.lignes %}
                        {# Logique de calcul pour chaque ligne #}
                        {% set btComplet = false %}
                        {% if ligne.bonTravail and ligne.bonTravail.lignes|length > 0 %}
                            {% set btComplet = true %}
                            {% for ligneBT in ligne.bonTravail.lignes %}
                                {% if ligneBT.poids is null or ligneBT.poids <= 0 %}
                                    {% set btComplet = false %}
                                {% endif %}
                            {% endfor %}
                        {% endif %}

                    <tr class="planning-row" style="{% if btComplet %}background: #f0fdf4;{% endif %}">
                        
                        <td class="center-text" style="font-weight: 800; font-family: monospace; font-size: 14px;">
                            {% if ligne.bonTravail %}
                                <a href="{{ path('app_pesee_bt_edit', {'id': ligne.bonTravail.id}) }}" style="color: var(--primary-blue); text-decoration: underline;" title="Saisir les poids">
                                    {{ ligne.bonTravail.bonCommande.refi|default('-') }}
                                </a>
                            {% else %}
                                -
                            {% endif %}
                        </td>
                        
                        <td style="font-weight: bold; color: #374151;">
                            {{ ligne.bonTravail.bonCommande.client.nom|default('-') }}
                        </td>
                        
                        <td class="center-content">
                            <input type="checkbox" disabled {% if ligne.importance %}checked{% endif %}>
                        </td>
                        
                        <td class="center-text {% if ligne.importance %}text-important{% endif %}">
                            {{ ligne.heureMiseADisposition ? ligne.heureMiseADisposition|date('d/m/Y H:i') : '-' }}
                        </td>
                        
                        <td style="font-style: italic; color: #6b7280; font-size: 11px;"> 
                            {{ ligne.observations|default('-') }}
                        </td>
                        
                        <td class="center-text" style="font-weight: 900; color: var(--primary-blue);">
                            {{ ligne.avancementCode|default('---') }}
                        </td>
                        
                        <td class="center-content">
                            {% if btComplet %}
                                <span class="badge-status done"><i class="fas fa-check"></i> Pesé</span>
                            {% else %}
                                <span class="badge-status todo"><i class="fas fa-balance-scale"></i> À peser</span>
                            {% endif %}
                        </td>
                        
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="7" class="center-text" style="padding: 30px; color: #9ca3af;">
                            Aucune ligne dans ce planning.
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {# --- BOUTON RETOUR --- #}
        <div class="bc-actions no-print">
            <a href="{{ path('app_pesee_home') }}" class="btn-back">
                <i class="fas fa-arrow-left"></i> RETOUR À LA LISTE DES PLANNINGS
            </a>
        </div>
    </div>
</div>

<style>
    :root { 
        --primary-blue: #2e46a6; 
        --primary-red: #dc2626; 
        --border-dark: #1f2937; 
    }

    .bc-wrapper { background: #e5e7eb; min-height: 100vh; padding: 20px; font-family: sans-serif; }
    
    .bc-paper { 
        max-width: 1200px; 
        margin: 0 auto; 
        background: white; 
        padding: 30px; 
        box-shadow: 0 10px 25px rgba(0,0,0,0.1); 
        border-radius: 4px;
    }

    .bc-header { 
        display: flex; 
        justify-content: space-between; 
        align-items: center; 
        border-bottom: 3px solid var(--border-dark); 
        padding-bottom: 15px; 
        margin-bottom: 25px; 
    }
    .bc-logo { max-width: 100px; height: auto; }
    .bc-title-container { flex-grow: 1; text-align: center; }
    .bc-title-container h1 { margin: 0; font-size: 24px; font-weight: 900; }
    .subtitle { font-size: 12px; font-weight: bold; letter-spacing: 1px; margin-top: 5px; }

    .bc-top-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 25px; }
    .bc-box { border: 1px solid #e5e7eb; padding: 15px; background: #f9fafb; min-height: 80px; display: flex; flex-direction: column; justify-content: center; border-radius: 6px; }
    .box-label { font-size: 10px; font-weight: 900; margin-bottom: 10px; border-bottom: 1px solid #ddd; padding-bottom: 5px; color: #4b5563; }
    
    .stats-flex { display: flex; align-items: center; justify-content: space-around; width: 100%; }
    .stat-item { text-align: center; }
    .stat-item small { display: block; font-size: 9px; font-weight: bold; color: #6b7280; margin-bottom: 5px; line-height: 1.2; }
    .stat-item strong { font-size: 24px; font-weight: 900; }
    .stat-item.blue { color: var(--primary-blue); }

    .planning-table-container { border: 2px solid var(--border-dark); border-radius: 4px; overflow: hidden; }
    .bc-table { width: 100%; border-collapse: collapse; table-layout: fixed; }
    
    .bc-table th { 
        background: #f3f4f6; 
        border-bottom: 2px solid var(--border-dark); 
        border-right: 1px solid #d1d5db; 
        padding: 12px 8px; 
        font-size: 10px; 
        font-weight: 900; 
        text-transform: uppercase;
        color: #374151;
    }

    .bc-table td { 
        border-bottom: 1px solid #e5e7eb; 
        border-right: 1px solid #e5e7eb; 
        padding: 10px; 
        font-size: 12px;
        vertical-align: middle; 
    }
    
    .center-text { text-align: center; }
    .center-content { display: flex; align-items: center; justify-content: center; height: 100%; }
    
    .text-important { color: var(--primary-red); font-weight: 900; background: #fff1f2; padding: 2px 5px; border-radius: 3px; }

    .bc-actions { display: flex; justify-content: flex-start; margin-top: 30px; }
    .btn-back { 
        background: var(--primary-blue); 
        color: white; 
        text-decoration: none; 
        display: inline-flex; 
        align-items: center; 
        gap: 10px;
        padding: 12px 25px; 
        border-radius: 4px; 
        font-weight: bold; 
        transition: 0.2s;
    }
    .btn-back:hover { background: #1e3a8a; transform: translateY(-2px); }
</style>
{% endblock %}