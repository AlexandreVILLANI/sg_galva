{% extends 'base.html.twig' %}

{% block body %}
<div class="bc-wrapper">
    <div class="bc-paper" style="max-width: 95%;"> {# On élargit le conteneur car le tableau est grand #}
        
        {# --- ENTÊTE --- #}
        <div class="bc-header">
            <div class="bc-logo-container">
                <img src="{{ asset('images/sg-galva-logo.png') }}" alt="Logo" class="bc-logo">
            </div>
            <div class="bc-title-container">
                <h1>FEUILLE DE SUIVI & QUALITÉ</h1>
                <p class="subtitle" style="color: #10b981;">PRODUCTION ET AUTOCONTRÔLE ATELIER</p>
            </div>
            <div class="bc-refi-container">
                <div class="date-box">
                    <small>ÉDITION DU</small>
                    <span class="value">{{ planning.datePlanning|date('d/m/Y') }}</span>
                </div>
            </div>
        </div>

        {# --- CONFIG & KPI --- #}
        <div class="bc-top-grid">
            <div class="bc-box category-box">
                <p class="box-label">CATÉGORIE (VERROUILLÉE)</p>
                <div class="radio-group">
                    <label class="radio-item" style="opacity: 0.7;">
                        <input type="radio" name="cat" value="GB" {% if planning.categorie == 'GB' %}checked{% endif %} disabled> GB
                    </label>
                    <label class="radio-item" style="opacity: 0.7;">
                        <input type="radio" name="cat" value="PB" {% if planning.categorie == 'PB' %}checked{% endif %} disabled> PB
                    </label>
                </div>
            </div>
            <div class="bc-box stats-box">
                <p class="box-label">SUIVI DE LA PRODUCTION</p>
                <div class="stats-flex">
                    <div class="stat-item green">
                        <small>LIGNES TERMINÉES</small>
                        <strong id="count-coded">0</strong>
                    </div>
                    <div class="stat-divider"></div>
                    <div class="stat-item gray">
                        <small>EN ATTENTE</small>
                        <strong id="count-empty">0</strong>
                    </div>
                </div>
            </div>
        </div>

        {# --- TABLEAU DE SAISIE AVEC SCROLL HORIZONTAL --- #}
        <div class="planning-table-container">
            <table class="bc-table">
                <thead>         
                    <tr>
                        <th colspan="5" style="background: #f3f4f6; border-right: 2px solid #1f2937;">ORDONNANCEMENT (Lecture Seule)</th>
                        <th colspan="3" style="background: #e0f2fe; border-right: 2px solid #1f2937; color: #0369a1;">
                            CONTRÔLE PRÉPARATIONS PIÈCES SUIVANT NORMES<br>
                            NF EN SIO 1461 ET NF EN ISO 14713
                        </th>
                        <th colspan="2" style="background: #fef3c7; border-right: 2px solid #1f2937; color: #92400e;">
                            CONTRÔLE ATTACHAGE<br>PRD 02 01 05
                        </th>
                        <th colspan="3" style="background: #ecfdf5; border-right: 2px solid #1f2937; color: #047857;">BAINS ET REBUTS</th>
                        <th colspan="2" style="background: #ede9fe; border-right: 2px solid #1f2937; color: #5b21b6;">CONTRÔLE APRÈS TRAITEMENT</th>
                        <th style="background: #1f2937; color: white;">VALID.</th>
                    </tr>
                    <tr>
                        <th style="min-width: 80px;">REFI</th>
                        <th style="min-width: 120px;">CLIENT</th>
                        <th style="min-width: 35px;">IMP.</th>
                        <th style="min-width: 115px;">H. M.A.D</th>
                        <th style="min-width: 140px; border-right: 2px solid #1f2937;">OBSERVATIONS</th>
                        
                        <th style="min-width: 70px;">Q. OK/KO</th>
                        <th style="min-width: 100px;">N° Fiche NC</th>
                        <th style="min-width: 150px; border-right: 2px solid #1f2937;">Opérations</th>

                        <th style="min-width: 100px;">CE</th>
                        <th style="min-width: 100px; border-right: 2px solid #1f2937;">CONT.</th>

                        <th style="min-width: 70px;">TRAITEMENT DE SURFACE</th>
                        <th style="min-width: 70px;">BAIN ZINC</th>
                        <th style="min-width: 150px; border-right: 2px solid #1f2937;">Rebuts</th>

                        <th style="min-width: 70px;">FIN OK</th>
                        <th style="min-width: 100px; border-right: 2px solid #1f2937;">N° Fiche NC</th>

                        <th style="min-width: 60px;">FAIT</th>
                    </tr>                
                </thead>
                <tbody id="planning-body">
                    {% for ligne in planning.lignes %}
                    <tr class="planning-row" data-ligne-id="{{ ligne.id }}" style="{% if ligne.avancement %}background: #ecfdf5;{% endif %}">
                        
                        {# --- ZONE ORDONNANCEMENT (VERROUILLÉE) --- #}
                        <td class="p-0 locked-cell"> 
                            <input type="text" class="cell-input refi-autocomplete center-text locked-text" value="{{ ligne.bonTravail.bonCommande.refi }}" readonly>
                        </td>
                        <td class="p-0 locked-cell">
                            <input type="text" class="cell-input client-name locked-text" value="{{ ligne.bonTravail.bonCommande.client.nom }}" readonly>
                        </td>
                        <td class="center-content locked-cell">
                            <input type="checkbox" class="important-check" {% if ligne.importance %}checked{% endif %} disabled>
                        </td>
                        <td class="p-0 locked-cell">
                            <input type="datetime-local" class="cell-input center-text dt-input locked-text {% if ligne.importance %}is-important{% endif %}" 
                                   value="{{ ligne.heureMiseADisposition ? ligne.heureMiseADisposition|date('Y-m-d\\TH:i', 'UTC') : '' }}" readonly>
                        </td>
                        <td class="p-0 locked-cell" style="border-right: 2px solid #1f2937;"> 
                            <input type="text" class="cell-input locked-text" value="{{ ligne.observations }}" readonly>
                        </td>

                        {# --- ZONE CONTRÔLE QUALITÉ --- #}
                        <td class="p-0">
                            <select class="cell-input center-text q-ok bold-select">
                                <option value=""></option>
                                <option value="1" style="color: green;" {% if ligne.qualiteConforme is same as(true) %}selected{% endif %}>OK</option>
                                <option value="0" style="color: red;" {% if ligne.qualiteConforme is same as(false) %}selected{% endif %}>KO</option>
                            </select>
                        </td>
                        <td class="p-0"><input type="text" class="cell-input center-text q-nc" placeholder="NC-..." value="{{ ligne.qualiteFicheNC }}"></td>
                        <td class="p-0" style="border-right: 2px solid #1f2937;"><input type="text" class="cell-input q-op" placeholder="..." value="{{ ligne.qualiteOperations }}"></td>

                        {# --- ZONE AFFICHAGE --- #}
                        <td class="p-0"><input type="text" class="cell-input center-text aff-ce" placeholder="Init. CE" value="{{ ligne.affichageCaseCE }}"></td>
                        <td class="p-0" style="border-right: 2px solid #1f2937;"><input type="text" class="cell-input center-text aff-ctrl" placeholder="Init. Ctrl" value="{{ ligne.affichageCaseControleur }}"></td>

                        {# --- ZONE BAINS & REBUTS --- #}
                        <td class="p-0">
                            <select class="cell-input center-text ts-ok bold-select">
                                <option value=""></option>
                                <option value="1" style="color: green;" {% if ligne.traitementSurfaceConforme is same as(true) %}selected{% endif %}>OK</option>
                                <option value="0" style="color: red;" {% if ligne.traitementSurfaceConforme is same as(false) %}selected{% endif %}>KO</option>
                            </select>
                        </td>
                        <td class="p-0">
                            <select class="cell-input center-text zn-ok bold-select">
                                <option value=""></option>
                                <option value="1" style="color: green;" {% if ligne.bainZincConforme is same as(true) %}selected{% endif %}>OK</option>
                                <option value="0" style="color: red;" {% if ligne.bainZincConforme is same as(false) %}selected{% endif %}>KO</option>
                            </select>
                        </td>
                        <td class="p-0" style="border-right: 2px solid #1f2937;"><input type="text" class="cell-input rebuts" placeholder="Détail rebuts..." value="{{ ligne.rebuts }}"></td>

                        {# --- ZONE CTRL FINAL --- #}
                        <td class="p-0">
                            <select class="cell-input center-text fin-ok bold-select">
                                <option value=""></option>
                                <option value="1" style="color: green;" {% if ligne.finalConforme is same as(true) %}selected{% endif %}>OK</option>
                                <option value="0" style="color: red;" {% if ligne.finalConforme is same as(false) %}selected{% endif %}>KO</option>
                            </select>
                        </td>
                        <td class="p-0" style="border-right: 2px solid #1f2937;"><input type="text" class="cell-input center-text fin-nc" placeholder="NC-..." value="{{ ligne.finalFicheNC }}"></td>

                        {# --- CASE FAIT (ACTIVE) --- #}
                        <td class="center-content" style="background: #f9fafb;">
                            <input type="checkbox" class="avancement-check" style="transform: scale(1.5); cursor: pointer;" {% if ligne.avancement %}checked{% endif %}>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="bc-actions no-print">
            <a href="{{ path('app_chef_equipe_home') }}" class="btn-back">
                RETOUR SANS SAUVEGARDER
            </a>
            <button class="btn-save" style="background: #10b981;" onclick="validerPlanning()">
                <i class="fas fa-save"></i> ENREGISTRER LA PRODUCTION
            </button>
        </div>
    </div>
</div>

<style>
    :root { 
        --primary-green: #10b981; 
        --primary-red: #dc2626; 
        --border-dark: #1f2937; 
    }

    .bc-wrapper { background: #e5e7eb; min-height: 100vh; padding: 20px; font-family: sans-serif; }
    
    .bc-paper { 
        margin: 0 auto; 
        background: white; 
        padding: 30px; 
        box-shadow: 0 10px 25px rgba(0,0,0,0.1); 
        border-radius: 4px;
    }

    .bc-header { display: flex; justify-content: space-between; align-items: center; border-bottom: 3px solid var(--border-dark); padding-bottom: 15px; margin-bottom: 25px; }
    .bc-logo { max-width: 100px; height: auto; }
    .bc-title-container { flex-grow: 1; text-align: center; }
    .bc-title-container h1 { margin: 0; font-size: 24px; font-weight: 900; }
    .subtitle { font-size: 11px; font-weight: bold; text-transform: uppercase; margin-top: 5px; }

    .bc-top-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 25px; }
    .bc-box { border: 1px solid #e5e7eb; padding: 15px; background: #f9fafb; min-height: 80px; display: flex; flex-direction: column; justify-content: center; }
    .box-label { font-size: 10px; font-weight: 900; margin-bottom: 10px; border-bottom: 1px solid #ddd; padding-bottom: 5px; }
    
    .stats-flex { display: flex; align-items: center; justify-content: space-around; width: 100%; }
    .stat-item { text-align: center; }
    .stat-item small { display: block; font-size: 9px; font-weight: bold; color: #6b7280; margin-bottom: 5px; line-height: 1.2; }
    .stat-item strong { font-size: 24px; font-weight: 900; }
    .stat-item.green { color: var(--primary-green); }

    /* NOUVEAU : Scrolling Horizontal du Tableau */
    .planning-table-container { 
        border: 2px solid var(--border-dark); 
        overflow-x: auto; /* Permet de scroller de gauche à droite */
        width: 100%;
    }
    .bc-table { width: max-content; min-width: 100%; border-collapse: collapse; }
    
    .bc-table th { 
        border-bottom: 2px solid var(--border-dark); 
        border-right: 1px solid #d1d5db; 
        padding: 10px 5px; 
        font-size: 10px; 
        font-weight: 900; 
        text-transform: uppercase;
        text-align: center;
    }

    .bc-table td { border-bottom: 1px solid #ddd; border-right: 1px solid #ddd; height: 40px; vertical-align: middle; position: relative; }
    
    /* Styles des inputs */
    .cell-input { width: 100%; height: 100%; border: none; background: transparent; padding: 0 8px; font-size: 12px; outline: none; box-sizing: border-box; transition: 0.2s; }
    .bold-select { font-weight: bold; cursor: pointer; }
    .dt-input { font-size: 11px; } 
    .dt-input.is-important { color: var(--primary-red) !important; font-weight: 900; background: #fff1f2; }
    .center-text { text-align: center; }
    .p-0 { padding: 0 !important; }

    /* Style des cases verrouillées */
    .locked-cell { background: #f3f4f6; opacity: 0.8; }
    .locked-text { color: #6b7280; font-weight: 600; cursor: not-allowed; }

    .bc-actions { display: flex; gap: 15px; margin-top: 30px; }
    .btn-save { flex: 4; color: white; border: none; padding: 15px; border-radius: 4px; font-weight: 800; cursor: pointer; font-size: 16px; }
    .btn-back { flex: 1; background: #6b7280; color: white; text-decoration: none; display: flex; align-items: center; justify-content: center; border-radius: 4px; font-weight: bold; }

    /* Style des cases verrouillées avec gestion des textes longs */
    .locked-cell { background: #f3f4f6; opacity: 0.8; }
    .locked-text { 
        color: #6b7280; 
        font-weight: 600; 
        cursor: not-allowed; 
        text-overflow: ellipsis;
        white-space: nowrap;
        overflow: hidden;
        padding: 0 4px; 
        font-size: 11px;
    }
</style>

<script>
async function validerPlanning() {
    const lignes = [];
    const rows = document.querySelectorAll('.planning-row');

    rows.forEach(row => {
        const ligneId = row.getAttribute('data-ligne-id'); 
        
        if (ligneId) {
            
            // Fonction utilitaire pour lire les selects vides/1/0
            const getBoolVal = (selector) => {
                const val = row.querySelector(selector).value;
                if (val === "1") return true;
                if (val === "0") return false;
                return null;
            };

            lignes.push({
                id: parseInt(ligneId),
                
                // Champs Qualité
                qualiteConforme: getBoolVal('.q-ok'),
                qualiteFicheNC: row.querySelector('.q-nc').value.trim(),
                qualiteOperations: row.querySelector('.q-op').value.trim(),
                
                affichageCaseCE: row.querySelector('.aff-ce').value.trim(),
                affichageCaseControleur: row.querySelector('.aff-ctrl').value.trim(),
                
                traitementSurfaceConforme: getBoolVal('.ts-ok'),
                bainZincConforme: getBoolVal('.zn-ok'),
                rebuts: row.querySelector('.rebuts').value.trim(),
                
                finalConforme: getBoolVal('.fin-ok'),
                finalFicheNC: row.querySelector('.fin-nc').value.trim(),
                
                avancement: row.querySelector('.avancement-check').checked // La case FAIT
            });
        }
    });

    if (lignes.length === 0) {
        alert("Attention : Aucune donnée à enregistrer !");
        return;
    }

    try {
        const btnSave = document.querySelector('.btn-save');
        const oldText = btnSave.innerHTML;
        btnSave.innerHTML = '<i class="fas fa-spinner fa-spin"></i> ENREGISTREMENT...';
        btnSave.disabled = true;

        const planningId = "{{ planning.id }}";
        // On tape bien sur la route spécifique du Chef d'équipe pour la Qualité
        const url = "{{ path('app_planning_quality_update', {'id': 'ID_PLACEHOLDER'}) }}".replace('ID_PLACEHOLDER', planningId);

        const response = await fetch(url, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: JSON.stringify({
                lignes: lignes
            })
        });

        const data = await response.json();

        if (response.ok && data.success) {
            // REDIRECTION CIBLÉE SUR LE TABLEAU DE BORD CHEF D'ÉQUIPE
            window.location.href = "{{ path('app_chef_equipe_home') }}";
        } else {
            alert("Erreur : " + (data.message || "Inconnue."));
            btnSave.innerHTML = oldText;
            btnSave.disabled = false;
        }
    } catch (err) {
        alert("Erreur réseau. Impossible d'enregistrer.");
        document.querySelector('.btn-save').disabled = false;
    }
}

function updateStats() {
    const rows = document.querySelectorAll('.planning-row');
    let fait = 0; let attente = 0;
    rows.forEach(row => {
        if (row.querySelector('.avancement-check').checked) fait++;
        else attente++;
    });
    document.getElementById('count-coded').textContent = fait;
    document.getElementById('count-empty').textContent = attente;
}

function initPlanning() {
    updateStats(); 
    
    // Met à jour la couleur des lignes quand on coche "Fait"
    const tbody = document.getElementById('planning-body');
    tbody.addEventListener('change', (e) => {
        if (e.target.classList.contains('avancement-check')) {
            const row = e.target.closest('tr');
            if (e.target.checked) {
                row.style.background = '#ecfdf5'; // Vert clair
            } else {
                row.style.background = 'transparent';
            }
            updateStats();
        }
    });
}

document.addEventListener('turbo:load', initPlanning);
document.addEventListener('DOMContentLoaded', initPlanning);
</script>
{% endblock %}