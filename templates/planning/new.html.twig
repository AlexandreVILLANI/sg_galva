{% extends 'base.html.twig' %}

{% block body %}
<div class="bc-wrapper">
    <div class="bc-paper">
        
        {# --- ENTÊTE --- #}
        <div class="bc-header">
            <div class="bc-logo-container">
                <img src="{{ asset('images/sg-galva-logo.png') }}" alt="Logo" class="bc-logo">
            </div>
            <div class="bc-title-container">
                <h1>FEUILLE DE PLANNING</h1>
                <p class="subtitle">ORDONNANCEMENT & PRÉPARATION PRODUCTION</p>
            </div>
            <div class="bc-refi-container">
                <div class="date-box">
                    <small>ÉDITION DU</small>
                    <span class="value">{{ "now"|date('d/m/Y') }}</span>
                </div>
            </div>
        </div>

        {# --- CONFIG & KPI --- #}
        <div class="bc-top-grid">
            <div class="bc-box category-box">
                <p class="box-label">CATÉGORIE</p>
                <div class="radio-group">
                    <label class="radio-item"><input type="radio" name="cat" value="GB" checked> GB</label>
                    <label class="radio-item"><input type="radio" name="cat" value="PB"> PB</label>
                </div>
            </div>
            <div class="bc-box stats-box">
                <p class="box-label">SUIVI DE LA PLANIFICATION</p>
                <div class="stats-flex">
                    <div class="stat-item green">
                        <small>COMMANDES DANS LES TEMPS</small>
                        <strong id="count-coded">0</strong>
                    </div>
                    <div class="stat-divider"></div>
                    <div class="stat-item gray">
                        <small>COMMANDES EN RETARD</small>
                        <strong id="count-empty">0</strong>
                    </div>
                </div>
            </div>
        </div>
        {# --- TABLEAU DE SAISIE --- #}
        <div class="planning-table-container">
            <table class="bc-table">
                <thead>         
                    <tr>
                        <th style="width: 100px;">REFI</th>
                        <th style="width: 200px;">CLIENT</th>
                        <th style="width: 45px;">IMP.</th>
                        <th style="width: 195px;">H. M.A.D (Jour & Heure)</th>
                        <th style="width: 350px;">OBSERVATIONS PARTICULIÈRES</th>
                        <th style="width: 80px;">AVANCEMENT</th>
                        <th style="width: 50px;">FAIT</th>
                        <th style="width: 40px;" class="no-print"></th>
                    </tr>                
                </thead>
                <tbody id="planning-body">
                    {% for i in 1..10 %}
                    <tr class="planning-row">
                        <td class="p-0" style="position: relative;"> 
                            <input type="text" class="cell-input refi-autocomplete center-text" placeholder="REFI..." autocomplete="off">
                            <div class="autocomplete-results"></div>
                        </td>
                        <td class="p-0">
                            <input type="text" class="cell-input client-name" readonly placeholder="..." style="font-weight: bold;">
                        </td>
                        <td class="center-content">
                            <input type="checkbox" class="important-check">
                        </td>
                        <td class="p-0">
                            <input type="datetime-local" class="cell-input center-text dt-input" value="{{ "now"|date('Y-m-d') }}T08:00">
                        </td>
                        <td class="p-0">
                            <input type="text" class="cell-input" placeholder="Note d'atelier...">
                        </td>
                        <td class="p-0">
                            <input type="text" class="cell-input avancement-code center-text bold" maxlength="3" placeholder="---">
                        </td>
                        <td class="center-content"><input type="checkbox" disabled class="avancement-check"></td>
                        <td class="center-content no-print">
                            <button type="button" class="btn-del-row" onclick="removeRow(this)" title="Supprimer">×</button>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="no-print" style="margin-top: 10px;">
            <button type="button" class="btn-add-row" id="add-new-line">
                <i class="fas fa-plus"></i> AJOUTER DES LIGNES SUPPLÉMENTAIRES
            </button>
        </div>

        <div class="bc-actions no-print">
            <a href="{{ path('app_ordonnancement_home') }}" class="btn-back">RETOUR</a>
            <button class="btn-save" onclick="alert('Planning enregistré !')">
                <i class="fas fa-save"></i> VALIDER LE PLANNING
            </button>
        </div>
    </div>
</div>

<style>
    :root { 
        --primary-green: #10b981; 
        --primary-red: #dc2626; 
        --border-dark: #1f2937; 
    }

    .bc-wrapper { background: #e5e7eb; min-height: 100vh; padding: 20px; font-family: sans-serif; }
    
    .bc-paper { 
        max-width: 1200px; 
        margin: 0 auto; 
        background: white; 
        padding: 30px; 
        box-shadow: 0 10px 25px rgba(0,0,0,0.1); 
        border-radius: 4px;
    }

    .bc-header { 
        display: flex; 
        justify-content: space-between; 
        align-items: center; 
        border-bottom: 3px solid var(--border-dark); 
        padding-bottom: 15px; 
        margin-bottom: 25px; 
    }
    .bc-logo { max-width: 100px; height: auto; }
    .bc-title-container { flex-grow: 1; text-align: center; }
    .bc-title-container h1 { margin: 0; font-size: 24px; font-weight: 900; }
    .subtitle { font-size: 11px; font-weight: bold; color: var(--primary-green); text-transform: uppercase; margin-top: 5px; }

    .bc-top-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 25px; }
    .bc-box { border: 1px solid #e5e7eb; padding: 15px; background: #f9fafb; min-height: 80px; display: flex; flex-direction: column; justify-content: center; }
    .box-label { font-size: 10px; font-weight: 900; margin-bottom: 10px; border-bottom: 1px solid #ddd; padding-bottom: 5px; }
    
    .stats-flex { display: flex; align-items: center; justify-content: space-around; width: 100%; }
    .stat-item { text-align: center; }
    .stat-item small { display: block; font-size: 9px; font-weight: bold; color: #6b7280; margin-bottom: 5px; line-height: 1.2; }
    .stat-item strong { font-size: 24px; font-weight: 900; }
    .stat-item.green { color: var(--primary-green); }

    /* TABLEAU : Fixation stricte des largeurs */
    .planning-table-container { border: 2px solid var(--border-dark); overflow: visible !important; }
    .bc-table { width: 100%; border-collapse: collapse; table-layout: fixed; }
    
    .bc-table th { 
        background: #f3f4f6; 
        border-bottom: 2px solid var(--border-dark); 
        border-right: 1px solid #d1d5db; 
        padding: 10px 5px; 
        font-size: 10px; 
        font-weight: 900; 
        text-transform: uppercase;
        overflow: hidden;
    }

    .bc-table td { border-bottom: 1px solid #ddd; border-right: 1px solid #ddd; height: 40px; vertical-align: middle; position: relative; }
    
    /* Styles des inputs */
    .cell-input { width: 100%; height: 100%; border: none; background: transparent; padding: 0 8px; font-size: 12px; outline: none; box-sizing: border-box; }
    .dt-input { font-size: 11px; } /* Pour que la date/heure tienne sur une ligne */
    
    /* Couleurs spécifiques */
    .dt-input.is-important { color: var(--primary-red) !important; font-weight: 900; background: #fff1f2; }
    .center-text { text-align: center; }
    .p-0 { padding: 0 !important; }

    /* Suggestions (Autocomplete) */
    .autocomplete-results { 
        position: absolute; top: 100%; left: 0; right: 0; 
        background: white; border: 1px solid var(--border-dark); 
        z-index: 9999; display: none; max-height: 200px; overflow-y: auto; 
        box-shadow: 0 10px 15px rgba(0,0,0,0.1); 
    }

    /* Actions */
    .bc-actions { display: flex; gap: 15px; margin-top: 30px; }
    .btn-save { flex: 4; background: var(--primary-green); color: white; border: none; padding: 15px; border-radius: 4px; font-weight: 800; cursor: pointer; font-size: 16px; }
    .btn-back { flex: 1; background: #6b7280; color: white; text-decoration: none; display: flex; align-items: center; justify-content: center; border-radius: 4px; font-weight: bold; }
</style>

<script>
function removeRow(btn) {
    const row = btn.closest('tr');
    if (document.querySelectorAll('.planning-row').length > 1) {
        row.remove();
        updateStats();
    }
}

function updateStats() {
    const rows = document.querySelectorAll('.planning-row');
    let coded = 0; let empty = 0;
    rows.forEach(row => {
        const client = row.querySelector('.client-name').value;
        const code = row.querySelector('.avancement-code').value.trim();
        if (client && client !== "..." && client !== "NON TROUVÉ") {
            if (code !== "") coded++;
            else empty++;
        }
    });
    document.getElementById('count-coded').textContent = coded;
    document.getElementById('count-empty').textContent = empty;
}

function initPlanning() {
    const tbody = document.getElementById('planning-body');
    const addBtn = document.getElementById('add-new-line');

    addBtn.addEventListener('click', () => {
        const firstRow = document.querySelector('.planning-row');
        const newRow = firstRow.cloneNode(true);
        newRow.querySelectorAll('input').forEach(input => {
            if (input.type === 'checkbox') input.checked = false;
            else if (input.type === 'datetime-local') input.value = "{{ "now"|date('Y-m-d') }}T08:00";
            else input.value = '';
            input.classList.remove('is-important');
        });
        newRow.style.background = 'transparent';
        newRow.querySelector('.autocomplete-results').style.display = 'none';
        tbody.appendChild(newRow);
        updateStats();
    });

    tbody.addEventListener('input', async (e) => {
        if (e.target.classList.contains('refi-autocomplete')) {
            const input = e.target;
            const resultsDiv = input.nextElementSibling;
            const val = input.value.trim();
            if (val.length < 2) { resultsDiv.style.display = 'none'; return; }
            try {
                const response = await fetch(`/api/search-bt?q=${val}`);
                const data = await response.json();
                if (data.length > 0) {
                    resultsDiv.innerHTML = '';
                    data.forEach(item => {
                        const div = document.createElement('div');
                        div.className = 'suggestion-item';
                        div.innerHTML = `<strong>${item.refi}</strong> <span>${item.client}</span>`;
                        div.onclick = () => {
                            input.value = item.refi;
                            input.closest('tr').querySelector('.client-name').value = item.client;
                            resultsDiv.style.display = 'none';
                            updateStats();
                        };
                        resultsDiv.appendChild(div);
                    });
                    resultsDiv.style.display = 'block';
                }
            } catch (err) {}
        }
        if (e.target.classList.contains('avancement-code')) updateStats();
    });

    tbody.addEventListener('change', (e) => {
        if (e.target.classList.contains('important-check')) {
            const dtInput = e.target.closest('tr').querySelector('.dt-input');
            e.target.checked ? dtInput.classList.add('is-important') : dtInput.classList.remove('is-important');
        }
    });

    document.addEventListener('click', (e) => {
        if (!e.target.classList.contains('refi-autocomplete')) {
            document.querySelectorAll('.autocomplete-results').forEach(d => d.style.display = 'none');
        }
    });
}

document.addEventListener('turbo:load', initPlanning);
document.addEventListener('DOMContentLoaded', initPlanning);
</script>
{% endblock %}