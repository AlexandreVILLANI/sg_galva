{% extends 'base.html.twig' %}

{% block title %}Édition Bon de Travail - {{ bt.numero }}{% endblock %}

{% block body %}
<div class="bc-wrapper edit-mode">
    
    {# --- LE FORMULAIRE ENGLOBE TOUT --- #}
    <form action="{{ path('app_admin_bt_update', {'id': bt.id}) }}" method="POST" class="bc-paper">
        
        {# --- ENTÊTE --- #}
        <div class="bc-header">
            <div class="bc-logo-container">
                <img src="{{ asset('images/sg-galva-logo.png') }}" alt="Logo" class="bc-logo">
            </div>
            <div class="bc-title-container">
                <h1>BON DE TRAVAIL</h1>
                <span class="mode-badge">MODE ÉDITION</span>
            </div>
            <div class="bc-refi-container">
                <label>N° BT -</label>
                {# MODIFIABLE #}
                <input type="text" name="numero" class="refi-input-editable" value="{{ bt.numero }}">
            </div>
        </div>

        {# --- GRILLE HAUTE --- #}
        <div class="bc-top-grid">
           <div class="bc-box treatment-box">
                <p class="box-label">TRAITEMENT :</p>
                <div class="radio-group" style="display: flex; gap: 20px;">
                    
                    <label style="cursor: pointer;">
                        <input type="radio" name="is_cataphorese" value="0" 
                            {% if commande.isGalvanisation %}checked{% endif %}> 
                        <strong>Galvanisation</strong>
                    </label>

                    <label style="cursor: pointer;">
                        <input type="radio" name="is_cataphorese" value="1" 
                            {% if commande.isCataphorese %}checked{% endif %}> 
                        <strong>Cataphorèse</strong>
                    </label>

                </div>
            </div>
            <div class="bc-box summary-box readonly-box">
                <div class="summary-line"><span>Ref. Interne :</span> <strong>{{ commande.refi }}</strong></div>
                <div class="summary-line"><span>Date :</span> <strong>{{ bt.dateCreation|date('d/m/Y') }}</strong></div>
                <div class="summary-line"><span>Nb PAQ :</span> <strong>{{ commande.fiche.totalPaquets }}</strong></div>
                <div class="summary-line"><span>Client :</span> <strong>{{ commande.fiche.client.nom }}</strong></div>
            </div>
        </div>

        {# --- ZONE TECHNIQUE (TOUT MODIFIABLE) --- #}
        <div class="bc-box tech-box-edit">
            <p class="box-label">Informations Techniques</p>
            <div class="tech-grid">
                <div class="tech-col">
                    <span class="label">EXIGENCE PARTICULIÈRE :</span>
                    <input type="text" name="exigence_particuliere" class="ghost-input editable" value="{{ bt.exigenceParticuliere }}">
                </div>
                <div class="tech-col">
                    <span class="label">REPRISE USINAGE :</span>
                    <input type="text" name="reprise_usinage" class="ghost-input editable" value="{{ bt.repriseUsinage }}">
                </div>
                <div class="tech-col">
                    <span class="label" style="color: #10b981;">DÉLAI CLIENT :</span>
                    <input type="date" name="delai_client" class="ghost-input editable date-field" value="{{ bt.delaiClient ? bt.delaiClient|date('Y-m-d') : '' }}">
                </div>
            </div>
        </div>

        {# --- TABLEAU TECHNIQUE (TOUT MODIFIABLE) --- #}
        <div class="bc-box description-box table-wrapper">
            <table class="bc-table">
                <thead>
                    <tr>
                        <th width="5%">Qté</th>
                        <th width="30%">Désignation</th>
                        <th width="5%">U</th>
                        <th width="15%">Référence</th>
                        <th width="15%">Trav. Annexes</th>
                        <th width="10%">Poids Kg</th>
                        <th width="20%">Observations</th>
                    </tr>
                </thead>
                <tbody>
                    {% for ligne in bt.lignes %}
                        <tr>
                            <td class="center bold bg-gray">{{ ligne.nbPaquets }}</td>
                            <td class="designation bg-gray">
                                <strong>{{ ligne.description|default('Produit non précisé') }}</strong>
                                <div class="sub-info">Emp: {{ ligne.emplacement ? ligne.emplacement.nom : '-' }}</div>
                            </td>
                            
                            {# Champs éditables avec l'ID de la ligne pour le contrôleur #}
                            <td class="p-0"><input type="text" name="lignes[{{ ligne.id }}][u]" class="cell-input center" value="{{ ligne.u }}"></td>
                            <td class="p-0"><input type="text" name="lignes[{{ ligne.id }}][reference]" class="cell-input" value="{{ ligne.reference }}"></td>
                            <td class="p-0"><input type="text" name="lignes[{{ ligne.id }}][travauxAnnexes]" class="cell-input" value="{{ ligne.travauxAnnexes }}"></td>
                            <td class="p-0"><input type="number" step="0.01" name="lignes[{{ ligne.id }}][poids]" class="cell-input right" value="{{ ligne.poids }}"></td>
                            <td class="p-0"><input type="text" name="lignes[{{ ligne.id }}][observations]" class="cell-input" value="{{ ligne.observations }}"></td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {# --- OBSERVATIONS GÉNÉRALES --- #}
        <div class="bc-box comment-box">
            <span class="label">Observations générales de l'Atelier :</span>
            <div class="mt-2">
                <textarea name="observations" class="w-100 ghost-textarea editable" rows="3">{{ bt.observations }}</textarea>
            </div>
        </div>

        <div class="bc-actions no-print">
            <a href="{{ path('app_admin_home', {'section': 'admin-bt'}) }}" class="btn-cancel">
                <i class="fas fa-times"></i> ANNULER
            </a>
            
            <button type="submit" class="btn-confirm">
                <i class="fas fa-save"></i> ENREGISTRER TOUT LE BON
            </button>
        </div>

    </form>
</div>

<style>
    /* --- STYLE REPRIS DE TON FICHIER --- */
    .bc-wrapper { background: #f0f0f0; min-height: 100vh; padding: 40px 20px; font-family: Arial, sans-serif; color: #1a1a1a; }
    .bc-paper { max-width: 950px; margin: 0 auto; background: white; padding: 40px; box-shadow: 0 0 20px rgba(0,0,0,0.1); border-top: 5px solid #10b981; }
    .bc-box { border: 1px solid #ddd; padding: 15px; margin-bottom: 20px; }
    
    .bc-header { display: grid; grid-template-columns: 1fr 2fr 1.5fr; align-items: center; border-bottom: 2px solid #000; padding-bottom: 10px; margin-bottom: 20px; }
    .bc-logo { max-width: 120px; }
    .bc-title-container h1 { font-size: 22px; font-weight: 800; text-align: center; margin: 0; }
    
    .mode-badge { display: block; text-align: center; font-size: 10px; color: #10b981; font-weight: bold; letter-spacing: 1px; margin-top: 5px; }
    
    /* Inputs Éditables (Refi / N° BT) */
    .refi-input-editable { border: 1px solid #10b981; font-weight: bold; font-size: 20px; width: 140px; text-align: right; background: #f0fdf4; padding: 2px 5px; outline: none; }

    /* Zone Technique */
    .tech-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 15px; }
    .label { font-weight: bold; font-size: 11px; text-transform: uppercase; margin-bottom: 5px; color: #444; display: block; }
    .readonly-box { background: #f9fafb; color: #666; }

    /* Style Ghost Editable */
    .ghost-input.editable, .ghost-textarea.editable { 
        border: none; 
        border-bottom: 1px dashed #10b981; 
        background: #f0fdf4; 
        font-family: inherit; 
        font-size: 13px; 
        padding: 5px; 
        width: 100%; 
        box-sizing: border-box;
        outline: none;
    }
    .ghost-input.editable:focus { border-bottom-style: solid; background: #d1fae5; }

    /* Tableau */
    .table-wrapper { padding: 0; border: 1px solid #000; overflow: hidden; }
    .bc-table { width: 100%; border-collapse: collapse; font-size: 12px; }
    .bc-table th { background: #f0f0f0; border-bottom: 1px solid #000; border-right: 1px solid #000; padding: 8px 5px; text-align: left; font-size: 11px; text-transform: uppercase; }
    .bc-table td { border-bottom: 1px solid #000; border-right: 1px solid #000; height: 35px; vertical-align: middle; }
    .bg-gray { background: #f9fafb; }

    /* Inputs dans tableau */
    .cell-input { width: 100%; height: 100%; border: none; background: transparent; padding: 0 5px; box-sizing: border-box; font-family: inherit; font-size: 13px; }
    .cell-input:focus { background: #f0fdf4; outline: 1px solid #10b981; }
    
    .center { text-align: center; } .right { text-align: right; }
    .designation { padding: 0 8px; }
    .sub-info { font-size: 10px; color: #666; margin-top: 2px; }
    .p-0 { padding: 0 !important; }

    /* Actions */
    .bc-actions { display: flex; gap: 15px; margin-top: 30px; }
    .btn-cancel { flex: 1; background: #6b7280; color: white; padding: 15px; text-align: center; border-radius: 5px; text-decoration: none; font-weight: bold; }
    .btn-confirm { flex: 3; background: #10b981; color: white; border: none; padding: 15px; border-radius: 5px; font-weight: bold; cursor: pointer; font-size: 16px; transition: 0.2s; }
    .btn-confirm:hover { background: #059669; transform: translateY(-1px); }

    .w-100 { width: 100%; } .mt-2 { margin-top: 10px; } .bold { font-weight: bold; }
</style>
{% endblock %}