{% extends 'base.html.twig' %}

{% block title %}Bon de Travail - {{ bt.numero }}{% endblock %}

{% block body %}
<div class="bc-wrapper">
    
    {# La page devient un formulaire qui s'envoie à lui-même #}
    <form method="POST" class="bc-paper">
        
        {# --- ENTÊTE --- #}
        <div class="bc-header">
            <div class="bc-logo-container">
                <img src="{{ asset('images/sg-galva-logo.png') }}" alt="Logo" class="bc-logo">
            </div>
            <div class="bc-title-container">
                <h1>BON DE TRAVAIL</h1>
            </div>
            <div class="bc-refi-container">
                <label>N° BT -</label>
                <input type="text" class="refi-input-ghost" value="{{ bt.numero }}" readonly>
            </div>
        </div>

        {# --- AFFICHAGE DES MESSAGES FLASH (Succès) --- #}
        {% for message in app.flashes('success') %}
            <div style="background: #ecfdf5; color: #047857; padding: 10px; margin-bottom: 20px; border-radius: 5px; border: 1px solid #a7f3d0; text-align: center; font-weight: bold;">
                <i class="fas fa-check-circle"></i> {{ message }}
            </div>
        {% endfor %}

        {# --- GRILLE HAUTE --- #}
        <div class="bc-top-grid">
            <div class="bc-box treatment-box">
                <p class="box-label">TRAITEMENT :</p>
                <div class="checkbox-group">
                    <label><input type="checkbox" checked disabled> (Galvanisation {% if commande.typeGalva and commande.typeGalva != 'CATA' %}- {{ commande.typeGalva }}{% endif %})</label>
                    <label><input type="checkbox" disabled> (Cataphorèse)</label>
                </div>
            </div>
            <div class="bc-box summary-box">
                <div class="summary-line"><span>Ref. Interne :</span> <strong>{{ commande.refi }}</strong></div>
                <div class="summary-line"><span>Date :</span> <strong>{{ bt.dateCreation|date('d/m/Y') }}</strong></div>
                <div class="summary-line"><span>Nb PAQ :</span> <strong>{{ commande.fiche.totalPaquets }}</strong></div>
                <div class="summary-line"><span>Client :</span> <strong>{{ commande.fiche.client.nom }}</strong></div>
            </div>
        </div>

        {# --- GRILLE MILIEU : ADRESSES --- #}
        <div class="bc-middle-grid">
            <div class="bc-box client-box">
                <p class="box-label">ADRESSE DE FACTURATION</p>
                <div class="frame-content">
                    <strong>{{ commande.fiche.client.nom }}</strong><br>
                    {{ commande.fiche.client.adresseFacturation|nl2br }}<br>
                    {{ commande.fiche.client.codePostal }} {{ commande.fiche.client.ville }}
                </div>
            </div>
            <div class="bc-box driver-box">
                <p class="box-label">ADRESSE DE LIVRAISON</p>
                <div class="frame-content">
                    <strong>{{ commande.fiche.client.nom }}</strong><br>
                    {{ commande.fiche.client.adresseLivraison|default(commande.fiche.client.adresseFacturation)|nl2br }}<br>
                    {{ commande.fiche.client.codePostal }} {{ commande.fiche.client.ville }}
                </div>
            </div>
        </div>

        {# --- ZONE TECHNIQUE --- #}
        <div class="bc-box">
            <div class="tech-grid">
                <div class="tech-col">
                    <span class="label">EXIGENCE PARTICULIÈRE :</span>
                    <input type="text" class="ghost-input full-width" value="{{ bt.exigenceParticuliere }}" readonly>
                </div>
                <div class="tech-col">
                    <span class="label">REPRISE USINAGE :</span>
                    <input type="text" class="ghost-input full-width" value="{{ bt.repriseUsinage }}" readonly>
                </div>
                
                {# === SEUL CHAMP MODIFIABLE === #}
                <div class="tech-col">
                    <span class="label" style="color: var(--primary-green);">DÉLAI CLIENT : <i class="fas fa-pencil-alt"></i></span>
                    <input type="date" name="delai_client" class="ghost-input editable-field" value="{{ bt.delaiClient ? bt.delaiClient|date('Y-m-d') : '' }}">
                </div>
            </div>

            {# --- AFFICHAGE NON MODIFIABLE DU CERTIFICAT --- #}
            <div class="certificat-box">
                <label class="certificat-label">
                    <input type="checkbox" class="certificat-checkbox" disabled {% if bt.demandeCertificat %}checked{% endif %}>
                    Demande de certificat
                </label>
            </div>
        </div>

        {# --- TABLEAU TECHNIQUE (AUTOMATIQUE) --- #}
        <div class="bc-box description-box table-wrapper">
            <table class="bc-table">
                <thead>
                    <tr>
                        <th width="5%">Qté</th>
                        <th width="30%">Désignation</th>
                        <th width="5%">U</th>
                        <th width="12%">Référence</th>
                        <th width="13%">Trav. Annexes</th>
                        <th width="10%">Poids Kg</th>
                        <th width="10%" style="color: #dc2626;">Facture à modif.</th>
                        <th width="15%">Observations</th>
                    </tr>
                </thead>
                <tbody>
                    {% for ligne in bt.lignes %}
                        <tr>
                            <td class="center bold">{{ ligne.nbPaquets }}</td>
                            <td class="designation">
                                <strong>{{ ligne.description|default('Produit non précisé') }}</strong>
                                <div class="sub-info">Avant: {{ ligne.emplacement ? ligne.emplacement.nom : '-' }} | Après: {{ ligne.emplacementApresProduction ? ligne.emplacementApresProduction.nom : '-' }}</div>
                            </td>
                            
                            <td class="p-0"><input type="text" class="cell-input center" value="{{ ligne.u }}" readonly></td>
                            <td class="p-0"><input type="text" class="cell-input" value="{{ ligne.reference }}" readonly></td>
                            <td class="p-0"><input type="text" class="cell-input" value="{{ ligne.travauxAnnexes }}" readonly></td>
                            <td class="p-0"><input type="text" class="cell-input right" value="{{ ligne.poids }}" readonly></td>
                            <td class="p-0"><input type="text" class="cell-input" style="color: #dc2626; font-weight: bold;" value="{{ ligne.commentairesFacturation }}" readonly></td>
                            <td class="p-0"><input type="text" class="cell-input" value="{{ ligne.observations }}" readonly></td>
                        </tr>
                    {% else %}
                        <tr><td colspan="8" class="center muted">Aucune ligne trouvée.</td></tr>
                    {% endfor %}

                    {% for i in 1..5 %}
                    <tr><td colspan="8" style="height: 35px; border-bottom: 1px solid #000; border-right: 1px solid #000;"></td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {# --- PIED DE PAGE : OBSERVATIONS GÉNÉRALES --- #}
        <div class="bc-box comment-box">
            <span class="label">Observations générales du Bon de Travail :</span>
            <div class="mt-2">
                <textarea class="w-100" rows="2" readonly>{{ bt.observations }}</textarea>
            </div>
        </div>

        <div class="bc-footer-info">
            <div><strong>Mise à dispo. atelier :</strong> {{ bt.dateCreation|date('d/m/Y H:i') }}</div>
            <div><strong>Règlement :</strong> SOUP.RGT.CPT.</div>
        </div>

        <div class="bc-actions no-print">
            <a href="{{ path('app_ordonnancement_home') }}" class="btn-cancel" style="background-color: #6b7280; color: white;">
                <i class="fas fa-arrow-left"></i> Retour
            </a>
            
            {# BOUTON ENREGISTRER RAJOUTÉ #}
            <button type="submit" class="btn-confirm" style="flex: 2; background-color: #10b981; color: white; border: none; border-radius: 5px; cursor: pointer; font-weight: bold; font-size: 16px;">
                <i class="fas fa-save"></i> Enregistrer le délai
            </button>
            
            <button type="button" class="btn-print" onclick="window.print()" style="flex: 1; background-color: #333333; color: white; border: none; border-radius: 5px; cursor: pointer; font-weight: bold; font-size: 16px;">
                <i class="fas fa-print"></i> Imprimer
            </button>
        </div>

    </form> {# Fin du formulaire #}
</div>

<style>
    /* --- CSS HARMONISÉ AVEC LE BON DE COMMANDE --- */
    .bc-wrapper { background: #f0f0f0; min-height: 100vh; padding: 40px 20px; font-family: Arial, sans-serif; color: #1a1a1a; }
    .bc-paper { max-width: 900px; margin: 0 auto; background: white; padding: 40px; box-shadow: 0 0 20px rgba(0,0,0,0.1); display: block; }
    .bc-box { border: 1px solid #ddd; padding: 15px; margin-bottom: 20px; position: relative; }

    /* Header */
    .bc-header { display: grid; grid-template-columns: 1fr 2fr 1.5fr; align-items: center; border-bottom: 2px solid #000; padding-bottom: 10px; margin-bottom: 20px; }
    .bc-logo { max-width: 120px; }
    .bc-title-container h1 { font-size: 22px; font-weight: 800; text-align: center; margin: 0; }
    .bc-refi-container { text-align: right; font-size: 20px; font-weight: bold; }
    .refi-input-ghost { border: none; font-weight: bold; font-size: 20px; width: 140px; text-align: right; outline: none; background: transparent; }

    /* Grilles */
    .bc-top-grid, .bc-middle-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0; margin-bottom: 20px; }
    .box-label { font-weight: bold; font-size: 11px; color: #666; border-bottom: 1px solid #eee; padding-bottom: 5px; margin-bottom: 10px; text-transform: uppercase; }
    .checkbox-group { display: flex; flex-direction: column; gap: 8px; }
    .summary-line { display: flex; justify-content: space-between; border-bottom: 1px solid #f0f0f0; padding: 3px 0; font-size: 13px; }
    .field { margin-bottom: 5px; font-size: 13px; }
    .bold { font-weight: bold; }

    /* Zone Technique */
    .tech-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 15px; }
    .label { font-weight: bold; font-size: 11px; text-transform: uppercase; margin-right: 5px; color: #444; display: block; margin-bottom: 5px; }
    
    .ghost-input { border: none; border-bottom: 1px dashed #2e46a6; outline: none; font-family: inherit; font-size: 13px; padding: 4px 0; background: transparent; width: 100%; }
    
    /* --- STYLE SPÉCIFIQUE POUR LE CHAMP ÉDITABLE --- */
    .editable-field { 
        background-color: #f0fdf4; 
        border-bottom: 2px solid var(--primary-green); 
        padding: 4px 8px; 
        border-radius: 4px 4px 0 0;
        cursor: pointer;
        transition: 0.2s;
    }
    .editable-field:focus { background-color: #d1fae5; outline: none; }

    /* Tableau */
    .table-wrapper { padding: 0; border: 1px solid #000; overflow: hidden; }
    .bc-table { width: 100%; border-collapse: collapse; font-size: 12px; }
    .bc-table th { background: #f0f0f0; border-bottom: 1px solid #000; border-right: 1px solid #000; padding: 8px 5px; text-align: left; font-size: 11px; text-transform: uppercase; }
    .bc-table th:last-child { border-right: none; }
    .bc-table td { border-bottom: 1px solid #000; border-right: 1px solid #000; height: 35px; vertical-align: middle; }
    .bc-table td:last-child { border-right: none; }
    .bc-table tr:last-child td { border-bottom: none; }

    /* Inputs dans tableau */
    .cell-input { width: 100%; height: 100%; border: none; background: transparent; padding: 0 5px; box-sizing: border-box; font-family: inherit; font-size: 13px; }
    .center { text-align: center; } .right { text-align: right; }
    .designation { padding: 0 8px; }
    .sub-info { font-size: 10px; color: #666; margin-top: 2px; }
    .p-0 { padding: 0 !important; }

    /* Commentaires */
    .comment-box textarea { width: 100%; border: none; border-bottom: 1px dashed #2e46a6; background: transparent; resize: vertical; outline: none; font-family: inherit; padding: 5px 0; }

    /* Footer & Actions */
    .bc-footer-info { display: flex; justify-content: space-between; font-size: 12px; margin-top: 10px; padding: 0 10px; }
    .bc-actions { display: flex; gap: 15px; margin-top: 30px; }
    .btn-cancel { flex: 1; color: white; padding: 15px; text-align: center; border-radius: 5px; text-decoration: none; font-weight: bold; display: flex; align-items: center; justify-content: center; gap: 8px; }
    .certificat-box { margin-top: 15px; padding-top: 10px; border-top: 1px dashed #ccc; }
    .certificat-label { font-weight: bold; font-size: 13px; color: #2e46a6; text-transform: uppercase; display: flex; align-items: center; gap: 8px; }
    .certificat-checkbox { width: 16px; height: 16px; accent-color: #2e46a6; cursor: not-allowed; }

    @media print {
        .no-print { display: none !important; }
        .bc-wrapper { padding: 0; background: white; }
        .bc-paper { box-shadow: none; border: none; padding: 0; margin: 0; max-width: 100%; }
        .bc-box, .table-wrapper { border: 1px solid #000; }
        .ghost-input { border-bottom: none; }
        .editable-field { background-color: transparent; border-bottom: none; padding: 0; }
    }
</style>
{% endblock %}