{% extends 'base.html.twig' %}

{% block title %}Saisie Pesée - BT {{ bt.numero }}{% endblock %}

{% block body %}
<div class="bc-wrapper">
    
    {# Le formulaire renvoie les données à la même URL #}
    <form method="POST" class="bc-paper">
        
        {# --- ENTÊTE --- #}
        <div class="bc-header">
            <div class="bc-logo-container">
                <img src="{{ asset('images/sg-galva-logo.png') }}" alt="Logo" class="bc-logo">
            </div>
            <div class="bc-title-container">
                <h1>BON DE TRAVAIL</h1>
                <p class="subtitle" style="color: var(--primary-blue); font-weight: bold; text-align: center; margin-top: 5px;">SAISIE DES POIDS ATELIER</p>
            </div>
            <div class="bc-refi-container">
                <label>N° BT -</label>
                <input type="text" class="refi-input-ghost" value="{{ bt.numero }}" readonly>
            </div>
        </div>

        {# --- AFFICHAGE DES MESSAGES FLASH (Succès) --- #}
        {% for message in app.flashes('success') %}
            <div style="background: #eff6ff; color: #1e3a8a; padding: 15px; margin-bottom: 20px; border-radius: 5px; border: 1px solid #bfdbfe; text-align: center; font-weight: bold;">
                <i class="fas fa-check-circle"></i> {{ message }}
            </div>
        {% endfor %}

        {# --- GRILLE HAUTE --- #}
        <div class="bc-top-grid">
            <div class="bc-box treatment-box">
                <p class="box-label">TRAITEMENT :</p>
                <div class="checkbox-group">
                    <label><input type="checkbox" {% if commande.isGalvanisation|default(false) %}checked{% endif %} disabled> (Galvanisation {% if commande.typeGalva and commande.typeGalva != 'CATA' %}- {{ commande.typeGalva }}{% endif %})</label>
                    <label><input type="checkbox" {% if commande.isCataphorese|default(false) %}checked{% endif %} disabled> (Cataphorèse)</label>
                </div>
            </div>
            <div class="bc-box summary-box">
                <div class="summary-line"><span>Ref. Interne :</span> <strong>{{ commande.refi }}</strong></div>
                <div class="summary-line"><span>Date :</span> <strong>{{ bt.dateCreation|date('d/m/Y') }}</strong></div>
                <div class="summary-line"><span>Nb PAQ :</span> <strong>{{ commande.fiche.totalPaquets|default('-') }}</strong></div>
                <div class="summary-line"><span>Client :</span> <strong>{{ commande.fiche.client.nom }}</strong></div>
            </div>
        </div>

        {# --- GRILLE MILIEU : ADRESSES --- #}
        <div class="bc-middle-grid">
            <div class="bc-box client-box">
                <p class="box-label">ADRESSE DE FACTURATION</p>
                <div class="frame-content">
                    <strong>{{ commande.fiche.client.nom }}</strong><br>
                    {{ commande.fiche.client.adresseFacturation|nl2br }}<br>
                    {{ commande.fiche.client.codePostal }} {{ commande.fiche.client.ville }}
                </div>
            </div>
            <div class="bc-box driver-box">
                <p class="box-label">ADRESSE DE LIVRAISON</p>
                <div class="frame-content">
                    <strong>{{ commande.fiche.client.nom }}</strong><br>
                    {{ commande.fiche.client.adresseLivraison|default(commande.fiche.client.adresseFacturation)|nl2br }}<br>
                    {{ commande.fiche.client.codePostal }} {{ commande.fiche.client.ville }}
                </div>
            </div>
        </div>

        {# --- ZONE TECHNIQUE --- #}
        <div class="bc-box">
            <div class="tech-grid">
                <div class="tech-col">
                    <span class="label">EXIGENCE PARTICULIÈRE :</span>
                    <input type="text" class="ghost-input full-width" value="{{ bt.exigenceParticuliere|default('-') }}" readonly>
                </div>
                <div class="tech-col">
                    <span class="label">REPRISE USINAGE :</span>
                    <input type="text" class="ghost-input full-width" value="{{ bt.repriseUsinage|default('-') }}" readonly>
                </div>
                
                <div class="tech-col">
                    <span class="label">DÉLAI CLIENT :</span>
                    <input type="text" class="ghost-input full-width" value="{{ bt.delaiClient ? bt.delaiClient|date('d/m/Y') : 'Non défini' }}" readonly>
                </div>
            </div>

            {# --- AFFICHAGE NON MODIFIABLE DU CERTIFICAT --- #}
            <div class="certificat-box">
                <label class="certificat-label">
                    <input type="checkbox" class="certificat-checkbox" disabled {% if bt.demandeCertificat %}checked{% endif %}>
                    Demande de certificat
                </label>
            </div>
        </div>

        {# --- TABLEAU TECHNIQUE (SAISIE DES POIDS) --- #}
        <div class="bc-box description-box table-wrapper">
            <table class="bc-table">
                <thead>
                    <tr>
                        <th width="5%">Qté</th>
                        <th width="30%">Désignation</th>
                        <th width="5%">U</th>
                        <th width="15%">Référence</th>
                        <th width="15%">Trav. Annexes</th>
                        <th width="10%" style="background: #eff6ff; color: #1e3a8a; border-bottom: 2px solid #2e46a6;"><i class="fas fa-pencil-alt"></i> Poids Kg</th>
                        <th width="20%" style="background: #eff6ff; color: #1e3a8a; border-bottom: 2px solid #2e46a6;"><i class="fas fa-pencil-alt"></i> Observations</th>
                    </tr>
                </thead>
                <tbody>
                    {% for ligne in bt.lignes %}
                        {% set nb = ligne.nbPaquets|default(1) %}
                        {% set paquets = ligne.peseePaquets %}
                        {% set isDetailed = paquets|length > 0 %}
                        
                        {# Champs cachés pour le statut global/détaillé #}
                        <input type="hidden" name="is_detailed_{{ ligne.id }}" id="is_detailed_{{ ligne.id }}" value="{{ isDetailed ? '1' : '0' }}">
                        
                        {# --- LIGNE GLOBALE --- #}
                        <tr id="row_global_{{ ligne.id }}" {% if isDetailed %}style="display: none;"{% endif %}>
                            <td class="center bold">{{ nb }}</td>
                            <td class="designation">
                                <strong>{{ ligne.description|default('Produit non précisé') }}</strong>
                                <div class="sub-info">Avant: {{ ligne.emplacement ? ligne.emplacement.nom : '-' }} | Après: {{ ligne.emplacementApresProduction ? ligne.emplacementApresProduction.nom : '-' }}</div>
                                {% if nb > 1 %}
                                    <button type="button" class="btn-detailler" onclick="toggleDetails({{ ligne.id }}, {{ nb }}, true)" style="margin-top: 5px; font-size: 10px; padding: 2px 6px; background: #e0e7ff; color: #3730a3; border: 1px solid #c7d2fe; border-radius: 3px; cursor: pointer;">
                                        <i class="fas fa-list"></i> Détailler les {{ nb }} paquets
                                    </button>
                                {% endif %}
                            </td>
                            <td class="p-0"><input type="text" class="cell-input center" value="{{ ligne.u|default('') }}" readonly></td>
                            <td class="p-0"><input type="text" class="cell-input" value="{{ ligne.reference|default('') }}" readonly></td>
                            <td class="p-0"><input type="text" class="cell-input" value="{{ ligne.travauxAnnexes|default('') }}" readonly></td>
                            
                            <td class="p-0">
                                <input type="number" step="0.01" name="poids_global_{{ ligne.id }}" id="poids_global_{{ ligne.id }}" class="cell-input right editable-field" value="{{ not isDetailed ? ligne.poids|default('') : '' }}" placeholder="Poids global...">
                            </td>
                            <td class="p-0">
                                <input type="text" name="obs_global_{{ ligne.id }}" id="obs_global_{{ ligne.id }}" class="cell-input editable-field" value="{{ not isDetailed ? ligne.observations|default('') : '' }}" placeholder="Notes globales...">
                            </td>
                        </tr>
                        
                        {# --- LIGNES DÉTAILLÉES --- #}
                        {% if nb > 1 %}
                            {% for i in 1..nb %}
                                {% set paquet = paquets[i-1] ?? null %}
                                <tr class="row_detail_{{ ligne.id }}" {% if not isDetailed %}style="display: none;"{% endif %}>
                                    {% if loop.first %}
                                        <td class="center bold" rowspan="{{ nb }}">{{ nb }}</td>
                                        <td class="designation" rowspan="{{ nb }}">
                                            <strong>{{ ligne.description|default('Produit non précisé') }}</strong>
                                            <div class="sub-info">Avant: {{ ligne.emplacement ? ligne.emplacement.nom : '-' }} | Après: {{ ligne.emplacementApresProduction ? ligne.emplacementApresProduction.nom : '-' }}</div>
                                            <button type="button" class="btn-global" onclick="toggleDetails({{ ligne.id }}, {{ nb }}, false)" style="margin-top: 5px; font-size: 10px; padding: 2px 6px; background: #fef2f2; color: #991b1b; border: 1px solid #fecaca; border-radius: 3px; cursor: pointer;">
                                                <i class="fas fa-layer-group"></i> Grouper (Poids global)
                                            </button>
                                        </td>
                                        <td class="p-0" rowspan="{{ nb }}"><input type="text" class="cell-input center" value="{{ ligne.u|default('') }}" readonly></td>
                                        <td class="p-0" rowspan="{{ nb }}"><input type="text" class="cell-input" value="{{ ligne.reference|default('') }}" readonly></td>
                                        <td class="p-0" rowspan="{{ nb }}"><input type="text" class="cell-input" value="{{ ligne.travauxAnnexes|default('') }}" readonly></td>
                                    {% endif %}
                                    
                                    <td class="p-0">
                                        <div style="display: flex; align-items: center; height: 100%;">
                                            <span style="font-size: 10px; color: #666; margin-left: 5px;">P{{ i }}</span>
                                            <input type="number" step="0.01" name="poids_detail_{{ ligne.id }}[{{ i }}]" class="cell-input right editable-field" value="{{ isDetailed and paquet ? paquet.poids : '' }}" placeholder="0.00">
                                        </div>
                                    </td>
                                    <td class="p-0">
                                        <input type="text" name="obs_detail_{{ ligne.id }}[{{ i }}]" class="cell-input editable-field" value="{{ isDetailed and paquet ? paquet.observations : '' }}" placeholder="Note P{{ i }}...">
                                    </td>
                                </tr>
                            {% endfor %}
                        {% endif %}
                    {% else %}
                        <tr><td colspan="7" class="center muted">Aucune ligne trouvée.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>        

        {# Champ caché qui remplace la checkbox #}
        <input type="hidden" name="validation_pesee" id="hidden_validation_pesee" value="0">

        <div class="bc-actions no-print">
            <a href="javascript:history.back()" class="btn-cancel" style="background-color: #6b7280; color: white;">
                <i class="fas fa-arrow-left"></i> Retour au planning
            </a>
            
            <button type="submit" class="btn-confirm" style="flex: 2; background-color: var(--primary-blue); color: white; border: none; border-radius: 5px; cursor: pointer; font-weight: bold; font-size: 16px; transition: 0.2s;">
                <i class="fas fa-save"></i> Enregistrer
            </button>
        </div>

    </form>
</div>

<script>
    function toggleDetails(ligneId, nbPaquets, showDetails) {
        document.getElementById('is_detailed_' + ligneId).value = showDetails ? '1' : '0';
        
        const rowGlobal = document.getElementById('row_global_' + ligneId);
        const rowsDetail = document.querySelectorAll('.row_detail_' + ligneId);
        
        if (showDetails) {
            rowGlobal.style.display = 'none';
            rowsDetail.forEach(row => row.style.display = 'table-row');
        } else {
            rowGlobal.style.display = 'table-row';
            rowsDetail.forEach(row => row.style.display = 'none');
        }
    }

    document.addEventListener('DOMContentLoaded', function() {
        const form = document.querySelector('form');
        const poidsInputs = document.querySelectorAll('input[name^="poids["]');
        const hiddenValidation = document.getElementById('hidden_validation_pesee');

        form.addEventListener('submit', function(e) {
            // ON BLOQUE L'ENVOI DU FORMULAIRE TEMPORAIREMENT POUR LIRE LES LOGS
            e.preventDefault(); 

            let toutesLesPeseesSontRemplies = true;
            let aumoinsUneLigne = false; // On l'activera si au moins une ligne existe

            console.log("--- DÉBUT DE LA VÉRIFICATION ---");

            // Pour chaque ligne de déchargement, on cherche son input caché is_detailed
            const detailedInputs = document.querySelectorAll('input[name^="is_detailed_"]');
            
            if (detailedInputs.length > 0) {
                aumoinsUneLigne = true;
            }

            detailedInputs.forEach(function(input) {
                let ligneId = input.id.replace('is_detailed_', '');
                let isDetailed = input.value === '1';
                
                if (isDetailed) {
                    // On vérifie les champs de détails
                    let poidsDetailsInputs = document.querySelectorAll('input[name^="poids_detail_' + ligneId + '"]');
                    poidsDetailsInputs.forEach(function(pInput, index) {
                        let stringValue = pInput.value.trim().replace(',', '.');
                        let valeur = parseFloat(stringValue);
                        
                        if (stringValue === '' || isNaN(valeur) || valeur <= 0) {
                            toutesLesPeseesSontRemplies = false;
                            console.log(`Ligne ${ligneId} - Paquet ${index + 1} : MANQUANT OU INVALIDE`);
                        }
                    });
                } else {
                    // On vérifie le champ global
                    let pInput = document.getElementById('poids_global_' + ligneId);
                    if (pInput) {
                        let stringValue = pInput.value.trim().replace(',', '.');
                        let valeur = parseFloat(stringValue);
                        
                        if (stringValue === '' || isNaN(valeur) || valeur <= 0) {
                            toutesLesPeseesSontRemplies = false;
                            console.log(`Ligne ${ligneId} - Global : MANQUANT OU INVALIDE`);
                        }
                    }
                }
            });

            if (toutesLesPeseesSontRemplies && aumoinsUneLigne) {
                hiddenValidation.value = 'on';
                console.log("RÉSULTAT : TOUT EST BON ! On envoie 'on'.");
            } else {
                hiddenValidation.value = '0';
                console.log("RÉSULTAT : IL MANQUE AU MOINS UN POIDS ! On envoie '0'.");
            }

            console.log("--- FIN DE LA VÉRIFICATION ---");
            
            // On soumet le formulaire
            form.submit();
        });
    });
</script>

<style>
    /* ... Tes styles existants ... */
    :root {
        --primary-blue: #2e46a6;
    }
    .bc-wrapper { background: #f0f0f0; min-height: 100vh; padding: 40px 20px; font-family: Arial, sans-serif; color: #1a1a1a; }
    .bc-paper { max-width: 1000px; margin: 0 auto; background: white; padding: 40px; box-shadow: 0 0 20px rgba(0,0,0,0.1); display: block; }
    .bc-box { border: 1px solid #ddd; padding: 15px; margin-bottom: 20px; position: relative; }

    /* Header */
    .bc-header { display: grid; grid-template-columns: 1fr 2fr 1.5fr; align-items: center; border-bottom: 2px solid #000; padding-bottom: 10px; margin-bottom: 20px; }
    .bc-logo { max-width: 120px; }
    .bc-title-container h1 { font-size: 22px; font-weight: 800; text-align: center; margin: 0; }
    .bc-refi-container { text-align: right; font-size: 20px; font-weight: bold; }
    .refi-input-ghost { border: none; font-weight: bold; font-size: 20px; width: 140px; text-align: right; outline: none; background: transparent; }

    /* Grilles */
    .bc-top-grid, .bc-middle-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0; margin-bottom: 20px; }
    .box-label { font-weight: bold; font-size: 11px; color: #666; border-bottom: 1px solid #eee; padding-bottom: 5px; margin-bottom: 10px; text-transform: uppercase; }
    .checkbox-group { display: flex; flex-direction: column; gap: 8px; }
    .summary-line { display: flex; justify-content: space-between; border-bottom: 1px solid #f0f0f0; padding: 3px 0; font-size: 13px; }
    .bold { font-weight: bold; }
    .certificat-box { margin-top: 15px; padding-top: 10px; border-top: 1px dashed #ccc; }
    .certificat-label { font-weight: bold; font-size: 13px; color: var(--primary-blue); text-transform: uppercase; display: flex; align-items: center; gap: 8px; }
    .certificat-checkbox { width: 16px; height: 16px; accent-color: var(--primary-blue); cursor: not-allowed; }

    /* Zone Technique */
    .tech-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 15px; }
    .label { font-weight: bold; font-size: 11px; text-transform: uppercase; margin-right: 5px; color: #444; display: block; margin-bottom: 5px; }
    .ghost-input { border: none; outline: none; font-family: inherit; font-size: 13px; padding: 4px 0; background: transparent; width: 100%; color: #6b7280; font-style: italic; }
    
    /* Tableau */
    .table-wrapper { padding: 0; border: 1px solid #000; overflow: hidden; }
    .bc-table { width: 100%; border-collapse: collapse; font-size: 12px; }
    .bc-table th { background: #f0f0f0; border-bottom: 1px solid #000; border-right: 1px solid #000; padding: 8px 5px; text-align: left; font-size: 11px; text-transform: uppercase; }
    .bc-table th:last-child { border-right: none; }
    .bc-table td { border-bottom: 1px solid #000; border-right: 1px solid #000; height: 35px; vertical-align: middle; }
    .bc-table td:last-child { border-right: none; }
    .bc-table tr:last-child td { border-bottom: none; }

    /* Inputs dans tableau */
    .cell-input { width: 100%; height: 100%; border: none; background: transparent; padding: 0 5px; box-sizing: border-box; font-family: inherit; font-size: 13px; }
    .center { text-align: center; } .right { text-align: right; }
    .designation { padding: 0 8px; }
    .sub-info { font-size: 10px; color: #666; margin-top: 2px; }
    .p-0 { padding: 0 !important; }

    .editable-field { 
        background-color: #eff6ff; 
        cursor: text;
        transition: 0.2s;
    }
    .editable-field:focus { background-color: #dbeafe; outline: 2px solid var(--primary-blue); outline-offset: -2px; }

    /* Footer & Actions */
    .bc-actions { display: flex; gap: 15px; margin-top: 30px; }
    .btn-cancel { flex: 1; color: white; padding: 15px; text-align: center; border-radius: 5px; text-decoration: none; font-weight: bold; display: flex; align-items: center; justify-content: center; gap: 8px; transition: 0.2s; }
    .btn-confirm:hover { background-color: #1e3a8a !important; }
    .btn-cancel:hover { background-color: #4b5563 !important; }
</style>
{% endblock %}