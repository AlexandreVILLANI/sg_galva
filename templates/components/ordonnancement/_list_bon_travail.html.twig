<section id="ordo-bons-travail" class="content-section" style="display: none;">
    <div class="section-header">
        <h2 class="section-title">Bons de Travail</h2>
    </div>

    {# --- BARRE DE FILTRES BT --- #}
    <div class="filter-bar">
        <div class="filter-form">
            <div class="filter-group">
                <i class="fas fa-search"></i>
                <input type="text" id="filterGeneralOrdoBT" placeholder="N° BT, REFI ou Client...">
            </div>

            <div class="filter-group">
                <i class="fas fa-calendar-alt"></i>
                <input type="date" id="filterDateOrdoBT">
            </div>

            <div class="filter-group">
                <i class="fas fa-tasks"></i>
                <select id="filterStatusOrdoBT">
                    <option value="">Tous les états</option>
                    <option value="urgent">Urgent</option>
                    <option value="normal">Normal</option>
                </select>
            </div>
            
            <a href="#" class="btn-reset" id="resetOrdoBTFilters" title="Réinitialiser">
                <i class="fas fa-sync-alt"></i>
            </a>
        </div>
    </div>

    {# --- TABLEAU --- #}
    <div class="table-container">
        <div class="table-grid header bt-grid-template">
            <span>N° BT / Date</span>
            <span>REFI Associé</span>
            <span>Client</span>
            <span>Délai Client</span>
            <span style="text-align: center;">Actions</span>
        </div>

        <div id="ordoBtTableBody">
            {% for bt in bons_travail|default([]) %}
                <div class="table-grid row clickable-row bt-grid-template" 
                     data-btnum="{{ bt.numero|lower }}"
                     data-refi="{{ bt.bonCommande.refi|lower }}" 
                     data-client="{{ bt.bonCommande.client.nom|lower }}" 
                     data-date="{{ bt.dateCreation|date('Y-m-d') }}"
                     data-status="{{ bt.exigenceParticuliere ? 'urgent' : 'normal' }}"
                     onclick="alert('Ouverture du module de planification pour ce BT (à venir)')">
                    
                    <div class="ref-cell-group">
                        <span class="ref-cell" style="color: var(--primary-green);">{{ bt.numero }}</span>
                        <small class="date-subtext">Créé le {{ bt.dateCreation|date('d/m/Y') }}</small>
                    </div>

                    <span class="ref-cell">{{ bt.bonCommande.refi }}</span>

                    <span class="client-cell" style="font-weight: 500;">{{ bt.bonCommande.client.nom }}</span>

                    <span>
                        <span class="badge-info">
                            <i class="far fa-clock"></i> {{ bt.delaiClient ? bt.delaiClient|date('d/m/Y') : 'Non défini' }}
                        </span>
                    </span>

                    <span class="actions-cell" style="display: flex; justify-content: center;" onclick="event.stopPropagation();">
                        <a href="#" class="btn-edit-simple" title="Planifier ce BT">
                            <i class="fas fa-calendar-plus" style="color: var(--primary-green);"></i>
                        </a>
                    </span>
                </div>
            {% else %}
                <div class="no-data">
                    <i class="fas fa-clipboard-list" style="font-size: 24px; margin-bottom: 10px; display: block; opacity: 0.5;"></i>
                    <span>Aucun bon de travail en attente de planification.</span>
                </div>
            {% endfor %}
        </div>
    </div>
</section>

<script>
function setupOrdoBTFilters() {
    const inputSearch = document.getElementById('filterGeneralOrdoBT');
    const inputDate = document.getElementById('filterDateOrdoBT');
    const selectStatus = document.getElementById('filterStatusOrdoBT');
    const btnReset = document.getElementById('resetOrdoBTFilters');
    
    const rows = document.querySelectorAll('#ordoBtTableBody .row');

    if (!inputSearch || rows.length === 0) return;

    function filterTable() {
        const valSearch = inputSearch.value.toLowerCase().trim();
        const valDate = inputDate.value;
        const valStatus = selectStatus.value;

        rows.forEach(row => {
            const rowBt = row.dataset.btnum || "";
            const rowRefi = row.dataset.refi || "";
            const rowClient = row.dataset.client || "";
            const rowDate = row.dataset.date || "";
            const rowStatus = row.dataset.status || "";

            const matchesSearch = rowBt.includes(valSearch) || rowRefi.includes(valSearch) || rowClient.includes(valSearch);
            const matchesDate = valDate === "" || rowDate === valDate;
            const matchesStatus = valStatus === "" || rowStatus === valStatus;

            row.style.display = (matchesSearch && matchesDate && matchesStatus) ? 'grid' : 'none';
        });
    }

    [inputSearch, inputDate, selectStatus].forEach(el => {
        el.addEventListener(el.tagName === 'SELECT' || el.type === 'date' ? 'change' : 'input', filterTable);
    });

    if (btnReset) {
        btnReset.addEventListener('click', (e) => {
            e.preventDefault();
            inputSearch.value = '';
            inputDate.value = '';
            selectStatus.value = '';
            filterTable();
        });
    }
}

// On s'assure que le filtre se lance bien quand on arrive sur la page
document.addEventListener('turbo:load', () => {
    if (typeof setupOrdoBTFilters === 'function') {
        setupOrdoBTFilters();
    }
});
</script>

<style>
    /* Template de grille spécifique pour le BT */
    .bt-grid-template { 
        display: grid;
        grid-template-columns: 160px 140px 1fr 140px 80px !important; 
        align-items: center; 
        padding: 12px 20px;
    }

    /* Badge spécifique pour les délais */
    .badge-info {
        background: #f0f9ff; color: #0369a1; border: 1px solid #e0f2fe; 
        padding: 4px 8px; border-radius: 4px; font-size: 11px; font-weight: 600;
    }
    .badge-info i { margin-right: 4px; font-size: 10px; }
    
    /* Bouton d'action et couleurs (Adapté au thème Vert de l'Ordonnancement) */
    .btn-edit-simple { font-size: 16px; transition: transform 0.2s; text-decoration: none; }
    .btn-edit-simple:hover { transform: scale(1.2); }
    
    .table-grid.row { border-bottom: 1px solid #f9fafb; color: #374151; transition: background 0.2s; }
    .clickable-row { cursor: pointer; }
    .clickable-row:hover { background-color: #f0fdf4 !important; } /* Un hover vert très léger */
</style>