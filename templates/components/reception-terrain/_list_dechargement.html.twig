<section id="list-dechargement" class="content-section">
    <div class="section-header">
        <h2 class="section-title">Historique des déchargements</h2>
    </div>

    {# --- BARRE DE FILTRES (Version sans rechargement) --- #}
    <div class="filter-bar">
        <div class="filter-form"> {# Changé de <form> à <div> #}
            <div class="filter-group">
                <i class="fas fa-search"></i>
                <input type="text" id="filterClientHisto" placeholder="Client...">
            </div>
            <div class="filter-group">
                <i class="fas fa-user"></i>
                <input type="text" id="filterCaristeHisto" placeholder="Cariste...">
            </div>
            <div class="filter-group">
                <i class="fas fa-calendar-alt"></i>
                <input type="date" id="filterDateHisto">
            </div>
            
            <a href="#" class="btn-reset" id="resetHistoFilters" title="Réinitialiser">
                <i class="fas fa-sync-alt"></i>
            </a>
        </div>
    </div>
    
    <div class="table-container">
        <div class="table-grid header">
            <span>Date</span>
            <span>Cariste</span>
            <span>Client</span>
            <span>Paquets</span>
            <span>Statut</span>
        </div>

        <div id="histoTableBody">
            {% for fiche in fiches %}
               <div class="table-grid row clickable-row" 
                    data-client="{{ fiche.client.nom|lower }}" 
                    data-cariste="{{ fiche.cariste.prenom|lower }}" 
                    data-date="{{ fiche.date|date('Y-m-d') }}"
                    onclick="window.location='{{ path('app_dechargement_show', {'id': fiche.id}) }}'">
                    
                    <span class="date-cell">{{ fiche.date|date('d/m/Y H:i') }}</span>
                    <span class="user-cell">{{ fiche.cariste.prenom|default('Inconnu') }}</span>
                    <span class="client-cell">
                        {% if fiche.client.nom == 'À définir' %}
                            <span class="badge badge-at-definir">
                                <i class="fas fa-exclamation-circle"></i> À définir
                            </span>
                        {% else %}
                            {{ fiche.client.nom }}
                        {% endif %}
                    </span>
                    <span class="total-cell"><strong>{{ fiche.totalPaquets }}</strong></span>
                    <span><span class="badge badge-success">Validé</span></span>
                </div>
            {% else %}
                <div class="table-grid row no-data">
                    <span>Aucun déchargement trouvé.</span>
                </div>
            {% endfor %}
        </div>
    </div>
</section>
<script>

function setupHistoFilters() {
        const inputClient = document.getElementById('filterClientHisto');
        const inputCariste = document.getElementById('filterCaristeHisto');
        const inputDate = document.getElementById('filterDateHisto');
        const btnReset = document.getElementById('resetHistoFilters');
        
        // On sélectionne les lignes présentes dans le DOM au moment de l'appel
        const rows = document.querySelectorAll('#histoTableBody .row:not(.no-data)');

        // Sécurité : Si on n'est pas sur la bonne vue, on ne fait rien
        if (!inputClient || rows.length === 0) return;

        console.log("Filtres Historique initialisés");

        function filterHisto() {
            const valClient = inputClient.value.toLowerCase().trim();
            const valCariste = inputCariste.value.toLowerCase().trim();
            const valDate = inputDate.value;

            rows.forEach(row => {
                const matchesClient = row.dataset.client.includes(valClient);
                const matchesCariste = row.dataset.cariste.includes(valCariste);
                const matchesDate = valDate === "" || row.dataset.date === valDate;

                if (matchesClient && matchesCariste && matchesDate) {
                    row.style.display = 'grid';
                } else {
                    row.style.display = 'none';
                }
            });
        }

        // Nettoyage des anciens écouteurs pour éviter les accumulations de mémoire
        inputClient.removeEventListener('input', filterHisto);
        inputCariste.removeEventListener('input', filterHisto);
        inputDate.removeEventListener('change', filterHisto);

        // Attachement des nouveaux écouteurs
        inputClient.addEventListener('input', filterHisto);
        inputCariste.addEventListener('input', filterHisto);
        inputDate.addEventListener('change', filterHisto);

        if (btnReset) {
            btnReset.addEventListener('click', function(e) {
                e.preventDefault();
                inputClient.value = '';
                inputCariste.value = '';
                inputDate.value = '';
                filterHisto();
            });
        }
    }

    // --- DOUBLE SÉCURITÉ ---
    // 1. Pour les changements de page via Turbo
    document.addEventListener('turbo:load', setupHistoFilters);

    // 2. Pour le premier chargement ou l'inclusion directe
    setupHistoFilters();

    // 3. Pour le changement d'onglet (Sidebar)
    document.querySelectorAll('.nav-item').forEach(item => {
        item.addEventListener('click', () => {
            setTimeout(setupHistoFilters, 50);
        });
    });
document.addEventListener('DOMContentLoaded', function() {
    const inputClient = document.getElementById('filterClientHisto');
    const inputCariste = document.getElementById('filterCaristeHisto');
    const inputDate = document.getElementById('filterDateHisto');
    const btnReset = document.getElementById('resetHistoFilters');
    
    // On sélectionne toutes les lignes une seule fois pour la performance
    const rows = document.querySelectorAll('#histoTableBody .row:not(.no-data)');

    function filterHisto() {
        const valClient = inputClient.value.toLowerCase().trim();
        const valCariste = inputCariste.value.toLowerCase().trim();
        const valDate = inputDate.value;

        rows.forEach(row => {
            const matchesClient = row.dataset.client.includes(valClient);
            const matchesCariste = row.dataset.cariste.includes(valCariste);
            const matchesDate = valDate === "" || row.dataset.date === valDate;

            // Si tous les critères correspondent, on affiche
            if (matchesClient && matchesCariste && matchesDate) {
                row.style.display = 'grid';
            } else {
                row.style.display = 'none';
            }
        });
    }

    // ÉCOUTEURS D'ÉVÉNEMENTS "LIVE"
    inputClient.addEventListener('input', filterHisto); // Filtre à chaque lettre
    inputCariste.addEventListener('input', filterHisto); // Filtre à chaque lettre
    inputDate.addEventListener('change', filterHisto);  // Filtre dès que la date change

    // RESET
    btnReset.addEventListener('click', function(e) {
        e.preventDefault();
        inputClient.value = '';
        inputCariste.value = '';
        inputDate.value = '';
        filterHisto(); // Réaffiche tout
    });
});
</script>
<style>
