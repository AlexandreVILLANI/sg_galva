        background: #ecfdf5;
        color: #10b981;
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 11px;
        font-weight: 600;
    }

    .total-cell strong { color: #2e46a6; }

    /* Filter Bar Styles */
    .filter-bar {
        background: white;
        padding: 15px;
        margin-bottom: 20px;
        border-radius: 8px;
        border: 1px solid #e5e7eb;
    }
    .filter-form {
        display: flex;
        gap: 12px;
        align-items: center;
    }
    .filter-group {
        display: flex;
        align-items: center;
        background: #f9fafb;
        border: 1px solid #e5e7eb;
        padding: 8px 12px;
        border-radius: 6px;
        flex: 1;
    }
    .filter-group i { color: #9ca3af; margin-right: 8px; }
    .filter-group input {
        border: none;
        background: transparent;
        font-size: 13px;
        outline: none;
        width: 100%;
    }
    .btn-filter {
        background: #2e46a6;
        color: white;
        border: none;
        padding: 9px 18px;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
    }
    .btn-reset {
        color: #6b7280;
        background: #f3f4f6; /* Fond gris clair */
        width: 38px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 6px;
        text-decoration: none;
        transition: all 0.2s ease;
        border: 1px solid #e5e7eb;
    }

    .btn-reset:hover {
        background: #e5e7eb;
        color: #2e46a6; /* Devient bleu SG au survol */
        border-color: #2e46a6;
        transform: rotate(180px); /* Petit effet de rotation sympa */
    }

    .btn-reset i {
        font-size: 14px;
    }

    .badge-at-definir {
        background: #fffbeb;
        color: #92400e;
        border: 1px solid #fde68a;
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 11px;
        font-weight: 600;
    }

    /* Animation de rotation pour le bouton reset (Ton effet sympa) */
    .btn-reset:hover {
        background: #e5e7eb;
        color: #2e46a6;
        border-color: #2e46a6;
        transform: rotate(180deg);
    }

    /* On s'assure que le champ date a le même look que les autres */
    .filter-group input[type="date"] {
        cursor: pointer;
