<div class="admin-card">
    <div style="padding: 24px;">
        <div class="card-header-flex">
            <div>
                <h2 class="admin-section-title">Déchargements d'Urgence</h2>
                <p class="admin-section-subtitle">Historique des fiches créées en urgence</p>
            </div>
        </div>

        <div class="glass-filter-bar">
            <div class="filter-inputs">
                <div class="modern-input-group">
                    <i class="fas fa-user-tag"></i>
                    <input type="text" id="filterClientUrgence" placeholder="Filtrer par Client...">
                </div>
            </div>
        </div>

        <div class="modern-table-wrapper">
            <div class="grid-header">
                <div>DATE</div>
                <div>CLIENT</div>
                <div>STATUT</div>
                <div class="center">LIGNES</div>
                <div class="right">ACTIONS</div>
            </div>

            <div id="urgenceTableBody">
                {% for urgence in urgences %}
                    <div class="grid-row clickable-row" data-client="{{ urgence.client ? urgence.client.nom|lower : '' }}" onclick="window.location.href='{{ path('app_pesee_urgence_edit', {'id': urgence.id}) }}'" style="cursor: pointer;">
                        <span class="date-cell">
                            {{ urgence.dateCreation|date('d/m/Y') }}
                            <small>{{ urgence.dateCreation|date('H:i') }}</small>
                        </span>
                        <span class="client-cell">
                            <span class="client-name">{{ urgence.client ? urgence.client.nom : 'Non renseigné' }}</span>
                        </span>
                        <span>
                            <span class="stat-badge" style="background: #fee2e2; color: #ef4444;">{{ urgence.statut }}</span>
                        </span>
                        <span class="center">
                            <span class="paquet-chip">{{ urgence.lignes|length }}</span>
                        </span>
                        <span class="right" style="display: flex; justify-content: flex-end; gap: 8px;">
                            <a href="{{ path('app_pesee_urgence_edit', {'id': urgence.id}) }}" class="btn-view" title="Saisir les poids" style="background: var(--indigo-50); color: var(--indigo-600); display:inline-flex; padding: 6px 10px; border-radius: 4px; text-decoration: none;">
                                <i class="fas fa-weight"></i> Saisir
                            </a>
                        </span>
                    </div>
                {% else %}
                    <div class="empty-state">
                        <div class="empty-icon"><i class="fas fa-folder-open"></i></div>
                        <p>Aucun déchargement d'urgence enregistré.</p>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
</div>

<style>
    :root {
        --indigo-600: #4f46e5;
        --indigo-50: #eef2ff;
        --slate-500: #64748b;
        --slate-800: #1e293b;
        --emerald-500: #10b981;
        --amber-500: #f59e0b;
        --red-500: #ef4444;
        --border-subtle: #f1f5f9;
    }

    /* CARD DESIGN */
    .admin-card { background: #fff; border-radius: 12px; }
    .card-header-flex { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 24px; }
    .admin-section-title { font-size: 1.25rem; font-weight: 700; color: var(--slate-800); margin: 0; }
    .admin-section-subtitle { font-size: 0.875rem; color: var(--slate-500); margin-top: 4px; }
    .stat-badge { background: var(--indigo-50); color: var(--indigo-600); padding: 6px 12px; border-radius: 20px; font-size: 0.75rem; font-weight: 600; }

    /* FILTERS */
    .glass-filter-bar { display: flex; gap: 12px; background: var(--bg-gray); padding: 12px; border-radius: 10px; border: 1px solid var(--border-color); margin-bottom: 20px; align-items: center; }
    .filter-inputs { display: flex; gap: 12px; flex-grow: 1; }
    .modern-input-group { position: relative; flex: 1; }
    .modern-input-group i { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: var(--slate-400); font-size: 0.8rem; }
    .modern-input-group input { width: 100%; padding: 8px 12px 8px 34px; border: 1px solid transparent; border-radius: 6px; font-size: 0.85rem; transition: 0.2s; outline: none; background: white; }
    .modern-input-group input:focus { border-color: var(--indigo-600); box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1); }

    .btn-icon-reset { background: white; border: 1px solid var(--border-color); width: 36px; height: 36px; border-radius: 6px; cursor: pointer; color: var(--slate-500); transition: 0.3s; }
    .btn-icon-reset:hover { color: var(--indigo-600); border-color: var(--indigo-600); transform: rotate(180deg); }

    /* MODERN GRID TABLE */
    .modern-table-wrapper { border: 1px solid var(--border-subtle); border-radius: 8px; overflow: hidden; }
    .grid-header { display: grid; grid-template-columns: 180px 180px 1fr 120px 110px; background: var(--bg-gray); padding: 12px 20px; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 700; color: var(--slate-500); border-bottom: 1px solid var(--border-subtle); }
    .grid-row { display: grid; grid-template-columns: 180px 180px 1fr 120px 110px; padding: 14px 20px; align-items: center; border-bottom: 1px solid var(--border-subtle); transition: 0.2s; font-size: 0.9rem; }
    .grid-row:last-child { border-bottom: none; }
    .clickable-row:hover { background: #f8faff; cursor: pointer; }

    /* CELLS & CONTENT */
    .date-cell { color: var(--slate-800); font-weight: 500; }
    .date-cell small { color: var(--slate-400); margin-left: 4px; }
    .user-cell { display: flex; align-items: center; gap: 10px; color: var(--slate-800); }
    .user-avatar { width: 24px; height: 24px; background: var(--indigo-600); color: white; border-radius: 6px; font-size: 0.65rem; display: flex; align-items: center; justify-content: center; font-weight: 800; }
    .client-name { color: var(--indigo-600); font-weight: 600; }
    .paquet-chip { background: #f1f5f9; padding: 4px 10px; border-radius: 6px; font-size: 0.75rem; font-weight: 700; color: var(--slate-800); }

    /* ACTION BUTTON */
    .btn-delete { background: #fee2e2; color: var(--red-500); border: none; width: 32px; height: 32px; border-radius: 6px; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: 0.2s; }
    .btn-delete:hover { background: var(--red-500); color: white; transform: scale(1.05); }

    /* UTILS */
    .center { text-align: center; }
    .right { text-align: right; }
    .hidden-row { display: none !important; }
    .pulse { animation: pulse-warn 2s infinite; }
    @keyframes pulse-warn { 0% { opacity: 1; } 50% { opacity: 0.6; } 100% { opacity: 1; } }

    .empty-state { padding: 60px; text-align: center; color: var(--slate-400); }
    .empty-icon { font-size: 2rem; margin-bottom: 12px; opacity: 0.3; }
</style>
