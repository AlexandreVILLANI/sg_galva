<div class="admin-section-header">
    <div class="header-left">
        <h2>Gestion des Utilisateurs</h2>
        <p class="subtitle">Liste des comptes et accès.</p>
    </div>
    <div class="header-right">
        <a href="{{ path('app_admin_user_new') }}" class="btn-create btn-primary shadow-sm">
            <i class="fas fa-user-plus"></i> Nouveau Compte
        </a>
    </div>
</div>

<div class="admin-card">
    <table class="admin-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Identifiant (Login)</th>
                <th>Prénom</th>
                <th>Rôle / Équipe</th>
                <th>Accès</th>
                <th class="text-right">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for user in users %}
                <tr>
                    <td><span class="badge-id">#{{ user.id }}</span></td>
                    
                    <td>
                        <div class="user-login">
                            <strong>{{ user.username }}</strong>
                        </div>
                    </td>
                    
                    <td>{{ user.prenom }}</td>
                    
                    <td>
                        <span class="badge-role role-{{ user.roles[0]|lower|replace({'role_': ''}) }}">
                            {{ user.userRole ? user.userRole.nom : 'Non défini' }}
                        </span>
                    </td>
                    
                    <td>
                        {% if user.typeAcces == 'LIEN' %}
                            <span class="access-tag link-tag" style="margin-bottom: 5px; display: inline-block;"><i class="fas fa-link"></i> Lien d'accès</span>
                            {% if user.token %}
                                <br>
                                <button type="button" class="btn-copy-link" onclick="copyToClipboard('{{ url('app_magic_login', {'token': user.token}) }}', this)" title="Copier le lien magique">
                                    <i class="fas fa-copy"></i> Copier
                                </button>
                            {% endif %}
                        {% else %}
                            <span class="access-tag pass-tag"><i class="fas fa-key"></i> Mot de passe</span>
                        {% endif %}
                    </td>

                    <td class="text-right actions-cell">
                        <a href="{{ path('app_admin_user_edit', {'id': user.id}) }}" class="btn-action btn-edit active-action" title="Modifier le compte">
                            <i class="fas fa-edit"></i>
                        </a>
                        {% if user.id == app.user.id %}
                            {# Si c'est notre propre compte, on met un bouton gris inactif #}
                            <button class="btn-action" title="C'est votre compte actuel" disabled style="background: #9ca3af; cursor: not-allowed;">
                                <i class="fas fa-user-shield"></i>
                            </button>
                        {% else %}
                            {# Si c'est un autre compte, on affiche la vraie corbeille #}
                            <form method="post" action="{{ path('app_admin_user_delete', {'id': user.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer le compte de {{ user.prenom }} ? Cette action est irréversible.');" style="margin: 0;">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_user' ~ user.id) }}">
                                <button type="submit" class="btn-action btn-delete active-action" title="Supprimer ce compte">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6" class="text-center empty-text">Aucun utilisateur trouvé.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

<script>
function copyToClipboard(text, btnElement) {
    navigator.clipboard.writeText(text).then(function() {
        const originalHtml = btnElement.innerHTML;
        btnElement.innerHTML = '<i class="fas fa-check"></i> Copié !';
        btnElement.style.background = '#10b981';
        btnElement.style.color = 'white';
        btnElement.style.borderColor = '#10b981';
        setTimeout(function() {
            btnElement.innerHTML = originalHtml;
            btnElement.style.background = '';
            btnElement.style.color = '';
            btnElement.style.borderColor = '';
        }, 2000);
    }).catch(function(err) {
        console.error('Erreur lors de la copie du lien : ', err);
        alert("Impossible de copier le lien.");
    });
}
</script>

<style>
    /* Styles spécifiques à l'onglet Utilisateurs */
    .admin-section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
        padding-bottom: 15px;
        border-bottom: 2px solid #e5e7eb;
    }
    .admin-section-header h2 { margin: 0; color: #111827; font-size: 24px; font-weight: 800; }
    .subtitle { margin: 5px 0 0 0; color: #6b7280; font-size: 14px; }
    
    .btn-create {
        display: inline-flex; align-items: center; gap: 8px;
        background: #4f46e5; color: white; padding: 10px 20px;
        border-radius: 8px; text-decoration: none; font-weight: 600;
        transition: 0.2s;
    }
    .btn-create:hover { background: #4338ca; transform: translateY(-1px); }
    
    .badge-id { background: #f3f4f6; color: #6b7280; padding: 4px 8px; border-radius: 6px; font-weight: 700; font-size: 12px; }
    
    .badge-role {
        padding: 4px 10px; border-radius: 20px; font-size: 12px; font-weight: 700;
        background: #e0e7ff; color: #4338ca; /* Par défaut */
    }
    
    /* Couleurs personnalisées selon les rôles si besoin */
    .role-admin { background: #fee2e2; color: #b91c1c; }
    .role-chef_equipe { background: #fef3c7; color: #b45309; }
    .role-cariste { background: #dcfce7; color: #15803d; }
    
    .access-tag { display: inline-flex; align-items: center; gap: 5px; font-size: 12px; font-weight: 600; padding: 4px 8px; border-radius: 4px; }
    .link-tag { background: #f0fdfa; color: #0f766e; border: 1px dashed #0f766e; }
    .pass-tag { background: #fff7ed; color: #c2410c; border: 1px dashed #c2410c; }
    
    .btn-copy-link {
        background: transparent;
        border: 1px solid #d1d5db;
        border-radius: 4px;
        padding: 3px 8px;
        font-size: 11px;
        color: #4b5563;
        cursor: pointer;
        transition: 0.2s;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }
    .btn-copy-link:hover {
        background: #f3f4f6;
        border-color: #9ca3af;
    }
    
    /* --- STYLES DES BOUTONS D'ACTION --- */
    .actions-cell { 
        display: flex; 
        gap: 8px; 
        justify-content: flex-end; 
        align-items: center; /* Aligne les boutons parfaitement sur la même ligne */
    }
    
    .btn-action { 
        /* On force le bouton à être un carré parfait avec l'icône centrée */
        display: inline-flex; 
        align-items: center; 
        justify-content: center;
        width: 34px; 
        height: 34px; 
        padding: 0;
        border: none; 
        border-radius: 6px; 
        color: white; 
        text-decoration: none;
        font-size: 14px;
        transition: all 0.2s ease;
    }
    .active-action {
        cursor: pointer;
        opacity: 1;
    }
    .active-action:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    }
    .disabled-action {
        cursor: not-allowed; 
        opacity: 0.4;
    }
    .btn-edit { background: #3b82f6; }
    .btn-edit.active-action:hover { background: #2563eb; } 
    .btn-delete { background: #ef4444; }
</style>