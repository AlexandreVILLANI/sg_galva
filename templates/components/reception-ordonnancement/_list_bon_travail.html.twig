<section id="list-bons-travail" class="content-section" style="display: none;">
    <div class="section-header">
        <h2 class="section-title">Bons de Travail</h2>
    </div>

    {# --- AFFICHAGE DES MESSAGES D'ERREUR (Remonté ici pour être bien visible) --- #}
    {% for message in app.flashes('error') %}
        <div style="background: #fee2e2; color: #991b1b; padding: 15px; margin-bottom: 20px; border-radius: 5px; border: 1px solid #f87171; text-align: center; font-weight: bold;">
            <i class="fas fa-exclamation-triangle"></i> {{ message }}
        </div>
    {% endfor %}

    {# --- BARRE DE FILTRES BT --- #}
    <div class="filter-bar">
        <div class="filter-form">
            <div class="filter-group">
                <i class="fas fa-search"></i>
                <input type="text" id="filterGeneralBT" placeholder="N° BT, REFI ou Client...">
            </div>

            <div class="filter-group">
                <i class="fas fa-calendar-alt"></i>
                <input type="date" id="filterDateBT">
            </div>

            <div class="filter-group">
                <i class="fas fa-layer-group"></i>
                <select id="filterTraitementBT">
                    <option value="">Tous les traitements</option>
                    <option value="cata">Cataphorèse</option>
                    <option value="galva">Galvanisation</option>
                </select>
            </div>

            <div class="filter-group">
                <i class="fas fa-tasks"></i>
                <select id="filterStatusBT">
                    <option value="">Tous les états</option>
                    <option value="urgent">Urgent</option>
                    <option value="normal">Normal</option>
                </select>
            </div>
            
            <a href="#" class="btn-reset" id="resetBTFilters" title="Réinitialiser">
                <i class="fas fa-sync-alt"></i>
            </a>
        </div>
    </div>

    {# --- TABLEAU --- #}
    <div class="table-container">
        <div class="table-grid header bt-grid-template">
            <span>N° BT / Date</span>
            <span>REFI Associé</span>
            <span>Client</span>
            <span>Traitement</span>
            <span>Délai Client</span>
            <span style="text-align: center;">Avancement</span>
            <span style="text-align: center;">Actions</span>
        </div>

        <div id="btTableBody">
            {% for bt in bons_travail %}
                <div class="table-grid row clickable-row bt-grid-template" 
                     data-btnum="{{ bt.numero|lower }}"
                     data-refi="{{ bt.bonCommande.refi|lower }}" 
                     data-client="{{ bt.bonCommande.client.nom|lower }}" 
                     data-date="{{ bt.dateCreation|date('Y-m-d') }}"
                     data-traitement="{{ bt.type|lower }}"
                     data-status="{{ bt.exigenceParticuliere ? 'urgent' : 'normal' }}"
                     onclick="window.location='{{ path('app_bon_travail_new', {'id': bt.bonCommande.id}) }}'">
                    
                    <div class="ref-cell-group">
                        <span class="ref-cell" style="color: #dcb35c;">{{ bt.numero }}</span>
                        <small class="date-subtext">Créé le {{ bt.dateCreation|date('d/m/Y') }}</small>
                    </div>

                    <span class="ref-cell">{{ bt.bonCommande.refi }}</span>

                    <span class="client-cell" style="font-weight: 500;">{{ bt.bonCommande.client.nom }}</span>

                    <span>
                        <span class="badge-info" style="font-weight: 600; font-size: 11px; padding: 4px 8px; background: #f3f4f6; border-radius: 4px; display: inline-block;">
                            {% if bt.type == 'CATA' %}
                                <i class="fas fa-layer-group" style="color: #8b5cf6;"></i> Cataphorèse
                            {% else %}
                                <i class="fas fa-tint" style="color: #3b82f6;"></i> Galvanisation 
                                {% if bt.bonCommande.typeGalva == 'GB' %}
                                    <span style="color: #6b7280; font-weight: normal;">(Grand Bain)</span>
                                {% elseif bt.bonCommande.typeGalva == 'PB' %}
                                    <span style="color: #6b7280; font-weight: normal;">(Petit Bain)</span>
                                {% elseif bt.bonCommande.typeGalva %}
                                    <span style="color: #6b7280; font-weight: normal;">({{ bt.bonCommande.typeGalva }})</span>
                                {% endif %}
                            {% endif %}
                        </span>
                    </span>

                    <span>
                        <span class="badge-info">
                            <i class="far fa-clock"></i> {{ bt.delaiClient ? bt.delaiClient|date('d/m/Y') : 'Non défini' }}
                        </span>
                    </span>

                    {# --- CELLULE : AVANCEMENT --- #}
                    <span class="progress-cell" style="display: flex; flex-direction: column; gap: 5px; align-items: center;">
                        
                        {% if bt.type == 'CATA' %}
                            {% if bt.isCataphoreseTermine %}
                                <span class="status-badge success" title="Terminé en cataphorèse">
                                    <i class="fas fa-check-double"></i> Fait (Cata.)
                                </span>
                            {% else %}
                                <span class="status-badge pending" title="En attente cataphorèse">
                                    <i class="fas fa-hourglass-half"></i> En cours
                                </span>
                            {% endif %}
                        {% else %}
                            {# 1. BADGE PESÉE #}
                            {% if bt.isPeseeValidee %}
                                <span class="status-badge success" title="Pesée terminée"><i class="fas fa-weight"></i> Pesée OK</span>
                            {% else %}
                                <span class="status-badge pending" title="Pesée en attente"><i class="fas fa-weight"></i> Pesée...</span>
                            {% endif %}

                            {# 2. BADGE PLANNING #}
                            {% set isTermineAtelier = false %}
                            {% set isPlanifie = false %}
                            
                            {% if bt.planningLignes is defined and bt.planningLignes|length > 0 %}
                                {% set isPlanifie = true %}
                                {% for lignePlanning in bt.planningLignes %}
                                    {% if lignePlanning.avancement == true %}
                                        {% set isTermineAtelier = true %}
                                    {% endif %}
                                {% endfor %}
                            {% endif %}

                            {% if isTermineAtelier %}
                                <span class="status-badge success" title="Terminé dans l'atelier"><i class="fas fa-check-double"></i> Fait (Atelier)</span>
                            {% elseif isPlanifie %}
                                <span class="status-badge warning" title="Dans le planning, en attente de réalisation"><i class="fas fa-calendar-check"></i> Planifié</span>
                            {% else %}
                                <span class="status-badge pending" title="Non planifié"><i class="fas fa-calendar-alt"></i> À planifier</span>
                            {% endif %}
                        {% endif %}
                        
                        {# 3. BADGE STOCKAGE #}
                        {% set isStocke = true %}
                        {% set totalLignes = bt.lignes|length %}
                        {% if totalLignes == 0 %}
                            {% set isStocke = false %}
                        {% else %}
                            {% for ligne in bt.lignes %}
                                {% if not ligne.emplacementApresProduction %}
                                    {% set isStocke = false %}
                                {% endif %}
                            {% endfor %}
                        {% endif %}

                        {% if isStocke %}
                            <span class="status-badge success" title="Emplacements finaux définis"><i class="fas fa-boxes"></i> Stocké</span>
                        {% endif %}
                    </span>

                    <span class="actions-cell" style="display: flex; justify-content: center; gap: 10px;">
                        <a href="{{ path('app_bon_travail_delete', {'id': bt.id}) }}" 
                        class="btn-action-delete-bt"
                        data-token="{{ csrf_token('delete_bt' ~ bt.id) }}"
                        data-turbo-confirm="Voulez-vous vraiment supprimer ce Bon de Travail ?"
                        onclick="handleDeleteBT(event, this)">
                            <i class="fas fa-trash-alt"></i>
                        </a>
                    </span>
                </div>
            {% else %}
                <div class="no-data">
                    <i class="fas fa-tools" style="font-size: 24px; margin-bottom: 10px; display: block; opacity: 0.5;"></i>
                    <span>Aucun bon de travail généré.</span>
                </div>
            {% endfor %}
        </div>
    </div>
</section>

<script>
function handleDeleteBT(event, element) {
    // 1. On empêche la ligne de se rediriger vers l'édition
    event.preventDefault();
    event.stopPropagation();

    const token = element.getAttribute('data-token');
    const url = element.getAttribute('href');
    // On sécurise la récupération du message (anti-null)
    const confirmMsg = element.getAttribute('data-turbo-confirm') || "Voulez-vous supprimer cet élément ?";

    if (confirm(confirmMsg)) {
        // On crée un formulaire "fantôme" pour envoyer le POST avec le jeton CSRF
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = url;

        const tokenInput = document.createElement('input');
        tokenInput.type = 'hidden';
        tokenInput.name = '_token';
        tokenInput.value = token;

        form.appendChild(tokenInput);
        document.body.appendChild(form);
        form.submit();
    }
}

function setupBTFilters() {
    const inputSearch = document.getElementById('filterGeneralBT');
    const inputDate = document.getElementById('filterDateBT');
    const selectStatus = document.getElementById('filterStatusBT');
    const selectTraitement = document.getElementById('filterTraitementBT');
    const btnReset = document.getElementById('resetBTFilters');
    
    const rows = document.querySelectorAll('#btTableBody .row');

    if (!inputSearch || rows.length === 0) return;

    function filterTable() {
        const valSearch = inputSearch.value.toLowerCase().trim();
        const valDate = inputDate.value;
        const valStatus = selectStatus.value;
        const valTraitement = selectTraitement.value;

        rows.forEach(row => {
            const rowBt = row.dataset.btnum || "";
            const rowRefi = row.dataset.refi || "";
            const rowClient = row.dataset.client || "";
            const rowDate = row.dataset.date || "";
            const rowStatus = row.dataset.status || "";
            const rowTraitement = row.dataset.traitement || "";

            const matchesSearch = rowBt.includes(valSearch) || rowRefi.includes(valSearch) || rowClient.includes(valSearch);
            const matchesDate = valDate === "" || rowDate === valDate;
            const matchesStatus = valStatus === "" || rowStatus === valStatus;
            const matchesTraitement = valTraitement === "" || rowTraitement === valTraitement;

            row.style.display = (matchesSearch && matchesDate && matchesStatus && matchesTraitement) ? 'grid' : 'none';
        });
    }

    [inputSearch, inputDate, selectStatus, selectTraitement].forEach(el => {
        el.addEventListener(el.tagName === 'SELECT' || el.type === 'date' ? 'change' : 'input', filterTable);
    });

    if (btnReset) {
        btnReset.addEventListener('click', (e) => {
            e.preventDefault();
            inputSearch.value = '';
            inputDate.value = '';
            selectStatus.value = '';
            selectTraitement.value = '';
            filterTable();
        });
    }
}

document.addEventListener('turbo:load', () => {
    if (typeof setupOrdoFilters === 'function') setupOrdoFilters();
    setupBTFilters();
});
</script>

<style>
    .btn-action-delete-bt {
        background: none;
        border: none;
        color: #9ca3af;
        cursor: pointer;
        padding: 0;
        transition: 0.2s;
    }

    .btn-action-delete-bt:hover {
        color: #ef4444; 
        transform: scale(1.2);
    }

    .bt-grid-template { 
        grid-template-columns: 160px 130px 1fr 180px 110px 120px 80px !important; 
        align-items: center; 
    }

    .badge-info i { margin-right: 4px; font-size: 10px; }
    
    .btn-edit-simple .fa-file-invoice:hover { transform: scale(1.2); }

    /* Styles pour les petits badges d'avancement */
    .status-badge {
        font-size: 10px;
        font-weight: bold;
        padding: 4px 8px;
        border-radius: 12px;
        text-transform: uppercase;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        width: 105px; 
        justify-content: center;
    }
    
    .status-badge.success {
        background-color: #dcfce7;
        color: #166534;
        border: 1px solid #bbf7d0;
    }
    
    .status-badge.pending {
        background-color: #f3f4f6;
        color: #6b7280;
        border: 1px solid #e5e7eb;
    }

    .status-badge.warning {
        background-color: #fef08a;
        color: #854d0e;
        border: 1px solid #fde047;
    }
</style>