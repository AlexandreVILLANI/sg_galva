<section id="list-bons-travail" class="content-section" style="display: none;">
    <div class="section-header">
        <h2 class="section-title">Bons de Travail</h2>
    </div>

    {# --- BARRE DE FILTRES BT --- #}
    <div class="filter-bar">
        <div class="filter-form">
            <div class="filter-group">
                <i class="fas fa-search"></i>
                <input type="text" id="filterGeneralBT" placeholder="N° BT, REFI ou Client...">
            </div>

            <div class="filter-group">
                <i class="fas fa-calendar-alt"></i>
                <input type="date" id="filterDateBT">
            </div>

            <div class="filter-group">
                <i class="fas fa-tasks"></i>
                <select id="filterStatusBT">
                    <option value="">Tous les états</option>
                    <option value="urgent">Urgent</option>
                    <option value="normal">Normal</option>
                </select>
            </div>
            
            <a href="#" class="btn-reset" id="resetBTFilters" title="Réinitialiser">
                <i class="fas fa-sync-alt"></i>
            </a>
        </div>
    </div>

    {# --- TABLEAU --- #}
    <div class="table-container">
        <div class="table-grid header bt-grid-template">
            <span>N° BT / Date</span>
            <span>REFI Associé</span>
            <span>Client</span>
            <span>Délai Client</span>
            <span style="text-align: center;">Actions</span>
        </div>

        <div id="btTableBody">
            {% for bt in bons_travail %}
                <div class="table-grid row clickable-row bt-grid-template" 
                     data-btnum="{{ bt.numero|lower }}"
                     data-refi="{{ bt.bonCommande.refi|lower }}" 
                     data-client="{{ bt.bonCommande.client.nom|lower }}" 
                     data-date="{{ bt.dateCreation|date('Y-m-d') }}"
                     data-status="{{ bt.exigenceParticuliere ? 'urgent' : 'normal' }}"
                     onclick="window.location='{{ path('app_bon_travail_new', {'id': bt.bonCommande.id}) }}'">
                    
                    <div class="ref-cell-group">
                        <span class="ref-cell" style="color: #dcb35c;">{{ bt.numero }}</span>
                        <small class="date-subtext">Créé le {{ bt.dateCreation|date('d/m/Y') }}</small>
                    </div>

                    <span class="ref-cell">{{ bt.bonCommande.refi }}</span>

                    <span class="client-cell" style="font-weight: 500;">{{ bt.bonCommande.client.nom }}</span>

                    <span>
                        <span class="badge-info">
                            <i class="far fa-clock"></i> {{ bt.delaiClient ? bt.delaiClient|date('d/m/Y') : 'Non défini' }}
                        </span>
                    </span>

                    <span class="actions-cell" style="display: flex; justify-content: center; gap: 10px;">

                        <a href="{{ path('app_bon_travail_delete', {'id': bt.id}) }}" 
                        class="btn-action-delete-bt"
                        data-token="{{ csrf_token('delete_bt' ~ bt.id) }}"
                        onclick="handleDeleteBT(event, this)">
                            <i class="fas fa-trash-alt"></i>
                        </a>
                    </span>
                </div>
            {% else %}
                <div class="no-data">
                    <i class="fas fa-tools" style="font-size: 24px; margin-bottom: 10px; display: block; opacity: 0.5;"></i>
                    <span>Aucun bon de travail généré.</span>
                </div>
            {% endfor %}
        </div>
    </div>
</section>

<script>
function handleDeleteBT(event, element) {
    // 1. On empêche la ligne de se rediriger vers l'édition
    event.preventDefault();
    event.stopPropagation();

    const token = element.getAttribute('data-token');
    const url = element.getAttribute('href');
    const confirmMsg = element.getAttribute('data-turbo-confirm');

    if (confirm(confirmMsg)) {
        // On crée un formulaire "fantôme" pour envoyer le POST avec le jeton CSRF
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = url;

        const tokenInput = document.createElement('input');
        tokenInput.type = 'hidden';
        tokenInput.name = '_token';
        tokenInput.value = token;

        form.appendChild(tokenInput);
        document.body.appendChild(form);
        form.submit();
    }
}
function setupBTFilters() {
    const inputSearch = document.getElementById('filterGeneralBT');
    const inputDate = document.getElementById('filterDateBT');
    const selectStatus = document.getElementById('filterStatusBT');
    const btnReset = document.getElementById('resetBTFilters');
    
    const rows = document.querySelectorAll('#btTableBody .row');

    if (!inputSearch || rows.length === 0) return;

    function filterTable() {
        const valSearch = inputSearch.value.toLowerCase().trim();
        const valDate = inputDate.value;
        const valStatus = selectStatus.value;

        rows.forEach(row => {
            const rowBt = row.dataset.btnum || "";
            const rowRefi = row.dataset.refi || "";
            const rowClient = row.dataset.client || "";
            const rowDate = row.dataset.date || "";
            const rowStatus = row.dataset.status || "";

            const matchesSearch = rowBt.includes(valSearch) || rowRefi.includes(valSearch) || rowClient.includes(valSearch);
            const matchesDate = valDate === "" || rowDate === valDate;
            const matchesStatus = valStatus === "" || rowStatus === valStatus;

            row.style.display = (matchesSearch && matchesDate && matchesStatus) ? 'grid' : 'none';
        });
    }

    [inputSearch, inputDate, selectStatus].forEach(el => {
        el.addEventListener(el.tagName === 'SELECT' || el.type === 'date' ? 'change' : 'input', filterTable);
    });

    if (btnReset) {
        btnReset.addEventListener('click', (e) => {
            e.preventDefault();
            inputSearch.value = '';
            inputDate.value = '';
            selectStatus.value = '';
            filterTable();
        });
    }
}

// À ajouter dans tes écouteurs d'événements existants
document.addEventListener('turbo:load', () => {
    setupOrdoFilters();
    setupBTFilters();
});
</script>

<style>
.btn-action-delete-bt {
        background: none;
        border: none;
        color: #9ca3af; /* Gris par défaut */
        cursor: pointer;
        padding: 0;
        transition: 0.2s;
    }

    .btn-action-delete-bt:hover {
        color: #ef4444; /* Rouge au survol */
        transform: scale(1.2);
    }

    /* Optionnel : ajuster la largeur de la colonne action si besoin */
    .bt-grid-template { 
        grid-template-columns: 160px 140px 1fr 140px 100px !important; 
    }
    /* Template de grille spécifique pour le BT */
    .bt-grid-template { 
        grid-template-columns: 160px 140px 1fr 140px 80px !important; 
    }

    /* Badge spécifique pour les délais */
    .badge-info i { margin-right: 4px; font-size: 10px; }
    
    /* Couleur dorée pour les éléments BT */
    .btn-edit-simple .fa-file-invoice:hover { transform: scale(1.2); }
</style>