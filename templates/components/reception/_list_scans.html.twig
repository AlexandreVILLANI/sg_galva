<section id="list-scans" class="content-section">
    <div class="section-header">
        <h2 class="section-title">Derniers scans de Bons de Commande</h2>
    </div>

    <div class="table-container">
        <div class="table-grid-scans header">
            <span>REFI</span>
            <span>Date création</span>
            <span>Client</span>
            <span >Forfait</span>
            <span style="text-align: center;">Actions</span>
        </div>

        {% for bon in bons %}
            <div class="table-grid-scans row clickable-row" onclick="window.location='{{ path('app_bon_commande_edit', {'id': bon.id}) }}'">
                <span class="ref-cell">{{ bon.refi }}</span>
                <span class="date-cell">{{ bon.date|date('d/m H:i') }}</span>
                <span class="client-cell" style="font-weight: 500;">{{ bon.client.nom }}</span>
                <span class="dest-cell">
                    <span class="badge-forfait">{{ bon.forfait|default('Standard') }}</span>
                </span>
                
                {# --- BOUTON SUPPRIMER --- #}
                <span class="actions-cell" onclick="event.stopPropagation();">
                    <form method="post" action="{{ path('app_bon_commande_delete', {'id': bon.id}) }}" onsubmit="return confirm('Êtes-vous SÛR de vouloir supprimer définitivement le bon {{ bon.refi }} ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ bon.id) }}">
                        {# Nouveau bouton avec texte #}
                        <button class="btn-delete-explicit" title="Supprimer ce bon">
                            <i class="fas fa-trash-alt"></i>
                            <span>Supprimer</span>
                        </button>
                    </form>
                </span>
            </div>
        {% else %}
            <div class="table-grid-scans row no-data">
                <span style="grid-column: span 4; text-align: center; padding: 20px; color: #9ca3af;">
                    Aucun bon de commande scanné pour le moment.
                </span>
            </div>
        {% endfor %}
    </div>
</section>

<style>
    .table-grid-scans {
        display: grid;
        grid-template-columns: 140px 120px 1fr 130px 120px; 
        padding: 12px 20px;
        align-items: center;
        font-size: 13px;
    }

    .actions-cell {
        display: flex;
        justify-content: center;
        align-items: center;
        opacity: 1 !important;
    }

    /* --- NOUVEAU STYLE DE BOUTON --- */
    .btn-delete-explicit {
        background-color: #fee2e2; /* Fond rouge clair */
        color: #dc2626; /* Texte rouge foncé */
        border: 1px solid #fecaca;
        padding: 6px 12px;
        border-radius: 6px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px; /* Espace entre icône et texte */
        font-weight: 600;
        font-size: 12px;
        transition: all 0.2s ease;
    }

    .btn-delete-explicit i {
        font-size: 14px;
    }

    .btn-delete-explicit:hover {
        background-color: #dc2626; /* Devient rouge vif au survol */
        color: white;
        border-color: #dc2626;
        transform: translateY(-1px);
        box-shadow: 0 2px 4px rgba(220, 38, 38, 0.3);
    }

    /* --- Le reste de tes styles --- */
    .table-grid-scans.header {
        background: #f9fafb;
        color: #6b7280;
        font-weight: 600;
        border-bottom: 1px solid #f3f4f6;
        text-transform: uppercase;
        font-size: 11px;
    }

    .table-grid-scans.row {
        border-bottom: 1px solid #f9fafb;
        color: #374151;
        transition: background 0.2s;
        cursor: pointer;
    }

    .table-grid-scans.row:hover {
        background-color: #f8fafc;
    }

    .ref-cell { 
        font-family: 'Monaco', 'Consolas', monospace; 
        font-weight: 600; 
        color: #2e46a6; 
        background: #f0f4ff;
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 12px;
        width: fit-content;
    }

    .badge-forfait {
        background: #f3f4f6;
        color: #4b5563;
        padding: 2px 8px;
        border-radius: 12px;
        font-size: 11px;
        border: 1px solid #e5e7eb;
    }
</style>