<section id="list-scans" class="content-section">
    <div class="section-header">
        <h2 class="section-title">Derniers Bons de Commande</h2>
    </div>

    <div class="filter-bar">
        <div class="filter-form">
            {# Filtre REFI #}
            <div class="filter-group">
                <i class="fas fa-search"></i>
                <input type="text" id="filterRefi" placeholder="REFI...">
            </div>

            {# Filtre Client #}
            <div class="filter-group">
                <i class="fas fa-user"></i>
                <input type="text" id="filterClient" placeholder="Client...">
            </div>

            {# Filtre Forfait (Mis en cohérence) #}
            <div class="filter-group">
                <i class="fas fa-tags"></i>
                <select id="filterForfait">
                    <option value="">Tous les forfaits</option>
                    {% for forfaitNom in uniqueForfaits|default([]) %}
                        <option value="{{ forfaitNom|lower|trim }}">{{ forfaitNom }}</option>
                    {% endfor %}
                </select>
            </div>
            
            <a href="#" class="btn-reset" id="clearScansFilters" title="Réinitialiser">
                <i class="fas fa-eraser"></i>
            </a>
        </div>
    </div>

    <div class="table-container">
        <div class="table-grid header">
            <span>REFI</span>
            <span>Date création</span>
            <span>Client</span>
            <span>Forfait</span>
            <span style="text-align: center;">Actions</span>
        </div>

        <div id="scansTableBody">
            {% for bon in bons %}
                <div class="table-grid row clickable-row" 
                     data-refi="{{ bon.refi|trim|lower }}" 
                     data-client="{{ bon.client.nom|trim|lower }}" 
                     data-forfait="{{ bon.forfait|default('Standard')|trim|lower }}"
                     onclick="window.location='{{ path('app_bon_commande_edit', {'id': bon.id}) }}'">
                    
                    <span class="ref-cell">{{ bon.refi }}</span>
                    <span class="date-cell">{{ bon.date|date('d/m H:i') }}</span>
                    <span class="client-cell" style="font-weight: 500;">{{ bon.client.nom }}</span>
                    <span>
                        <span class="badge-success">{{ bon.forfait|default('Standard') }}</span>
                    </span>
                    
                    <span style="display: flex; justify-content: center;" onclick="event.stopPropagation();">
                        <form method="post" action="{{ path('app_bon_commande_delete', {'id': bon.id}) }}" onsubmit="return confirm('Supprimer le bon {{ bon.refi }} ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ bon.id) }}">
                            <button type="submit" class="btn-delete-simple">
                                <i class="fas fa-trash-alt"></i>
                            </button>
                        </form>
                    </span>
                </div>
            {% endfor %}
        </div>
    </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const inputRefi = document.getElementById('filterRefi');
    const inputClient = document.getElementById('filterClient');
    const selectForfait = document.getElementById('filterForfait');
    const btnReset = document.getElementById('clearScansFilters');
    const rows = document.querySelectorAll('#scansTableBody .row');

    function filterTable() {
        const valRefi = inputRefi.value.toLowerCase().trim();
        const valClient = inputClient.value.toLowerCase().trim();
        const valForfait = selectForfait.value.toLowerCase().trim();

        rows.forEach(row => {
            const rowRefi = row.dataset.refi;
            const rowClient = row.dataset.client;
            const rowForfait = row.dataset.forfait;

            const matchesRefi = rowRefi.includes(valRefi);
            const matchesClient = rowClient.includes(valClient);
            // Comparaison exacte pour le forfait, sauf si "Tous" est sélectionné
            const matchesForfait = valForfait === "" || rowForfait === valForfait;

            if (matchesRefi && matchesClient && matchesForfait) {
                row.style.display = 'grid';
            } else {
                row.style.display = 'none';
            }
        });
    }

    inputRefi.addEventListener('input', filterTable);
    inputClient.addEventListener('input', filterTable);
    selectForfait.addEventListener('change', filterTable);

    btnReset.addEventListener('click', (e) => {
        e.preventDefault();
        inputRefi.value = '';
        inputClient.value = '';
        selectForfait.value = '';
        filterTable();
    });
});
</script>

